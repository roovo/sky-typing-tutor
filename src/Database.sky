module Database exposing (db)

import Sky.Core.Prelude exposing (..)
import Sky.Core.File as File
import Sky.Core.Task as Task
import Sky.Core.Error as Error exposing (Error)
import Std.Db as Db
import Std.Log exposing (println)


db =
    let
        homeDir = System.getenvOr "HOME" "."
        dir = homeDir ++ "/.typing-tutor"
        path = dir ++ "/typing.db"
        _ = Task.run (File.mkdirAll dir)
    in
        case Task.run (Db.open "sqlite" path) of

            Ok conn ->
                let
                    _ = initSchema conn
                in
                    conn

            Err e ->
                let
                    _ =
                        println ("Database unavailable: " ++ Error.toString e)
                in
                    System.exit 1


initSchema conn =
    Db.execRaw
        conn
        """CREATE TABLE IF NOT EXISTS exercises (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            language TEXT NOT NULL,
            text TEXT NOT NULL,
            character_count INTEGER NOT NULL,
            completed_at TEXT NOT NULL,
            UNIQUE (name, language)
        )"""
        |> Task.andThen
               (\_ ->
                   Db.execRaw
                       conn
                       """CREATE TABLE IF NOT EXISTS attempts (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    exercise_id INTEGER NOT NULL,
                    accuracy REAL NOT NULL,
                    wpm REAL NOT NULL,
                    events TEXT NOT NULL,
                    completed_at TEXT NOT NULL,
                    FOREIGN KEY (exercise_id) REFERENCES exercises(id)
                )""")
