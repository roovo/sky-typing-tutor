module Float.Extra exposing (toString)


toString : Int -> Float -> String
toString decimalPlaces float =
    let
        toFloat : Int -> Float
        toFloat n =
            String.fromInt n |> String.toFloat |> Maybe.withDefault 0.0
        factor = Math.pow 10.0 (toFloat decimalPlaces)
        rounded = Math.round (float * factor)
        whole = rounded // Math.round factor
        frac = Math.abs (rounded - whole * Math.round factor)
        fracStr = String.padLeft decimalPlaces '0' (String.fromInt frac)
    in
        String.fromInt whole ++ "." ++ fracStr
