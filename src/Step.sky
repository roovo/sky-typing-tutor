module Step exposing
    ( Step(..)
    , init
    , initEnd
    , initEnterChar
    , initEmptyLine
    , initSkip
    , isEnd
    , isEnter
    , isSkipable
    , isTypeable
    , matchesTyped
    )

--
-- TYPE
--
type Step
    = End
    | EnterChar
    | EmptyLine
    | Skip String
    | Typeable Char


--
-- CONSTRUCTION
--
init : Char -> Step
init char =
    Typeable char


initEnd : Step
initEnd =
    End


initEnterChar : Step
initEnterChar =
    EnterChar


initEmptyLine : Step
initEmptyLine =
    EmptyLine


initSkip : String -> Step
initSkip string =
    Skip string


--
-- PREDICATES
--
isEnd : Step -> Bool
isEnd step =
    case step of

        End ->
            True

        _ ->
            False


isEnter : Step -> Bool
isEnter step =
    case step of

        EnterChar ->
            True

        _ ->
            False


isSkipable : Step -> Bool
isSkipable step =
    case step of

        EmptyLine ->
            True

        Skip _ ->
            True

        _ ->
            False


isTypeable : Step -> Bool
isTypeable step =
    case step of

        EnterChar ->
            True

        Typeable _ ->
            True

        _ ->
            False


matchesTyped : Char -> Step -> Bool
matchesTyped ch step =
    case step of

        EnterChar ->
            ch == (Char.fromCode 13)

        Typeable actual ->
            actual == ch

        _ ->
            False
