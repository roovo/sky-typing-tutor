module Step exposing (Step, init, initEnd, initEnterChar, initSkip, isTypeable)

--
-- TYPE
--
type Step
    = End
    | EnterChar
    | Skip String
    | Typeable Char


--
-- CONSTRUCTION
--
init : Char -> Step
init char =
    Typeable char


initEnd : Step
initEnd =
    End


initEnterChar : Step
initEnterChar =
    EnterChar


initSkip : String -> Step
initSkip string =
    Skip string


--
-- PREDICATES
--
isTypeable : Step -> Bool
isTypeable step =
    case step of

        EnterChar ->
            True

        Typeable _ ->
            True

        _ ->
            False
