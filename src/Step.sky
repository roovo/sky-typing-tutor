module Step exposing
    ( Step(..)
    , init
    , initEnd
    , initEnterChar
    , initEmptyLine
    , initSkip
    , isSkipable
    , isTypeable
    )

--
-- TYPE
--
type Step
    = End
    | EnterChar
    | EmptyLine
    | Skip String
    | Typeable Char


--
-- CONSTRUCTION
--
init : Char -> Step
init char =
    Typeable char


initEnd : Step
initEnd =
    End


initEnterChar : Step
initEnterChar =
    EnterChar


initEmptyLine : Step
initEmptyLine =
    EmptyLine


initSkip : String -> Step
initSkip string =
    Skip string


--
-- PREDICATES
--
isSkipable : Step -> Bool
isSkipable step =
    case step of

        EmptyLine ->
            True

        Skip _ ->
            True

        _ ->
            False


isTypeable : Step -> Bool
isTypeable step =
    case step of

        EnterChar ->
            True

        Typeable _ ->
            True

        _ ->
            False
