module Main exposing (main)

import Page.Exercise as PageExercise
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( AppModel, Cmd Msg )
init _ =
    let
        userArgs = System.args () |> Task.run |> Result.withDefault []
    in
        case getArg userArgs of

            "" ->
                ( NoFile, Cmd.none )

            filename ->
                case Task.run (File.readFile filename) of

                    Ok contents ->
                        ( Exercise (PageExercise.init filename contents)
                        , Cmd.none
                        )

                    Err _ ->
                        ( NoFile, Cmd.none )


getArg argList =
    Maybe.withDefault "" (List.head argList)

--
-- MODEL
--
type AppModel
    = Exercise Page.Exercise.Model
    | NoFile

--
-- UPDATE
--
type Msg
    = GotExerciseMsg PageExercise.Msg
    | Quit
    | NoOp


update : Msg -> AppModel -> ( AppModel, Cmd Msg )
update msg model =
    case msg of

        GotExerciseMsg _ ->
            ( model, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )

--
-- ONKEY
--
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else
        NoOp


--
-- SUBSCRIPTIONS
--
subscriptions : AppModel -> Sub Msg
subscriptions model =
    Sub.none


--
-- VIEW
--
view : AppModel -> Element Msg
view model =
    case model of

        Exercise subModel ->
            PageExercise.view GotExerciseMsg subModel

        NoFile ->
            notFoundView


notFoundView : Element Msg
notFoundView =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "File Not Found") ]
