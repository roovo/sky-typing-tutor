module Main exposing (main)

import Database
import KeyEvent exposing (KeyEvent)
import Page.Exercise as PageExercise
import Page.Exercises as PageExercises
import Session
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( Model, Cmd Msg )
init _ =
    let
        _ = Database.db
        ( subModel, cmd ) = PageExercises.init GotExercisesMsg Session.init
    in
        ( Exercises subModel, cmd )


getArg argList =
    Maybe.withDefault "" (List.head argList)


resolveFullPath : String -> String
resolveFullPath path =
    Task.run (Process.run "realpath" [ path ]) |> Result.withDefault path
        |> String.trim

--
-- MODEL
--
type Model
    = Exercise PageExercise.Model
    | Exercises PageExercises.Model

--
-- UPDATE
--
type Msg
    = GotExerciseMsg PageExercise.Msg
    | GotExercisesMsg PageExercises.Msg
    | KeyPressed KeyEvent
    | Quit
    | NoOp


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case ( msg, model ) of

        ( GotExerciseMsg subMsg, Exercise subModel ) ->
            case subMsg of

                PageExercise.ShowExercises ->
                    let
                        ( exercisesModel, cmd ) =
                            PageExercises.init GotExercisesMsg subModel.session
                    in
                        ( Exercises exercisesModel, cmd )

                _ ->
                    let
                        ( newSubModel, cmd ) =
                            PageExercise.update GotExerciseMsg subMsg subModel
                    in
                        ( Exercise newSubModel, cmd )

        ( GotExerciseMsg _, _ ) ->
            ( model, Cmd.none )

        ( GotExercisesMsg subMsg, Exercises exercisesModel ) ->
            case subMsg of

                PageExercises.StartExercise path content ->
                    ( Exercise
                          (PageExercise.init exercisesModel.session path content)
                    , Cmd.none
                    )

                _ ->
                    let
                        ( newSubModel, cmd ) =
                            PageExercises.update
                                GotExercisesMsg
                                subMsg
                                exercisesModel
                    in
                        ( Exercises newSubModel, cmd )

        ( GotExercisesMsg _, _ ) ->
            ( model, Cmd.none )

        ( KeyPressed keyEvent, _ ) ->
            handleKeyPressed keyEvent model

        ( Quit, _ ) ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        ( NoOp, _ ) ->
            ( model, Cmd.none )


handleKeyPressed : KeyEvent -> Model -> ( Model, Cmd Msg )
handleKeyPressed keyEvent model =
    case model of

        Exercise exerciseModel ->
            let
                ( newSubModel, cmd ) =
                    PageExercise.update
                        GotExerciseMsg
                        (PageExercise.KeyTyped keyEvent)
                        exerciseModel
            in
                ( Exercise newSubModel, cmd )

        Exercises exercisesModel ->
            let
                ( newSubModel, cmd ) =
                    PageExercises.update
                        GotExercisesMsg
                        (PageExercises.KeyTyped keyEvent)
                        exercisesModel
            in
                ( Exercises newSubModel, cmd )

        _ ->
            ( model, Cmd.none )


--
-- ONKEY
--
onKey keyEvent =
    if keyEvent.kind == "ctrl" && keyEvent.value == "c" then
        Quit

    else
        KeyPressed keyEvent


--
-- SUBSCRIPTIONS
--
subscriptions : Model -> Sub Msg
subscriptions model =
    case model of

        Exercise _ ->
            Sub.every 10 (GotExerciseMsg PageExercise.Tick)

        _ ->
            Sub.none


--
-- VIEW
--
view : Model -> Element Msg
view model =
    case model of

        Exercise exerciseModel ->
            PageExercise.view GotExerciseMsg exerciseModel

        Exercises exercisesModel ->
            PageExercises.view GotExercisesMsg exercisesModel
