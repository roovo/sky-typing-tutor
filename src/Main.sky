module Main exposing (main)

import Database
import Page.Exercise as PageExercise exposing (Msg(..))
import Session
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( AppModel, Cmd Msg )
init _ =
    let
        __ = Database.db
        userArgs = System.args () |> Task.run |> Result.withDefault []
    in
        case getArg userArgs of

            "" ->
                ( NoFile Session.init, Cmd.none )

            filename ->
                let
                    fullPath = resolveFullPath filename
                in
                    case Task.run (File.readFile fullPath) of

                        Ok contents ->
                            ( Exercise
                                  (PageExercise.init
                                      Session.init
                                      fullPath
                                      contents)
                            , Cmd.none
                            )

                        Err _ ->
                            ( NoFile Session.init, Cmd.none )


getArg argList =
    Maybe.withDefault "" (List.head argList)


resolveFullPath : String -> String
resolveFullPath path =
    Task.run (Process.run "realpath" [ path ]) |> Result.withDefault path
        |> String.trim

--
-- MODEL
--
type AppModel
    = Exercise PageExercise.Model
    | NoFile Session

--
-- UPDATE
--
type Msg
    = GotExerciseMsg PageExercise.Msg
    | Quit
    | NoOp


update : Msg -> AppModel -> ( AppModel, Cmd Msg )
update msg model =
    case ( msg, model ) of

        ( GotExerciseMsg subMsg, Exercise subModel ) ->
            let
                ( newSubModel, cmd ) =
                    PageExercise.update GotExerciseMsg subMsg subModel
            in
            ( Exercise newSubModel, cmd )

        ( GotExerciseMsg _, _ ) ->
            ( model, Cmd.none )

        ( Quit, _ ) ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        ( NoOp, _ ) ->
            ( model, Cmd.none )


--
-- ONKEY
--
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "escape" then
        Quit

    else if keyEvent.kind == "ctrl" && keyEvent.value == "c" then
        Quit

    else
        GotExerciseMsg (PageExercise.KeyTyped keyEvent)


--
-- SUBSCRIPTIONS
--
subscriptions : AppModel -> Sub Msg
subscriptions model =
    case model of

        Exercise _ ->
            Sub.every 10 (GotExerciseMsg PageExercise.Tick)

        NoFile _ ->
            Sub.none


--
-- VIEW
--
view : AppModel -> Element Msg
view model =
    case model of

        Exercise subModel ->
            PageExercise.view GotExerciseMsg subModel

        NoFile _ ->
            notFoundView


notFoundView : Element Msg
notFoundView =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "File Not Found") ]
