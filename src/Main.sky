module Main exposing (main)

import Database
import Page.Exercise as PageExercise
import Page.Exercises as PageExercises
import Session
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( AppModel, Cmd Msg )
init _ =
    let
        _ = Database.db
        ( subModel, cmd ) = PageExercises.init GotExercisesMsg Session.init
    in
        ( Exercises subModel, cmd )


getArg argList =
    Maybe.withDefault "" (List.head argList)


resolveFullPath : String -> String
resolveFullPath path =
    Task.run (Process.run "realpath" [ path ]) |> Result.withDefault path
        |> String.trim

--
-- MODEL
--
type AppModel
    = Exercise PageExercise.Model
    | Exercises PageExercises.ExercisesModel

--
-- UPDATE
--
-- COMPILER BUG WORKAROUND: Using `KeyPressed String String` instead of
-- `KeyPressed KeyEvent` because cross-module type aliases in ADT
-- constructors cause "type mismatch: KeyEvent vs KeyEvent". (Issue 6)
type Msg
    = GotExerciseMsg PageExercise.Msg
    | GotExercisesMsg PageExercises.Msg
    | KeyPressed String String
    | Quit
    | NoOp


update msg model =
    case ( msg, model ) of

        ( GotExerciseMsg subMsg, Exercise subModel ) ->
            let
                ( newSubModel, cmd ) =
                    PageExercise.update GotExerciseMsg subMsg subModel
            in
                ( Exercise newSubModel, cmd )

        ( GotExerciseMsg _, _ ) ->
            ( model, Cmd.none )

        ( GotExercisesMsg subMsg, Exercises exercisesModel ) ->
            handleExercisesMsg subMsg exercisesModel

        ( GotExercisesMsg _, _ ) ->
            ( model, Cmd.none )

        ( KeyPressed kind value, _ ) ->
            handleKeyPressed kind value model

        ( Quit, _ ) ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        ( NoOp, _ ) ->
            ( model, Cmd.none )


-- COMPILER BUG WORKAROUND: Using fst/snd instead of tuple destructuring
-- because destructuring erases the cross-module type. (Issue 3 / Issue 6)
handleExercisesMsg subMsg exercisesModel =
    let
        result = PageExercises.update GotExercisesMsg subMsg exercisesModel
    in
    ( Exercises (fst result), snd result )


-- COMPILER BUG WORKAROUND: Reconstructing KeyEvent from raw strings because
-- passing a KeyEvent extracted from Main's Msg ADT to a Page module function
-- causes "type mismatch: KeyEvent vs KeyEvent". (Issue 6)
handleKeyPressed kind value model =
    let
        keyEvent = { kind = kind, value = value }
    in
    case model of

        Exercise exerciseModel ->
            let
                ( newSubModel, cmd ) =
                    PageExercise.update GotExerciseMsg (PageExercise.KeyTyped keyEvent) exerciseModel
            in
            ( Exercise newSubModel, cmd )

        _ ->
            ( model, Cmd.none )


--
-- ONKEY
--
onKey keyEvent =
    if keyEvent.kind == "escape" then
        Quit

    else if keyEvent.kind == "ctrl" && keyEvent.value == "c" then
        Quit

    else
        KeyPressed keyEvent.kind keyEvent.value


--
-- SUBSCRIPTIONS
--
subscriptions : AppModel -> Sub Msg
subscriptions model =
    case model of

        Exercise _ ->
            Sub.every 10 (GotExerciseMsg PageExercise.Tick)

        _ ->
            Sub.none


--
-- VIEW
--
-- COMPILER BUG WORKAROUND: No annotation on view because cross-module
-- Model types in ADT pattern matches can't be reconciled by HM inference.
view model =
    case model of

        Exercise exerciseModel ->
            PageExercise.view GotExerciseMsg exerciseModel

        Exercises exercisesModel ->
            PageExercises.view GotExercisesMsg (exercisesStatus exercisesModel)


-- COMPLIER BUG MEANS THAT THIS IS NEEDED
exercisesStatus : PageExercises.ExercisesModel -> PageExercises.Status
exercisesStatus m =
    m.exercises
