module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( Model, Cmd Msg )
init _ =
    let
        userArgs = System.args () |> Task.run |> Result.withDefault []
    in
        case getArg userArgs of

            "" ->
                ( NoFile, Cmd.none )

            filename ->
                case Task.run (File.readFile filename) of

                    Ok contents ->
                        ( ExerciseText contents, Cmd.none )

                    Err _ ->
                        ( NoFile, Cmd.none )


getArg argList =
    Maybe.withDefault "" (List.head argList)

--
-- MODEL
--
type Model
    = ExerciseText String
    | NoFile

--
-- UPDATE
--
type Msg
    = Quit
    | NoOp


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )

--
-- ONKEY
--
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else
        NoOp


--
-- SUBSCRIPTIONS
--
subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.none


--
-- VIEW
--
view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ heading ]


heading : Element Msg
heading =
    Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "Typing Tutor")
