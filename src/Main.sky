module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Tui as Tui
import Std.Cmd as Cmd
import Std.Sub as Sub


main =
    Tui.program
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( Model, Cmd Msg )
init _ =
    let
        userArgs = System.args () |> Task.run |> Result.withDefault []
    in
        case getArg userArgs of

            "" ->
                ( NoFile, Cmd.none )

            filename ->
                case Task.run (File.readFile filename) of

                    Ok contents ->
                        ( ExerciseText contents, Cmd.none )

                    Err _ ->
                        ( NoFile, Cmd.none )


getArg argList =
    Maybe.withDefault "" (List.head argList)

--
-- MODEL
--
type Model
    = ExerciseText String
    | NoFile

--
-- UPDATE
--
type Msg
    = Quit
    | NoOp


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )

--
-- ONKEY
--
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else
        NoOp


--
-- SUBSCRIPTIONS
--
subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.none


--
-- VIEW
--
view : Model -> String
view model =
    let
        exerciseContents =
            case model of

                NoFile ->
                    ""

                ExerciseText contents ->
                    contents
    in
        "\r\n" ++ "  ╭──────────────────────────────────╮\r\n"
            ++ "  │       Sky TUI Typing Tutor       │\r\n"
            ++ "  ╰──────────────────────────────────╯\r\n"
            ++ "\r\n"
            ++ exerciseContents
            ++ "\r\n"
