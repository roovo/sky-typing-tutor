module Main exposing (main)

import Database
import Page.Exercise as PageExercise
import Page.Exercises as PageExercises
import Session
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.File as File
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Font as Font


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }


init : () -> ( AppModel, Cmd Msg )
init _ =
    let
        _ = Database.db
        ( subModel, cmd ) = PageExercises.init GotExercisesMsg Session.init
    in
        ( Exercises subModel, Cmd.none )


getArg argList =
    Maybe.withDefault "" (List.head argList)


resolveFullPath : String -> String
resolveFullPath path =
    Task.run (Process.run "realpath" [ path ]) |> Result.withDefault path
        |> String.trim

--
-- MODEL
--
type AppModel
    = Exercise PageExercise.Model
    | Exercises PageExercises.Model

--
-- UPDATE
--
type Msg
    = GotExerciseMsg PageExercise.Msg
    | GotExercisesMsg PageExercises.Msg
    | Quit
    | NoOp


update : Msg -> AppModel -> ( AppModel, Cmd Msg )
update msg model =
    case ( msg, model ) of

        ( GotExerciseMsg subMsg, Exercise subModel ) ->
            let
                ( newSubModel, cmd ) =
                    PageExercise.update GotExerciseMsg subMsg subModel
            in
                ( Exercise newSubModel, cmd )

        ( GotExerciseMsg _, _ ) ->
            ( model, Cmd.none )

        ( GotExercisesMsg subMsg, Exercise subModel ) ->
            ( model, Cmd.none )

        ( GotExercisesMsg _, _ ) ->
            ( model, Cmd.none )

        ( Quit, _ ) ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        ( NoOp, _ ) ->
            ( model, Cmd.none )

--
-- ONKEY
--
type alias KeyEvent =
    { kind : String
    , value : String
    }


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "escape" then
        Quit

    else if keyEvent.kind == "ctrl" && keyEvent.value == "c" then
        Quit

    else
        GotExerciseMsg (PageExercise.KeyTyped keyEvent)


--
-- SUBSCRIPTIONS
--
subscriptions : AppModel -> Sub Msg
subscriptions model =
    case model of

        Exercise _ ->
            Sub.every 10 (GotExerciseMsg PageExercise.Tick)

        _ ->
            Sub.none


--
-- VIEW
--
view model =
    case model of

        Exercise exerciseModel ->
            viewExercise exerciseModel

        Exercises exercisesModel ->
            viewExercises exercisesModel


viewExercise exerciseModel =
    PageExercise.view GotExerciseMsg exerciseModel


viewExercises exercisesModel =
    PageExercises.view GotExercisesMsg exercisesModel
