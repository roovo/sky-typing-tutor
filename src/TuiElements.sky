module TuiElements exposing (WindowNumbers, windowedZipper)

type alias WindowNumbers =
    { beforeCurrentLineCount : Int
    , afterCurrentLineCount : Int
    , blankLineCount : Int
    }


windowedZipper : Int -> Int -> Int -> WindowNumbers
windowedZipper windowLineCount contentCurrentLineIndex contentLineCount =
    let
        windowMaxBeforeRowCount = windowLineCount // 3
        windowCurrentLineIndex =
            (Math.min contentCurrentLineIndex windowMaxBeforeRowCount)
        contentAfterLineCount =
            contentLineCount - contentCurrentLineIndex - 1
        windowAfterLineCount = windowLineCount - windowCurrentLineIndex
        afterCurrentLineCount =
            Math.min contentAfterLineCount windowAfterLineCount
    in
        { beforeCurrentLineCount = windowCurrentLineIndex
        , afterCurrentLineCount = afterCurrentLineCount
        , blankLineCount = windowAfterLineCount - contentAfterLineCount - 1
        }
