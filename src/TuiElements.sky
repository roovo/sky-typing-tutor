module TuiElements exposing (WindowNumbers, windowedZipper)

type alias WindowNumbers =
    { beforeCurrentLineCount : Int
    , afterCurrentLineCount : Int
    , blankLineCount : Int
    }


windowedZipper : Int -> Int -> Int -> WindowNumbers
windowedZipper windowLineCount currentLineIndex contentLineCount =
    { beforeCurrentLineCount = 0
    , afterCurrentLineCount = contentLineCount - 1
    , blankLineCount = windowLineCount - contentLineCount
    }
