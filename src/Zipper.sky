module Zipper exposing
    ( Zipper
    , after
    , before
    , current
    , first
    , fromList
    , next
    , previous
    , singleton
    , toList
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List

--
-- TYPE
--
-- COMPILER BUG WORKAROUND: Using type alias instead of parametric ADT
-- (type Zipper a = Zipper (List a) a (List a)) because cross-module
-- parametric ADTs emit unbound type parameters in generated Go. (Issue 1)
type alias Zipper a =
    { ls : List a
    , focus : a
    , rs : List a
    }


--
-- CONSTRUCTION
--
singleton : a -> Zipper a
singleton x =
    { ls = [], focus = x, rs = [] }


fromList : List a -> Maybe (Zipper a)
fromList xs =
    case xs of

        [] ->
            Nothing

        y :: ys ->
            Just { ls = [], focus = y, rs = ys }


--
-- MOVEMENT
--
first : Zipper a -> Zipper a
first zipper =
    case List.reverse zipper.ls of

        [] ->
            zipper

        y :: ys ->
            { ls = [], focus = y, rs = ys ++ [ zipper.focus ] ++ zipper.rs }


next : Zipper a -> Zipper a
next zipper =
    case zipper.rs of

        [] ->
            zipper

        y :: ys ->
            { ls = zipper.focus :: zipper.ls, focus = y, rs = ys }


previous : Zipper a -> Zipper a
previous zipper =
    case zipper.ls of

        [] ->
            zipper

        y :: ys ->
            { ls = ys, focus = y, rs = zipper.focus :: zipper.rs }


--
-- INFO
--
after : Zipper a -> List a
after zipper =
    zipper.rs


before : Zipper a -> List a
before zipper =
    List.reverse zipper.ls


current : Zipper a -> a
current zipper =
    zipper.focus


---
-- CONVERSION
--
toList : Zipper a -> List a
toList z =
    before z ++ [ current z ] ++ after z
