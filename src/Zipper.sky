module Zipper exposing
    ( Zipper
    , after
    , before
    , current
    , first
    , fromList
    , last
    , next
    , previous
    , singleton
    , toList
    )

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List

--
-- TYPE
--
type Zipper a
    = Zipper (List a) a (List a)


--
-- CONSTRUCTION
--
singleton : a -> Zipper a
singleton x =
    Zipper [] x []


fromList : List a -> Maybe (Zipper a)
fromList xs =
    case xs of

        [] ->
            Nothing

        y :: ys ->
            Just (Zipper [] y ys)


--
-- MOVEMENT
--
first : Zipper a -> Zipper a
first ((Zipper ls x rs) as zipper) =
    case List.reverse ls of

        [] ->
            zipper

        y :: ys ->
            Zipper [] y (ys ++ [ x ] ++ rs)


last : Zipper a -> Zipper a
last ((Zipper ls x rs) as zipper) =
    case List.reverse rs of

        [] ->
            zipper

        y :: ys ->
            Zipper (ys ++ [ x ] ++ ls) y []


next : Zipper a -> Zipper a
next ((Zipper ls x rs) as zipper) =
    case rs of

        [] ->
            zipper

        y :: ys ->
            Zipper (x :: ls) y ys


previous : Zipper a -> Zipper a
previous ((Zipper ls x rs) as zipper) =
    case ls of

        [] ->
            zipper

        y :: ys ->
            Zipper ys y (x :: rs)


--
-- INFO
--
after : Zipper a -> List a
after (Zipper _ _ rs) =
    rs


before : Zipper a -> List a
before (Zipper ls _ _) =
    List.reverse ls


current : Zipper a -> a
current (Zipper _ x _) =
    x


---
-- CONVERSION
--
toList : Zipper a -> List a
toList z =
    before z ++ [ current z ] ++ after z
