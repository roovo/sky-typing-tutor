module Session exposing (Session, init, terminalLineHeight, wpmTarget)


--
-- CONSTANTS
--
defaultWpmTarget : Int
defaultWpmTarget =
    40


initialineHeight : Int
initialineHeight =
    36

--
-- MODEL
--
type Session
    = Session Config

type alias Config =
    { terminalLineHeight : Int
    , wpmTarget : Int
    }


init : Session
init =
    Session
        { terminalLineHeight = initialineHeight, wpmTarget = defaultWpmTarget }


--
-- INFO
--
terminalLineHeight : Session -> Int
terminalLineHeight =
    .terminalLineHeight << config


wpmTarget : Session -> Int
wpmTarget =
    .wpmTarget << config


--
-- PRIVATE
--
config : Session -> Config
config Session c =
    c
