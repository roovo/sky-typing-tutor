module Session exposing (Session, init, terminalLineHeight, wpmCode, wpmProse)


--
-- CONSTANTS
--
defaultWpmCode : Int
defaultWpmCode =
    40


defaultWpmProse : Int
defaultWpmProse =
    60


initialineHeight : Int
initialineHeight =
    36

--
-- MODEL
--
type Session
    = Session Config

type alias Config =
    { terminalLineHeight : Int
    , wpmCode : Int
    , wpmProse : Int
    }


init : Session
init =
    Session
        { terminalLineHeight = initialineHeight
        , wpmCode = defaultWpmCode
        , wpmProse = defaultWpmProse
        }


--
-- INFO
--
terminalLineHeight : Session -> Int
terminalLineHeight session =
    session |> config |> .terminalLineHeight


wpmCode : Session -> Int
wpmCode session =
    session |> config |> .wpmCode


wpmProse : Session -> Int
wpmProse session =
    session |> config |> .wpmProse


--
-- PRIVATE
--
config : Session -> Config
config Session c =
    c
