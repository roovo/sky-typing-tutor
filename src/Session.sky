module Session exposing (Session, init, terminalLineHeight, wpmTarget)


--
-- CONSTANTS
--
defaultWpmTarget : Int
defaultWpmTarget =
    40


initialineHeight : Int
initialineHeight =
    36

--
-- MODEL
--
type Session
    = Session Config

type alias Config =
    { terminalLineHeight : Int
    , wpmTarget : Int
    }


init : Session
init =
    Session
        { terminalLineHeight = initialineHeight, wpmTarget = defaultWpmTarget }


--
-- INFO
--
-- COMPILER BUG WORKAROUND (Issue 1): Using let-binding + direct field access
-- instead of `.field` accessor in pipeline (e.g. `session |> config |> .terminalLineHeight`)
-- because the accessor generates untyped `rt.Field` without a type assertion.
terminalLineHeight : Session -> Int
terminalLineHeight session =
    let
        c = config session
    in
        c.terminalLineHeight


wpmTarget : Session -> Int
wpmTarget session =
    let
        c = config session
    in
        c.wpmTarget


--
-- PRIVATE
--
config : Session -> Config
config Session c =
    c
