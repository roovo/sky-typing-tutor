module ExerciseParser exposing (toSteps)

import Step exposing (Step(..))
import List.Extra as LE


toSteps : String -> List Step
toSteps string =
    string |> String.trimEnd |> String.lines |> List.map parseLine
        |> List.concat
        |> LE.dropWhileRight
               (\s -> s == Typeable enterChar || s == Skip enterString)
        |> (\steps -> steps ++ [ Step.initEnd ])


parseLine : String -> List Step
parseLine string =
    let
        leadingSpaces =
            string |> String.toList |> LE.takeWhile (\c -> c == ' ')
        rest = string |> String.trim |> String.toList
    in
        case ( leadingSpaces, rest ) of

            ( _, [] ) ->
                [ Skip enterString ]

            ( [], typeables ) ->
                (List.map Typeable typeables) ++ [ Typeable enterChar ]

            ( spaces, typeables ) ->
                [ Skip (String.fromList spaces) ] ++ List.map Typeable rest
                    ++ [ Typeable enterChar ]


--
-- PRIVATE
--
enterChar : Char
enterChar =
    Char.fromCode 13


enterString : String
enterString =
    "<enter>"
