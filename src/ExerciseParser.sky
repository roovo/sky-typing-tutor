module ExerciseParser exposing (toSteps)

import Step exposing (Step(..))
import List.Extra as LE


-- COMPILER BUG WORKAROUND (Issue 3): Uses let-bindings instead of piping
-- dropWhile/dropWhileRight directly into an anonymous lambda, because the
-- compiler loses the concrete list element type at the lambda boundary
-- (generates []any where []Step is expected).
toSteps : String -> List Step
toSteps string =
    let
        allSteps =
            string |> String.trimEnd |> String.lines |> List.map parseLine
                |> List.concat

        trimmedSteps =
            allSteps
                |> LE.dropWhile (\s -> s == EmptyLine)
                |> LE.dropWhileRight (\s -> s == EnterChar || s == EmptyLine)
    in
        trimmedSteps ++ [ Step.initEnd ]


parseLine : String -> List Step
parseLine string =
    let
        leadingSpaces =
            string |> String.toList |> LE.takeWhile (\c -> c == ' ')
        rest = string |> String.trim |> String.toList
    in
        case ( leadingSpaces, rest ) of

            ( _, [] ) ->
                [ EmptyLine ]

            ( [], typeables ) ->
                (List.map Typeable typeables) ++ [ EnterChar ]

            ( spaces, typeables ) ->
                [ Skip (String.fromList spaces) ] ++ List.map Typeable rest
                    ++ [ EnterChar ]


--
-- PRIVATE
--
enterString : String
enterString =
    "<enter>"
