module List.Extra exposing
    ( applyWindow
    , dropRight
    , dropWhile
    , dropWhileRight
    , gatherWith
    , intersperse
    , partition
    , repeat
    , takeWhile
    )


applyWindow : Int -> Int -> Int -> List a -> List a
applyWindow beforeCount currentIndex afterCount list =
    list |> List.drop (currentIndex - beforeCount)
        |> dropRight ((List.length list) - (currentIndex + afterCount) - 1)


dropRight : Int -> List a -> List a
dropRight n list =
    List.reverse list |> List.drop n |> List.reverse


dropWhile : (a -> Bool) -> List a -> List a
dropWhile predicate list =
    case list of

        [] ->
            []

        x :: xs ->
            if predicate x then
                dropWhile predicate xs

            else
                list


dropWhileRight : (a -> Bool) -> List a -> List a
dropWhileRight p list =
    List.foldr
        (\x xs ->
            if p x && List.isEmpty xs then
                []

            else
                x :: xs)
        []
        list


gatherWith : (a -> a -> Bool) -> List a -> List ( a, List a )
gatherWith testFn list =
    let
        helper : List a -> List ( a, List a ) -> List ( a, List a )
        helper scattered gathered =
            case scattered of

                [] ->
                    List.reverse gathered

                toGather :: population ->
                    let
                        ( gathering, remaining ) =
                            partition (testFn toGather) population
                    in
                        helper remaining (( toGather, gathering ) :: gathered)
    in
        helper list []


intersperse : a -> List a -> List a
intersperse sep xs =
    case xs of

        [] ->
            []

        hd :: tl ->
            let
                step x rest = List.cons sep (List.cons x rest)
                spersed = List.foldr step [] tl
            in
                List.cons hd spersed


partition : (a -> Bool) -> List a -> ( List a, List a )
partition pred list =
    let
        step x acc =
            if pred x then
                ( List.cons x (fst acc), snd acc )

            else
                ( fst acc, List.cons x (snd acc) )
    in
        List.foldr step ( [], [] ) list


repeat : Int -> a -> List a
repeat count item =
    let
        helper : List a -> Int -> a -> List a
        helper result n value =
            if n <= 0 then
                result

            else
                helper (List.cons value result) (n - 1) value
    in
        helper [] count item


takeWhile : (a -> Bool) -> List a -> List a
takeWhile predicate list =
    let
        takeWhileMemo memo list =
            case list of

                [] ->
                    List.reverse memo

                x :: xs ->
                    if predicate x then
                        takeWhileMemo (x :: memo) xs

                    else
                        List.reverse memo
    in
        takeWhileMemo [] list
