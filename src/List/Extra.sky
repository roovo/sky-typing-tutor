module List.Extra exposing (dropWhile, dropWhileRight, intersperse, takeWhile, takeWhileHelper)


{-| Places the given value between all members of the given list.

    intersperse "on" ["turtles","turtles","turtles"] == ["turtles","on","turtles","on","turtles"]
-}
intersperse : a -> List a -> List a
intersperse sep xs =
    case xs of

        [] ->
            []

        hd :: tl ->
            let
                step x rest = List.cons sep (List.cons x rest)
                spersed = List.foldr step [] tl
            in
                List.cons hd spersed


{-| Take elements in order as long as the predicate evaluates to `True`
-}
-- COMPILER BUG WORKAROUND (Issue 2): Uses a top-level helper instead of a
-- recursive let-binding because the compiler generates an undefined variable
-- reference for recursive closures inside let...in blocks.
takeWhile : (a -> Bool) -> List a -> List a
takeWhile predicate list =
    takeWhileHelper predicate [] list


takeWhileHelper : (a -> Bool) -> List a -> List a -> List a
takeWhileHelper predicate memo list =
    case list of

        [] ->
            List.reverse memo

        x :: xs ->
            if predicate x then
                takeWhileHelper predicate (x :: memo) xs

            else
                List.reverse memo


{-| Drop elements in order as long as the predicate evaluates to `True`
-}
dropWhile : (a -> Bool) -> List a -> List a
dropWhile predicate list =
    case list of

        [] ->
            []

        x :: xs ->
            if predicate x then
                dropWhile predicate xs

            else
                list


{-| Drop elements from the right, while predicate still holds.

    dropWhileRight ((<) 5) (List.range 1 10)
    --> [ 1, 2, 3, 4, 5 ]

-}
dropWhileRight : (a -> Bool) -> List a -> List a
dropWhileRight p list =
    List.foldr
        (\x xs ->
            if p x && List.isEmpty xs then
                []

            else
                x :: xs)
        []
        list
