module Printable exposing
    ( Printable(..)
    , Style(..)
    , fromStep
    , splitIntoLines
    , takeFirstLines
    , takeLastLines
    )

type Style
    = Current
    | Errored
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


fromStep : Style -> Step -> Printable
fromStep style step =
    case step of

        End ->
            UnstyledEnd

        EnterChar ->
            StyledEnter style

        EmptyLine ->
            UnstyledEmptyLine

        Skip st ->
            Styled st Unstyled

        Typeable ch ->
            Styled (String.fromChar ch) style


splitIntoLines : List Printable -> List (List Printable)
splitIntoLines printables =
    let
        helper : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
        helper ps lineAcc acc =
            case ps of

                [] ->
                    case lineAcc of

                        [] ->
                            List.reverse acc

                        _ ->
                            List.reverse (List.reverse lineAcc :: acc)

                p :: rest ->
                    case p of

                        StyledEnter _ ->
                            helper rest [] (List.reverse (p :: lineAcc) :: acc)

                        UnstyledEmptyLine ->
                            if List.isEmpty lineAcc then
                                helper rest [] ([ p ] :: acc)

                            else
                                helper
                                    rest
                                    []
                                    ([ p ] :: List.reverse lineAcc :: acc)

                        _ ->
                            helper rest (p :: lineAcc) acc
    in
        helper printables [] []


takeFirstLines : Int -> Printable -> List Printable -> List Printable
takeFirstLines n current printables =
    let
        helper : Int -> List Printable -> Int -> List Printable -> List Printable
        helper n printables lineCount acc =
            case printables of

                [] ->
                    List.reverse acc

                printable :: rest ->
                    if lineCount >= n then
                        List.reverse acc

                    else
                        let
                            newLineCount =
                                if isNewLinePrintable printable then
                                    lineCount + 1

                                else
                                    lineCount
                        in
                            helper n rest newLineCount (printable :: acc)
        wantedLineCount =
            if isNewLinePrintable current then
                n

            else
                n + 1
    in
        helper wantedLineCount printables 0 []


takeLastLines : Int -> List Printable -> List Printable
takeLastLines n steps =
    let
        helper : Int -> List Printable -> Int -> List Printable -> List Printable
        helper n steps lineCount acc =
            case steps of

                [] ->
                    acc

                printable :: rest ->
                    if lineCount >= n then
                        acc |> List.drop 1

                    else
                        let
                            newLineCount =
                                if isNewLinePrintable printable then
                                    lineCount + 1

                                else
                                    lineCount
                        in
                            helper n rest newLineCount (printable :: acc)
    in
        helper (n + 1) (List.reverse steps) 0 []


--
-- PRIVATE
--
isNewLinePrintable : Printable -> Bool
isNewLinePrintable printable =
    case printable of

        StyledEnter _ ->
            True

        UnstyledEmptyLine ->
            True

        _ ->
            False
