module Printable exposing (Printable(..), Style(..), fromStep, splitIntoLines)

type Style
    = Current
    | Errored
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


fromStep : Style -> Step -> Printable
fromStep style step =
    case step of

        End ->
            UnstyledEnd

        EnterChar ->
            StyledEnter style

        EmptyLine ->
            UnstyledEmptyLine

        Skip st ->
            Styled st Unstyled

        Typeable ch ->
            Styled (String.fromChar ch) style


splitIntoLines : List Printable -> List (List Printable)
splitIntoLines printables =
    let
        helper : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
        helper ps lineAcc acc =
            case ps of

                [] ->
                    case lineAcc of

                        [] ->
                            List.reverse acc

                        _ ->
                            List.reverse (List.reverse lineAcc :: acc)

                p :: rest ->
                    case p of

                        StyledEnter _ ->
                            helper rest [] (List.reverse (p :: lineAcc) :: acc)

                        UnstyledEmptyLine ->
                            if List.isEmpty lineAcc then
                                helper rest [] ([ p ] :: acc)

                            else
                                helper
                                    rest
                                    []
                                    ([ p ] :: List.reverse lineAcc :: acc)

                        _ ->
                            helper rest (p :: lineAcc) acc
    in
        helper printables [] []
