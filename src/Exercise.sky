module Exercise exposing
    ( Exercise
    , Printable(..)
    , Style(..)
    , accuracy
    , consume
    , currentLineIndex
    , init
    , printableLines
    , title
    , wpm
    )

import Sky.Core.Debug as Debug
import Event exposing (Event)
import ExerciseParser
import Step
import Zipper

-- MODEL
--
type alias Exercise =
    { errorCount : Int
    , events : List Event
    , stepsAfter : List Step
    , stepsBefore : List Step
    , stepsCurrent : Step
    , text : String
    , title : String
    }

type Style
    = Current
    | Error
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


init : String -> String -> Exercise
init title text =
    let
        zippedSteps =
            text |> ExerciseParser.toSteps |> Zipper.fromList
                |> Maybe.withDefault (Zipper.singleton Step.initEnd)
                |> Zipper.first
                |> toInitialStep
    in
        { errorCount = 0
        , events = []
        , stepsAfter = Zipper.after zippedSteps
        , stepsBefore = Zipper.before zippedSteps
        , stepsCurrent = Zipper.current zippedSteps
        , text = text
        , title = title
        }


--
-- INFO
--
accuracy : Exercise -> Float
accuracy exercise =
    case Event.howManyTyped exercise.events of

        0 ->
            0.0

        n ->
            (toFloat <| howManyCharacters exercise) / toFloat n * 100.0


currentLineIndex : Exercise -> Int
currentLineIndex exercise =
    let
        newLineSteps step =
            case step of

                Step.EnterChar ->
                    True

                Step.EmptyLine ->
                    True

                _ ->
                    False
    in
        exercise.stepsBefore |> List.filter newLineSteps |> List.length


printableLines : Exercise -> List (List Printable)
printableLines exercise =
    splitIntoLines (printables exercise) [] []


title : Exercise -> String
title exercise =
    exercise.title


wpm : Exercise -> Float
wpm exercise =
    let
        timeTaken = Event.timeTaken exercise.events
    in
        if timeTaken == 0 then
            0.0

        else
            howManyWords exercise / (toFloat timeTaken) * 60000.0


--
-- PROGRESSING
--
consume : Char -> Int -> Exercise -> Exercise
consume ch elapsedTime exercise =
    let
        zippedSteps = exerciseZipper exercise
        isMatchingChar = Step.matchesTyped ch (Zipper.current zippedSteps)
        isErrorFree = exercise.errorCount <= 0
        isBackSpace = ch == backspaceChar
        atEnd = Step.isEnd (Zipper.current zippedSteps)
    in
        if isMatchingChar && isErrorFree then
            let
                newZippedSteps = skipOver Next zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , stepsAfter = Zipper.after newZippedSteps
                , stepsBefore = Zipper.before newZippedSteps
                , stepsCurrent = Zipper.current newZippedSteps
                }

        else if atEnd then
            exercise

        else if isBackSpace && isErrorFree then
            let
                newZippedSteps = skipOver Previous zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , stepsAfter = Zipper.after newZippedSteps
                , stepsBefore = Zipper.before newZippedSteps
                , stepsCurrent = Zipper.current newZippedSteps
                }

        else if isBackSpace then
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount - 1
            }

        else
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount + 1
            }

--
-- PRIVATE
--
type Direction
    = Next
    | Previous


afterStyles : Int -> Zipper Step -> List Printable
afterStyles errorCount zippedSteps =
    zippedSteps |> Zipper.after |> List.indexedMap (afterPrintable errorCount)


afterPrintable : Int -> Int -> Step -> Printable
afterPrintable errorCount index step =
    if index < (errorCount - 1) then
        toPrintable Error step

    else
        toPrintable Waiting step


backspaceChar : Char
backspaceChar =
    Char.fromCode 8


beforeStyles : Zipper Step -> List Printable
beforeStyles zippedSteps =
    zippedSteps |> Zipper.before |> List.map (toPrintable Completed)


currentStyle : Int -> Zipper Step -> List Printable
currentStyle errorCount zippedSteps =
    let
        style =
            if errorCount <= 0 then
                Current

            else
                Error
    in
        [ zippedSteps |> Zipper.current |> toPrintable style ]


exerciseZipper : Exercise -> Zipper Step
exerciseZipper exercise =
    { ls = List.reverse exercise.stepsBefore
    , focus = exercise.stepsCurrent
    , rs = exercise.stepsAfter
    }


follwedSteps : Exercise -> Zipper Step
follwedSteps exercise =
    exercise |> steps |> Zipper.first |> toInitialStep
        |> followEvents exercise.events


followEvents : List Event -> Zipper Step -> Zipper Step
followEvents events initialSteps =
    processEvents (List.reverse events) initialSteps 0


followEventsErrorCount : List Event -> Zipper Step -> Int
followEventsErrorCount events initialSteps =
    processEventsErrors (List.reverse events) initialSteps 0


howManyCharacters : Exercise -> Int
howManyCharacters exercise =
    steps exercise |> Zipper.first |> toInitialStep
        |> followEvents exercise.events
        |> Zipper.before
        |> List.filter Step.isTypeable
        |> List.length


howManyWords : Exercise -> Float
howManyWords exercise =
    (toFloat <| howManyCharacters exercise) / lettersPerWord


lettersPerWord : Float
lettersPerWord =
    5.0


processEvents : List Event -> Zipper Step -> Int -> Zipper Step
processEvents events steps1 errorCount =
    case events of

        [] ->
            steps1

        event :: rest ->
            let
                isMatchingChar =
                    Step.matchesTyped event.char (Zipper.current steps1)
                isErrorFree = errorCount <= 0
                isBackSpace = event.char == backspaceChar
                atEnd = Step.isEnd (Zipper.current steps1)
            in
                if isMatchingChar && isErrorFree then
                    processEvents rest (skipOver Next steps1) errorCount

                else if atEnd then
                    processEvents rest steps1 errorCount

                else if isBackSpace && isErrorFree then
                    processEvents rest (skipOver Previous steps1) errorCount

                else if isBackSpace then
                    processEvents rest steps1 (errorCount - 1)

                else
                    processEvents rest steps1 (errorCount + 1)


processEventsErrors : List Event -> Zipper Step -> Int -> Int
processEventsErrors events steps1 errorCount =
    case events of

        [] ->
            errorCount

        event :: rest ->
            let
                isMatchingChar =
                    Step.matchesTyped event.char (Zipper.current steps1)
                isErrorFree = errorCount <= 0
                isBackSpace = event.char == backspaceChar
                atEnd = Step.isEnd (Zipper.current steps1)
            in
                if isMatchingChar && isErrorFree then
                    processEventsErrors rest (skipOver Next steps1) errorCount

                else if atEnd then
                    processEventsErrors rest steps1 errorCount

                else if isBackSpace && isErrorFree then
                    processEventsErrors
                        rest
                        (skipOver Previous steps1)
                        errorCount

                else if isBackSpace then
                    processEventsErrors rest steps1 (errorCount - 1)

                else
                    processEventsErrors rest steps1 (errorCount + 1)


logEvent : Char -> Int -> Exercise -> List Event
logEvent ch elapsedTime exercise =
    let
        newEvent = { char = ch, timeTaken = elapsedTime }
    in
        newEvent :: exercise.events


printables : Exercise -> List Printable
printables exercise =
    setStyles (exerciseZipper exercise) exercise.errorCount


setStyles : Zipper Step -> Int -> List Printable
setStyles zippedSteps errorCount =
    beforeStyles zippedSteps ++ currentStyle errorCount zippedSteps
        ++ afterStyles errorCount zippedSteps


skipOver : Direction -> Zipper Step -> Zipper Step
skipOver direction steps1 =
    let
        newSteps = zipperMover direction steps1
    in
        if Step.isSkipable (Zipper.current newSteps) then
            skipOver direction newSteps

        else
            newSteps


splitIntoLines : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
splitIntoLines printables currentLine acc =
    case printables of

        [] ->
            List.reverse (List.reverse currentLine :: acc)

        p :: rest ->
            case p of

                StyledEnter _ ->
                    splitIntoLines
                        rest
                        []
                        (List.reverse (p :: currentLine) :: acc)

                UnstyledEmptyLine ->
                    if List.isEmpty currentLine then
                        splitIntoLines rest [] ([ p ] :: acc)

                    else
                        splitIntoLines
                            rest
                            []
                            ([ p ] :: List.reverse currentLine :: acc)

                _ ->
                    splitIntoLines rest (p :: currentLine) acc


steps : Exercise -> Zipper Step
steps exercise =
    exercise.text |> ExerciseParser.toSteps |> Zipper.fromList
        |> Maybe.withDefault (Zipper.singleton Step.initEnd)


toFloat : Int -> Float
toFloat n =
    String.fromInt n |> String.toFloat |> Maybe.withDefault 0.0


toInitialStep : Zipper Step -> Zipper Step
toInitialStep zippedSteps =
    let
        currentStep = Zipper.current zippedSteps
    in
        if Step.isSkipable currentStep then
            skipOver Next zippedSteps

        else
            zippedSteps


toPrintable : Style -> Step -> Printable
toPrintable style step =
    case step of

        Step.End ->
            UnstyledEnd

        Step.EnterChar ->
            StyledEnter style

        Step.EmptyLine ->
            UnstyledEmptyLine

        Step.Skip st ->
            Styled st Unstyled

        Step.Typeable ch ->
            Styled (String.fromChar ch) style


zipperMover : Direction -> Zipper Step -> Zipper Step
zipperMover direction zs =
    case direction of

        Next ->
            Zipper.next zs

        Previous ->
            Zipper.previous zs
