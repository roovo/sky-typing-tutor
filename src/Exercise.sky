module Exercise exposing
    ( Exercise
    , Printable(..)
    , Style(..)
    , accuracy
    , consume
    , currentLineIndex
    , init
    , isComplete
    , language
    , printableLines
    , printableLineCount
    , fullPath
    , typeableCharacterCount
    , wpm
    )

import Sky.Core.Debug as Debug
import Event exposing (Event)
import ExerciseParser
import Step
import Zipper

-- MODEL
--
type alias Exercise =
    { errorCount : Int
    , events : List Event
    , steps : Zipper Step
    , text : String
    , fullPath : String
    }

type Style
    = Current
    | Errored
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


init : String -> String -> Exercise
init fullPath text =
    let
        zippedSteps =
            text |> ExerciseParser.toSteps |> Zipper.fromList
                |> Maybe.withDefault (Zipper.singleton Step.initEnd)
                |> Zipper.first
                |> toInitialStep
    in
        { errorCount = 0
        , events = []
        , steps = zippedSteps
        , text = text
        , fullPath = fullPath
        }


--
-- INFO
--
accuracy : Exercise -> Float
accuracy exercise =
    case Event.howManyTyped exercise.events of

        0 ->
            0.0

        n ->
            (toFloat <| howManyCharactersSoFar exercise) / toFloat n * 100.0


currentLineIndex : Exercise -> Int
currentLineIndex exercise =
    let
        newLineSteps step =
            case step of

                EnterChar ->
                    True

                EmptyLine ->
                    True

                _ ->
                    False
    in
        Zipper.before exercise.steps |> List.filter newLineSteps |> List.length


isComplete : Exercise -> Bool
isComplete exercise =
    Zipper.current exercise.steps |> Step.isEnd


language : Exercise -> String
language exercise =
    case Path.ext exercise.fullPath of

        ".bash" ->
            "Shell"

        ".css" ->
            "CSS"

        ".dockerfile" ->
            "Dockerfile"

        ".elm" ->
            "Elm"

        ".ex" ->
            "Elixir"

        ".exs" ->
            "Elixir"

        ".go" ->
            "Go"

        ".java" ->
            "Java"

        ".js" ->
            "JavaScript"

        ".json" ->
            "JSON"

        ".lua" ->
            "Lua"

        ".md" ->
            "Markdown"

        ".py" ->
            "Python"

        ".rb" ->
            "Ruby"

        ".sh" ->
            "Shell"

        ".sky" ->
            "Sky"

        ".sql" ->
            "SQL"

        ".ts" ->
            "TypeScript"

        ".txt" ->
            "Text"

        ".yml" ->
            "YAML"

        ".yaml" ->
            "YAML"

        _ ->
            "unknown"


printableLineCount : Exercise -> Int
printableLineCount exercise =
    0


printableLines : Int -> Int -> Exercise -> List (List Printable)
printableLines linesBefore linesAfter exercise =
    splitIntoLines (windowedPrintables linesBefore linesAfter exercise) [] []


fullPath : Exercise -> String
fullPath exercise =
    exercise.fullPath


typeableCharacterCount : Exercise -> Int
typeableCharacterCount exercise =
    exercise.steps |> Zipper.toList |> List.filter Step.isTypeable
        |> List.length


wpm : Exercise -> Float
wpm exercise =
    let
        timeTaken = Event.timeTaken exercise.events
    in
        if timeTaken == 0 then
            0.0

        else
            howManyWordsSoFar exercise / (toFloat timeTaken) * 60000.0


--
-- PROGRESSING
--
consume : Char -> Int -> Exercise -> Exercise
consume ch elapsedTime exercise =
    let
        zippedSteps = exercise.steps
        isMatchingChar = Step.matchesTyped ch (Zipper.current zippedSteps)
        isErrorFree = exercise.errorCount <= 0
        isBackSpace = ch == backspaceChar
        atEnd = Step.isEnd (Zipper.current zippedSteps)
    in
        if isMatchingChar && isErrorFree then
            let
                newZippedSteps = skipOver Next zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , steps = newZippedSteps
                }

        else if atEnd then
            exercise

        else if isBackSpace && isErrorFree then
            let
                newZippedSteps = skipOver Previous zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , steps = newZippedSteps
                }

        else if isBackSpace then
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount - 1
            }

        else
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount + 1
            }

--
-- PRIVATE
--
type Direction
    = Next
    | Previous


afterPrintable : Int -> Int -> Step -> Printable
afterPrintable errorCount index step =
    if index < (errorCount - 1) then
        toPrintable Errored step

    else
        toPrintable Waiting step


backspaceChar : Char
backspaceChar =
    Char.fromCode 8


currentStepStyle : Int -> Style
currentStepStyle errorCount =
    if errorCount <= 0 then
        Current

    else
        Errored


howManyCharactersSoFar : Exercise -> Int
howManyCharactersSoFar exercise =
    Zipper.before exercise.steps |> List.filter Step.isTypeable |> List.length


howManyWordsSoFar : Exercise -> Float
howManyWordsSoFar exercise =
    (toFloat <| howManyCharactersSoFar exercise) / lettersPerWord


isNewLineStep : Step -> Bool
isNewLineStep step =
    case step of

        Step.EnterChar ->
            True

        Step.EmptyLine ->
            True

        _ ->
            False


lettersPerWord : Float
lettersPerWord =
    5.0


logEvent : Char -> Int -> Exercise -> List Event
logEvent ch elapsedTime exercise =
    let
        newEvent = { char = ch, timeTaken = elapsedTime }
    in
        newEvent :: exercise.events


skipOver : Direction -> Zipper Step -> Zipper Step
skipOver direction steps1 =
    let
        newSteps = zipperMover direction steps1
    in
        if Step.isSkipable (Zipper.current newSteps) then
            skipOver direction newSteps

        else
            newSteps


splitIntoLines : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
splitIntoLines printables currentLine acc =
    case printables of

        [] ->
            case currentLine of

                [] ->
                    List.reverse acc

                _ ->
                    List.reverse (List.reverse currentLine :: acc)

        p :: rest ->
            case p of

                StyledEnter _ ->
                    splitIntoLines
                        rest
                        []
                        (List.reverse (p :: currentLine) :: acc)

                UnstyledEmptyLine ->
                    if List.isEmpty currentLine then
                        splitIntoLines rest [] ([ p ] :: acc)

                    else
                        splitIntoLines
                            rest
                            []
                            ([ p ] :: List.reverse currentLine :: acc)

                _ ->
                    splitIntoLines rest (p :: currentLine) acc


takeFirstNLines : Int -> Step -> List Step -> List Step
takeFirstNLines n currentStep steps =
    let
        takeFirstNLinesHelper : Int -> List Step -> Int -> List Step -> List Step
        takeFirstNLinesHelper n steps lineCount acc =
            case steps of

                [] ->
                    List.reverse acc

                step :: rest ->
                    if lineCount >= n then
                        List.reverse acc

                    else
                        let
                            newLineCount =
                                if isNewLineStep step then
                                    lineCount + 1

                                else
                                    lineCount
                        in
                            takeFirstNLinesHelper
                                n
                                rest
                                newLineCount
                                (step :: acc)
        wantedLineCount =
            if isNewLineStep currentStep then
                n

            else
                n + 1
    in
        takeFirstNLinesHelper wantedLineCount steps 0 []


takeLastNLines : Int -> List Step -> List Step
takeLastNLines n steps =
    let
        takeLastNLinesHelper : Int -> List Step -> Int -> List Step -> List Step
        takeLastNLinesHelper n steps lineCount acc =
            case steps of

                [] ->
                    acc

                step :: rest ->
                    if lineCount >= n then
                        acc |> List.drop 1

                    else
                        let
                            newLineCount =
                                if isNewLineStep step then
                                    lineCount + 1

                                else
                                    lineCount
                        in
                            takeLastNLinesHelper
                                n
                                rest
                                newLineCount
                                (step :: acc)
    in
        takeLastNLinesHelper (n + 1) (List.reverse steps) 0 []


toFloat : Int -> Float
toFloat n =
    String.fromInt n |> String.toFloat |> Maybe.withDefault 0.0


toInitialStep : Zipper Step -> Zipper Step
toInitialStep zippedSteps =
    let
        currentStep = Zipper.current zippedSteps
    in
        if Step.isSkipable currentStep then
            skipOver Next zippedSteps

        else
            zippedSteps


toPrintable : Style -> Step -> Printable
toPrintable style step =
    case step of

        End ->
            UnstyledEnd

        EnterChar ->
            StyledEnter style

        EmptyLine ->
            UnstyledEmptyLine

        Skip st ->
            Styled st Unstyled

        Typeable ch ->
            Styled (String.fromChar ch) style


windowedPrintables : Int -> Int -> Exercise -> List Printable
windowedPrintables linesBefore linesAfter exercise =
    let
        windowedBefore =
            takeLastNLines linesBefore (Zipper.before exercise.steps)
        windowedAfter =
            takeFirstNLines
                linesAfter
                (Zipper.current exercise.steps)
                (Zipper.after exercise.steps)
        beforePrintables = List.map (toPrintable Completed) windowedBefore
        currentPrintable =
            [ toPrintable
                  (currentStepStyle exercise.errorCount)
                  (Zipper.current exercise.steps)
            ]
        afterPrintables =
            List.indexedMap (afterPrintable exercise.errorCount) windowedAfter
    in
        beforePrintables ++ currentPrintable ++ afterPrintables


zipperMover : Direction -> Zipper Step -> Zipper Step
zipperMover direction zs =
    case direction of

        Next ->
            Zipper.next zs

        Previous ->
            Zipper.previous zs
