module Exercise exposing (Exercise, Printable(..), Style(..), init, printableLines, title)

import Sky.Core.Debug as Debug
import ExerciseParser
import Step
import Zipper

-- MODEL
--
type alias Exercise =
    { title : String
    , text : String
    }

type Style
    = Current
    | Error
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


init : String -> String -> Exercise
init title text =
    { title = title, text = text }


--
-- INFO
--
printableLines : Exercise -> List (List Printable)
printableLines exercise =
    splitIntoLines (printables exercise) [] []


splitIntoLines : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
splitIntoLines printables currentLine acc =
    case printables of

        [] ->
            List.reverse (List.reverse currentLine :: acc)

        p :: rest ->
            case p of

                StyledEnter _ ->
                    splitIntoLines
                        rest
                        []
                        (List.reverse (p :: currentLine) :: acc)

                UnstyledEmptyLine ->
                    splitIntoLines rest [] (List.reverse currentLine :: acc)

                _ ->
                    splitIntoLines rest (p :: currentLine) acc


title : Exercise -> String
title exercise =
    exercise.title

--
-- PRIVATE
--
type Direction
    = Next
    | Previous


beforeStyles : Zipper Step -> List Printable
beforeStyles zippedSteps =
    zippedSteps |> Zipper.before |> List.map (toPrintable Completed)


currentStyle : Zipper Step -> List Printable
currentStyle zippedSteps =
    [ zippedSteps |> Zipper.current |> toPrintable Current ]


afterStyles : Zipper Step -> List Printable
afterStyles zippedSteps =
    zippedSteps |> Zipper.after |> List.map (toPrintable Waiting)


printables : Exercise -> List Printable
printables exercise =
    steps exercise |> Zipper.first |> toInitialStep |> setStyles


setStyles : Zipper Step -> List Printable
setStyles zippedSteps =
    beforeStyles zippedSteps ++ currentStyle zippedSteps
        ++ afterStyles zippedSteps


skipOver : Direction -> Zipper Step -> Zipper Step
skipOver direction steps1 =
    let
        newSteps = zipperMover direction steps1
    in
        if Step.isSkipable (Zipper.current newSteps) then
            skipOver direction newSteps

        else
            newSteps


steps : Exercise -> Zipper Step
steps exercise =
    exercise.text |> ExerciseParser.toSteps |> Zipper.fromList
        |> Maybe.withDefault (Zipper.singleton Step.initEnd)


toInitialStep : Zipper Step -> Zipper Step
toInitialStep zippedSteps =
    let
        currentStep = Zipper.current zippedSteps
    in
        if Step.isSkipable currentStep then
            skipOver Next zippedSteps

        else
            zippedSteps


toPrintable : Style -> Step -> Printable
toPrintable style step =
    case step of

        Step.End ->
            UnstyledEnd

        Step.EnterChar ->
            StyledEnter style

        Step.EmptyLine ->
            UnstyledEmptyLine

        Step.Skip st ->
            Styled st Unstyled

        Step.Typeable ch ->
            Styled (String.fromChar ch) style


zipperMover : Direction -> Zipper Step -> Zipper Step
zipperMover direction zs =
    case direction of

        Next ->
            Zipper.next zs

        Previous ->
            Zipper.previous zs
