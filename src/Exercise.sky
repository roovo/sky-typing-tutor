module Exercise exposing
    ( Exercise
    , Printable(..)
    , Style(..)
    , accuracy
    , consume
    , currentLineIndex
    , init
    , language
    , printableLines
    , title
    , wpm
    )

import Sky.Core.Debug as Debug
import Event exposing (Event)
import ExerciseParser
import Step
import Zipper

-- MODEL
--
type alias Exercise =
    { errorCount : Int
    , events : List Event
    , stepsAfter : List Step
    , stepsBefore : List Step
    , stepsCurrent : Step
    , text : String
    , title : String
    }

type Style
    = Current
    | Error
    | Completed
    | Unstyled
    | Waiting

type Printable
    = Styled String Style
    | StyledEnter Style
    | UnstyledEmptyLine
    | UnstyledEnd


init : String -> String -> Exercise
init title text =
    let
        zippedSteps =
            text |> ExerciseParser.toSteps |> Zipper.fromList
                |> Maybe.withDefault (Zipper.singleton Step.initEnd)
                |> Zipper.first
                |> toInitialStep
    in
        { errorCount = 0
        , events = []
        , stepsAfter = Zipper.after zippedSteps
        , stepsBefore = Zipper.before zippedSteps
        , stepsCurrent = Zipper.current zippedSteps
        , text = text
        , title = title
        }


--
-- INFO
--
accuracy : Exercise -> Float
accuracy exercise =
    case Event.howManyTyped exercise.events of

        0 ->
            0.0

        n ->
            (toFloat <| howManyCharacters exercise) / toFloat n * 100.0


currentLineIndex : Exercise -> Int
currentLineIndex exercise =
    let
        newLineSteps step =
            case step of

                Step.EnterChar ->
                    True

                Step.EmptyLine ->
                    True

                _ ->
                    False
    in
        exercise.stepsBefore |> List.filter newLineSteps |> List.length


language : Exercise -> String
language exercise =
    case Path.ext exercise.title of

        ".bash" ->
            "Shell"

        ".css" ->
            "CSS"

        ".dockerfile" ->
            "Dockerfile"

        ".elm" ->
            "Elm"

        ".ex" ->
            "Elixir"

        ".exs" ->
            "Elixir"

        ".go" ->
            "Go"

        ".java" ->
            "Java"

        ".js" ->
            "JavaScript"

        ".json" ->
            "JSON"

        ".lua" ->
            "Lua"

        ".md" ->
            "Markdown"

        ".py" ->
            "Python"

        ".rb" ->
            "Ruby"

        ".sh" ->
            "Shell"

        ".sky" ->
            "Sky"

        ".sql" ->
            "SQL"

        ".ts" ->
            "TypeScript"

        ".txt" ->
            "Text"

        ".yml" ->
            "YAML"

        ".yaml" ->
            "YAML"

        _ ->
            "unknown"


printableLines : Int -> Int -> Exercise -> List (List Printable)
printableLines linesBefore linesAfter exercise =
    splitIntoLines (windowedPrintables linesBefore linesAfter exercise) [] []


title : Exercise -> String
title exercise =
    exercise.title


wpm : Exercise -> Float
wpm exercise =
    let
        timeTaken = Event.timeTaken exercise.events
    in
        if timeTaken == 0 then
            0.0

        else
            howManyWords exercise / (toFloat timeTaken) * 60000.0


--
-- PROGRESSING
--
consume : Char -> Int -> Exercise -> Exercise
consume ch elapsedTime exercise =
    let
        zippedSteps = exerciseZipper exercise
        isMatchingChar = Step.matchesTyped ch (Zipper.current zippedSteps)
        isErrorFree = exercise.errorCount <= 0
        isBackSpace = ch == backspaceChar
        atEnd = Step.isEnd (Zipper.current zippedSteps)
    in
        if isMatchingChar && isErrorFree then
            let
                newZippedSteps = skipOver Next zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , stepsAfter = Zipper.after newZippedSteps
                , stepsBefore = Zipper.before newZippedSteps
                , stepsCurrent = Zipper.current newZippedSteps
                }

        else if atEnd then
            exercise

        else if isBackSpace && isErrorFree then
            let
                newZippedSteps = skipOver Previous zippedSteps
            in
                { exercise | events = logEvent ch elapsedTime exercise
                , stepsAfter = Zipper.after newZippedSteps
                , stepsBefore = Zipper.before newZippedSteps
                , stepsCurrent = Zipper.current newZippedSteps
                }

        else if isBackSpace then
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount - 1
            }

        else
            { exercise | events = logEvent ch elapsedTime exercise
            , errorCount = exercise.errorCount + 1
            }

--
-- PRIVATE
--
type Direction
    = Next
    | Previous


afterPrintable : Int -> Int -> Step -> Printable
afterPrintable errorCount index step =
    if index < (errorCount - 1) then
        toPrintable Error step

    else
        toPrintable Waiting step


backspaceChar : Char
backspaceChar =
    Char.fromCode 8


currentStepStyle : Int -> Style
currentStepStyle errorCount =
    if errorCount <= 0 then
        Current

    else
        Error


exerciseZipper : Exercise -> Zipper Step
exerciseZipper exercise =
    { ls = List.reverse exercise.stepsBefore
    , focus = exercise.stepsCurrent
    , rs = exercise.stepsAfter
    }


howManyCharacters : Exercise -> Int
howManyCharacters exercise =
    exercise.stepsBefore |> List.filter Step.isTypeable |> List.length


howManyWords : Exercise -> Float
howManyWords exercise =
    (toFloat <| howManyCharacters exercise) / lettersPerWord


isNewLineStep : Step -> Bool
isNewLineStep step =
    case step of

        Step.EnterChar ->
            True

        Step.EmptyLine ->
            True

        _ ->
            False


lettersPerWord : Float
lettersPerWord =
    5.0


logEvent : Char -> Int -> Exercise -> List Event
logEvent ch elapsedTime exercise =
    let
        newEvent = { char = ch, timeTaken = elapsedTime }
    in
        newEvent :: exercise.events


skipOver : Direction -> Zipper Step -> Zipper Step
skipOver direction steps1 =
    let
        newSteps = zipperMover direction steps1
    in
        if Step.isSkipable (Zipper.current newSteps) then
            skipOver direction newSteps

        else
            newSteps


splitIntoLines : List Printable -> List Printable -> List (List Printable) -> List (List Printable)
splitIntoLines printables currentLine acc =
    case printables of

        [] ->
            List.reverse (List.reverse currentLine :: acc)

        p :: rest ->
            case p of

                StyledEnter _ ->
                    splitIntoLines
                        rest
                        []
                        (List.reverse (p :: currentLine) :: acc)

                UnstyledEmptyLine ->
                    if List.isEmpty currentLine then
                        splitIntoLines rest [] ([ p ] :: acc)

                    else
                        splitIntoLines
                            rest
                            []
                            ([ p ] :: List.reverse currentLine :: acc)

                _ ->
                    splitIntoLines rest (p :: currentLine) acc


takeFirstNLines : Int -> List Step -> List Step
takeFirstNLines n steps1 =
    takeFirstNLinesHelper n steps1 0 []


takeFirstNLinesHelper : Int -> List Step -> Int -> List Step -> List Step
takeFirstNLinesHelper n steps1 lineCount acc =
    case steps1 of

        [] ->
            List.reverse acc

        step :: rest ->
            if lineCount >= n then
                List.reverse acc

            else
                let
                    newLineCount =
                        if isNewLineStep step then
                            lineCount + 1

                        else
                            lineCount
                in
                    takeFirstNLinesHelper n rest newLineCount (step :: acc)


takeLastNLines : Int -> List Step -> List Step
takeLastNLines n steps1 =
    takeLastNLinesHelper n (List.reverse steps1) 0 []


takeLastNLinesHelper : Int -> List Step -> Int -> List Step -> List Step
takeLastNLinesHelper n steps1 lineCount acc =
    case steps1 of

        [] ->
            acc

        step :: rest ->
            if lineCount >= n then
                acc

            else
                let
                    newLineCount =
                        if isNewLineStep step then
                            lineCount + 1

                        else
                            lineCount
                in
                    takeLastNLinesHelper n rest newLineCount (step :: acc)


toFloat : Int -> Float
toFloat n =
    String.fromInt n |> String.toFloat |> Maybe.withDefault 0.0


toInitialStep : Zipper Step -> Zipper Step
toInitialStep zippedSteps =
    let
        currentStep = Zipper.current zippedSteps
    in
        if Step.isSkipable currentStep then
            skipOver Next zippedSteps

        else
            zippedSteps


toPrintable : Style -> Step -> Printable
toPrintable style step =
    case step of

        Step.End ->
            UnstyledEnd

        Step.EnterChar ->
            StyledEnter style

        Step.EmptyLine ->
            UnstyledEmptyLine

        Step.Skip st ->
            Styled st Unstyled

        Step.Typeable ch ->
            Styled (String.fromChar ch) style


windowedPrintables : Int -> Int -> Exercise -> List Printable
windowedPrintables linesBefore linesAfter exercise =
    let
        windowedBefore = takeLastNLines linesBefore exercise.stepsBefore
        windowedAfter = takeFirstNLines linesAfter exercise.stepsAfter
        beforePrintables = List.map (toPrintable Completed) windowedBefore
        currentPrintable =
            [ toPrintable
                  (currentStepStyle exercise.errorCount)
                  exercise.stepsCurrent
            ]
        afterPrintables =
            List.indexedMap (afterPrintable exercise.errorCount) windowedAfter
    in
        beforePrintables ++ currentPrintable ++ afterPrintables


zipperMover : Direction -> Zipper Step -> Zipper Step
zipperMover direction zs =
    case direction of

        Next ->
            Zipper.next zs

        Previous ->
            Zipper.previous zs
