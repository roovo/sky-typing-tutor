module Page.Exercises exposing (Model, Msg(..), init, update, view)

import Database
import List.Extra as LE
import Session
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.Process as Process
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import TuiElements
import Zipper

--
-- MODEL
--
type alias Model =
    { exercises : Status (Maybe (Zipper ExerciseDb))
    , notice : Maybe Notice
    , selectedExerciseStatus : SelectedExerciseStatus
    , session : Session
    }

type Notice
    = Success String
    | Failure String

type Status a
    = Loading
    | Loaded a
    | LoadFailed String
    | OpenFailed String a

type SelectedExerciseStatus
    = Dormant
    | IsAdding String
    | IsDeleting
    | NewExerciseFailed String String

type alias ExerciseDb =
    { fullPath : String
    , characterCount : Int
    , language : String
    , lastAccuracy : Float
    , lastWpm : Float
    , lastAttempted : String
    }


init : (Msg -> parentMsg) -> Session -> ( Model, Cmd parentMsg )
init toMsg session =
    ( { exercises = loadExercises ()
      , selectedExerciseStatus = Dormant
      , session = session
      , notice = Nothing
      }
    , Cmd.none
    )


loadExercises : () -> Status (Maybe (Zipper ExerciseDb))
loadExercises () =
    let
        result =
            Task.run
                (Db.query
                    Database.db
                    "SELECT full_path, character_count, language, accuracy AS last_accuracy, wpm AS last_wpm, datetime(MAX(completed_at), 'localtime') AS last_attempted FROM attempts GROUP BY full_path ORDER BY last_attempted DESC"
                    [])
    in
        case result of

            Ok rows ->
                Loaded (List.map rowToExercise rows |> Zipper.fromList)

            Err e ->
                LoadFailed (Error.toString e)


fetchExercises : (Msg -> parentMsg) -> Session -> Cmd parentMsg
fetchExercises toMsg session =
    Cmd.none


rowToExercise row =
    { fullPath = Db.getString "full_path" row
    , characterCount = Db.getInt "character_count" row
    , language = Db.getString "language" row
    , lastAccuracy = Db.getFloat "last_accuracy" row
    , lastWpm = Db.getFloat "last_wpm" row
    , lastAttempted = Db.getString "last_attempted" row
    }

--
-- UPDATE
--
type Msg
    = DeleteCompleted (Result Error Int)
    | FetchCompleted (Result Error (List ExerciseDb))
    | KeyTyped KeyEvent
    | Quit
    | StartExercise String String


update : (Msg -> parentMsg) -> Msg -> Model -> ( Model, Cmd parentMsg )
update toMsg msg model =
    case msg of

        DeleteCompleted (Ok nRowsDeleted) ->
            ( { model | exercises = loadExercises ()
              , selectedExerciseStatus = Dormant
              , notice = Just (Success "Exercise deleted successfully.")
              }
            , Cmd.none
            )

        DeleteCompleted (Err e) ->
            ( { model | selectedExerciseStatus = Dormant
              , notice = Just (Failure ("Delete failed: " ++ Error.toString e))
              }
            , Cmd.none
            )

        FetchCompleted (Ok exercises) ->
            ( { model | exercises = Loaded (Zipper.fromList exercises) }
            , Cmd.none
            )

        FetchCompleted (Err e) ->
            ( { model | exercises = LoadFailed (Error.toString e) }, Cmd.none )

        KeyTyped keyEvent ->
            let
                clearedModel = { model | notice = Nothing }
            in
                case clearedModel.selectedExerciseStatus of

                    Dormant ->
                        handleListingKeypresses toMsg keyEvent clearedModel

                    IsAdding _ ->
                        handleNewExerciseKeypresses toMsg keyEvent clearedModel

                    IsDeleting ->
                        handleDeleteExerciseKeypresses
                            toMsg
                            keyEvent
                            clearedModel

                    NewExerciseFailed _ _ ->
                        handleNewExerciseKeypresses toMsg keyEvent clearedModel

        Quit ->
            ( model, Cmd.perform (Task.succeed ()) (\_ -> toMsg Quit) )

        StartExercise _ _ ->
            ( model, Cmd.none )


handleListingKeypresses : (Msg -> parentMsg) -> KeyEvent -> Model -> ( Model, Cmd parentMsg )
handleListingKeypresses toMsg keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "d" then
        ( { model | selectedExerciseStatus = IsDeleting }, Cmd.none )

    else if (keyEvent.kind == "char" && keyEvent.value == "h") || keyEvent.kind
        == "left" then
        ( { model | exercises = moveZipper Zipper.first model.exercises }
        , Cmd.none
        )

    else if (keyEvent.kind == "char" && keyEvent.value == "j") || keyEvent.kind
        == "down" then
        ( { model | exercises = moveZipper Zipper.next model.exercises }
        , Cmd.none
        )

    else if (keyEvent.kind == "char" && keyEvent.value == "k") || keyEvent.kind == "up" then
        ( { model | exercises = moveZipper Zipper.previous model.exercises }
        , Cmd.none
        )

    else if (keyEvent.kind == "char" && keyEvent.value == "l") || keyEvent.kind
        == "right" then
        ( { model | exercises = moveZipper Zipper.last model.exercises }
        , Cmd.none
        )

    else if keyEvent.kind == "char" && keyEvent.value == "n" then
        ( { model | selectedExerciseStatus = IsAdding "" }, Cmd.none )

    else if keyEvent.kind == "char" && keyEvent.value == "q" then
        update toMsg Quit model

    else if keyEvent.kind == "enter" then
        handleOpenExercise toMsg model

    else
        ( model, Cmd.none )


-- WORKAROUND: Nested pattern match on user-defined ADT wrapping Maybe causes
-- codegen error (see bug-report-nested-pattern.md). When fixed, rewrite as:
--     case model.exercises of
--         Loaded (Just exercises) -> ...
--         Loaded Nothing -> ...
--         _ -> ...
handleOpenExercise : (Msg -> parentMsg) -> Model -> ( Model, Cmd parentMsg )
handleOpenExercise toMsg model =
    case model.exercises of

        Loaded maybeExercises ->
            case maybeExercises of

                Just exercises ->
                    let
                        path = (Zipper.current exercises).fullPath
                    in
                        case readExerciseFile path of

                            Ok ( fullPath, content ) ->
                                ( model
                                , Cmd.perform
                                      (Task.succeed ())
                                      (\_ ->
                                          toMsg (StartExercise fullPath content))
                                )

                            Err e ->
                                ( { model | exercises = OpenFailed e maybeExercises
                                  }
                                , Cmd.none
                                )

                Nothing ->
                    ( model, Cmd.none )

        _ ->
            ( model, Cmd.none )


readExerciseFile : String -> Result String ( String, String )
readExerciseFile path =
    case Task.run (File.readFile path) of

        Ok content ->
            let
                fullPath =
                    Task.run (Process.run "realpath" [ path ])
                        |> Result.withDefault path
                        |> String.trim
            in
                Ok ( fullPath, content )

        Err e ->
            Err (Error.toString e)


-- WORKAROUND: Nested pattern match on user-defined ADT wrapping Maybe
-- (see bug-report-nested-pattern.md).
moveZipper : (Zipper ExerciseDb -> Zipper ExerciseDb) -> Status (Maybe (Zipper ExerciseDb)) -> Status (Maybe (Zipper ExerciseDb))
moveZipper fn status =
    case status of

        Loaded maybeZipper ->
            case maybeZipper of

                Just zipper ->
                    Loaded (Just (fn zipper))

                Nothing ->
                    status

        OpenFailed _ maybeZipper ->
            case maybeZipper of

                Just zipper ->
                    Loaded (Just (fn zipper))

                Nothing ->
                    status

        _ ->
            status


-- WORKAROUND: Nested pattern match on user-defined ADT wrapping Maybe
-- (see bug-report-nested-pattern.md).
handleDeleteExerciseKeypresses : (Msg -> parentMsg) -> KeyEvent -> Model -> ( Model, Cmd parentMsg )
handleDeleteExerciseKeypresses toMsg keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "y" then
        case model.exercises of

            Loaded maybeExercises ->
                case maybeExercises of

                    Just exercises ->
                        let
                            path = (Zipper.current exercises).fullPath
                            deleteTask =
                                Db.exec
                                    Database.db
                                    "DELETE FROM attempts WHERE full_path = ?"
                                    [ path ]
                        in
                            ( model
                            , Cmd.perform
                                  deleteTask
                                  (\result -> toMsg (DeleteCompleted result))
                            )

                    Nothing ->
                        ( model, Cmd.none )

            _ ->
                ( model, Cmd.none )

    else
        ( { model | selectedExerciseStatus = Dormant }, Cmd.none )


handleNewExerciseKeypresses : (Msg -> parentMsg) -> KeyEvent -> Model -> ( Model, Cmd parentMsg )
handleNewExerciseKeypresses toMsg keyEvent model =
    let
        currentPath =
            case model.selectedExerciseStatus of

                IsAdding path ->
                    path

                NewExerciseFailed _ path ->
                    path

                _ ->
                    ""
    in
        if keyEvent.kind == "char" || keyEvent.kind == "paste" then
            ( { model | selectedExerciseStatus =
                  IsAdding (currentPath ++ keyEvent.value)
              }
            , Cmd.none
            )

        else if keyEvent.kind == "space" then
            ( { model | selectedExerciseStatus = IsAdding (currentPath ++ " ") }
            , Cmd.none
            )

        else if keyEvent.kind == "backspace" then
            ( { model | selectedExerciseStatus =
                  IsAdding (String.dropRight 1 currentPath)
              }
            , Cmd.none
            )

        else if keyEvent.kind == "escape" then
            ( { model | selectedExerciseStatus = Dormant }, Cmd.none )

        else if keyEvent.kind == "enter" then
            case readExerciseFile currentPath of

                Ok ( fullPath, content ) ->
                    ( { model | selectedExerciseStatus = Dormant }
                    , Cmd.perform
                          (Task.succeed ())
                          (\_ -> toMsg (StartExercise fullPath content))
                    )

                Err e ->
                    ( { model | selectedExerciseStatus = NewExerciseFailed e currentPath
                      }
                    , Cmd.none
                    )

        else
            ( model, Cmd.none )


--
-- VIEW
--
headerFooterPaddingLines : Int
headerFooterPaddingLines =
    22


view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        (case ( model.exercises, model.selectedExerciseStatus ) of

            ( LoadFailed exerciseError, _ ) ->
                [ viewHeading, viewLoadFailed exerciseError ]

            ( Loading, _ ) ->
                [ viewHeading, Ui.text "Exercises loading" ]

            ( OpenFailed exerciseError zippedExercises, _ ) ->
                [ viewHeading
                , viewOpenFailed model.session exerciseError zippedExercises
                ]

            ( Loaded zippedExercises, Dormant ) ->
                [ viewHeading
                , viewNotice model.notice
                , viewExerciseTable model.session zippedExercises
                , viewHints
                ]

            ( Loaded _, IsAdding path ) ->
                [ viewHeading, viewAddExercise path "" ]

            ( Loaded zippedExercises, IsDeleting ) ->
                [ viewHeading, viewDeleteExercise zippedExercises ]

            ( Loaded _, NewExerciseFailed err path ) ->
                [ viewHeading, viewAddExercise path err ])


viewHeading : Element msg
viewHeading =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el [] (Ui.text "Exercises"))


viewNotice : Maybe Notice -> Element msg
viewNotice maybeNotice =
    case maybeNotice of

        Just (Success msg) ->
            Ui.el [ Font.color (Ui.rgb 80 200 120) ] (Ui.text msg)

        Just (Failure msg) ->
            Ui.el [ Font.color (Ui.rgb 220 50 50) ] (Ui.text msg)

        Nothing ->
            Ui.none


viewLoadFailed : String -> Element msg
viewLoadFailed exerciseError =
    Ui.el
        [ Font.color (Ui.rgb 180 50 50) ]
        (Ui.text ("Error: " ++ exerciseError))


viewOpenFailed : Session -> String -> Maybe (Zipper ExerciseDb) -> Element msg
viewOpenFailed session exerciseError zippedExercises =
    Ui.column
        []
        [ viewExerciseTable session zippedExercises
        , Ui.el
              [ Font.color (Ui.rgb 180 50 50) ]
              (Ui.text ("Error: " ++ exerciseError))
        ]


viewExerciseTable : Session -> Maybe (Zipper ExerciseDb) -> Element msg
viewExerciseTable session zippedExercises =
    case zippedExercises of

        Nothing ->
            Ui.text "No exercises found."

        Just exercises ->
            let
                allExercises = Zipper.toList exercises
                widths = columnWidths allExercises
                currentRow = Zipper.before exercises |> List.length
                windowLineCount =
                    (Session.terminalLineHeight session)
                        - headerFooterPaddingLines
                windowNumbers =
                    TuiElements.windowedZipper
                        windowLineCount
                        currentRow
                        (List.length allExercises)
                windowedExercises =
                    LE.applyWindow
                        windowNumbers.beforeCurrentLineCount
                        currentRow
                        windowNumbers.afterCurrentLineCount
                        allExercises
            in
                Ui.column
                    [ Ui.spacing 0 ]
                    ((List.indexedMap
                        (viewExerciseRow
                            widths
                            windowNumbers.beforeCurrentLineCount)
                        windowedExercises)
                        ++ viewBlankRows windowNumbers.blankLineCount)

type alias ColumnWidths =
    { filename : Int
    , language : Int
    , chars : Int
    , lastAccuracy : Int
    , lastWpm : Int
    }


columnWidths : List ExerciseDb -> ColumnWidths
columnWidths exercises =
    { filename = maxLength (List.map exerciseFilename exercises)
    , language = maxLength (List.map .language exercises)
    , chars = maxLength (List.map charsLabel exercises)
    , lastAccuracy = maxLength (List.map accuracyLabel exercises)
    , lastWpm = maxLength (List.map wpmLabel exercises)
    }


maxLength : List String -> Int
maxLength strings =
    List.foldl (\s acc -> Math.max (String.length s) acc) 0 strings


exerciseFilename : ExerciseDb -> String
exerciseFilename exercise =
    String.split "/" exercise.fullPath |> List.reverse |> List.head
        |> Maybe.withDefault exercise.fullPath


charsLabel : ExerciseDb -> String
charsLabel exercise =
    String.fromInt exercise.characterCount ++ " chars"


accuracyLabel : ExerciseDb -> String
accuracyLabel exercise =
    (formatFloat2dp exercise.lastAccuracy) ++ "%"


wpmLabel : ExerciseDb -> String
wpmLabel exercise =
    (formatFloat2dp exercise.lastWpm) ++ " WPM"


formatFloat2dp : Float -> String
formatFloat2dp f =
    let
        rounded = Math.round (f * 100.0)
        whole = rounded // 100
        frac = Math.abs (rounded - whole * 100)
        fracStr =
            if frac < 10 then
                "0" ++ String.fromInt frac

            else
                String.fromInt frac
    in
        String.fromInt whole ++ "." ++ fracStr


columnGap : Int
columnGap =
    3


viewBlankRows : Int -> List (Element msg)
viewBlankRows count =
    LE.repeat count (Ui.row [] [ Ui.text "" ])


viewExerciseRow : ColumnWidths -> Int -> Int -> ExerciseDb -> Element msg
viewExerciseRow widths currentRow index exercise =
    let
        filename = exerciseFilename exercise
        cursor =
            if currentRow == index then
                "▶ "

            else
                "  "
    in
        Ui.row
            [ Ui.spacing 0 ]
            [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text cursor)
            , Ui.text
                  (String.padRight (widths.filename + columnGap) ' ' filename)
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text
                      (String.padRight
                          (widths.language + columnGap)
                          ' '
                          exercise.language))
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text
                      ((charsLabel exercise) |> String.padLeft (widths.chars) ' '
                          |> String.padRight (widths.chars + columnGap) ' '))
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text
                      (String.padRight
                          (widths.lastAccuracy + columnGap)
                          ' '
                          (accuracyLabel exercise)))
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text
                      (String.padRight
                          (widths.lastWpm + columnGap)
                          ' '
                          (wpmLabel exercise)))
            , Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text <| String.dropRight 3 exercise.lastAttempted)
            ]


viewHints : Element msg
viewHints =
    Ui.column
        [ Font.color (Ui.rgb 120 120 140), Ui.spacing 0 ]
        [ Ui.text "  h/←   - top"
        , Ui.text "  j/↓   - down"
        , Ui.text "  k/↑   - up"
        , Ui.text "  l/→   - bottom"
        , Ui.text "  enter - start exercise"
        , Ui.text "  n     - new exercise (from file)"
        , Ui.text "  d     - delete exercise"
        , Ui.text "  q     - quit"
        ]


viewAddExercise : String -> String -> Element msg
viewAddExercise input error =
    Ui.column
        [ Ui.spacing 8 ]
        [ Ui.text "New exercise (from file)"
        , Ui.row
              []
              [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "Path: ")
              , Ui.text input
              , Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "▌")
              ]
        , if error == "" then
              Ui.el
                  [ Font.color (Ui.rgb 120 120 140) ]
                  (Ui.text "  Enter to confirm · Escape to cancel")

          else
              Ui.el
                  [ Font.color (Ui.rgb 180 50 50) ]
                  (Ui.text ("  Error: " ++ error))
        ]


viewDeleteExercise : Maybe (Zipper ExerciseDb) -> Element msg
viewDeleteExercise zippedExercises =
    case zippedExercises of

        Nothing ->
            Ui.text "No exercises found."

        Just exercises ->
            let
                selectedExercise = Zipper.current exercises
            in
                Ui.column
                    [ Ui.spacing 8 ]
                    [ Ui.text "Deleting exercise:"
                    , Ui.column
                          [ Ui.spacing 0 ]
                          [ Ui.row
                                []
                                [ Ui.el [] (Ui.text "    Name: ")
                                , Ui.el
                                      [ Font.color (Ui.rgb 142 200 168) ]
                                      (Ui.text
                                          (exerciseFilename selectedExercise))
                                ]
                          , Ui.row
                                []
                                [ Ui.el [] (Ui.text "    Path: ")
                                , Ui.el
                                      [ Font.color (Ui.rgb 142 200 168) ]
                                      (Ui.text (selectedExercise.fullPath))
                                ]
                          , Ui.row
                                []
                                [ Ui.el [] (Ui.text "Language: ")
                                , Ui.el
                                      [ Font.color (Ui.rgb 142 200 168) ]
                                      (Ui.text (selectedExercise.language))
                                ]
                          ]
                    , Ui.text
                          "Deleting this will remove all this exercise's results."
                    , Ui.el
                          [ Font.color (Ui.rgb 120 120 140) ]
                          (Ui.text "  'y' to confirm · any other key to cancel")
                    ]
