module Page.Exercises exposing (Model, Msg(..), init, update, view)

import Database
import Sky.Core.Error as Error exposing (Error)
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font

--
-- MODEL
--
type alias Model =
    { -- COMPILER BUG WORKAROUND (Issue 5): exercises/exerciseError should be a
      -- single Status ADT field (Loading | Loaded (List ExerciseDb) | Failed String)
      -- but parameterised ADTs in model fields are corrupted by the Tui runtime's
      -- serialisation round-trip when populated from a DB query.
      newExercisePath : String
    , exerciseError : String
    , exercises : List ExerciseDb
    , isAdding : Bool
    , session : Session
    }

type alias ExerciseDb =
    { id : Int
    , name : String
    , language : String
    , characterCount : Int
    }


init : (Msg -> parentMsg) -> Session -> ( Model, Cmd parentMsg )
init toMsg session =
    let
        result =
            Task.run
                (Db.query
                    Database.db
                    "SELECT id, name, language, character_count FROM exercises ORDER BY name"
                    [])

        exercises =
            case result of
                Ok rows ->
                    List.map rowToExercise rows

                Err _ ->
                    []

        exerciseError =
            case result of
                Ok _ ->
                    ""

                Err e ->
                    Error.toString e
    in
        ( { newExercisePath = ""
          , exerciseError = exerciseError
          , exercises = exercises
          , isAdding = False
          , session = session
          }
        , Cmd.none
        )


fetchExercises : (Msg -> parentMsg) -> Session -> Cmd parentMsg
fetchExercises toMsg session =
    Cmd.none


rowToExercise row =
    { id = Db.getInt "id" row
    , name = Db.getString "name" row
    , language = Db.getString "language" row
    , characterCount = Db.getInt "character_count" row
    }

--
-- UPDATE
--
type Msg
    = CompletedExercisesFetch (Result Error (List ExerciseDb))
    | KeyTyped KeyEvent


update : (Msg -> parentMsg) -> Msg -> Model -> ( Model, Cmd parentMsg )
update toMsg msg model =
    case msg of

        CompletedExercisesFetch (Ok exercises) ->
            ( { model | exercises = exercises }, Cmd.none )

        CompletedExercisesFetch (Err e) ->
            ( { model | exerciseError = Error.toString e }, Cmd.none )

        KeyTyped keyEvent ->
            if model.isAdding then
                handleNewExerciseKeypresses keyEvent model
            else
                handleListingKeypresses keyEvent model


handleListingKeypresses : KeyEvent -> Model -> ( Model, Cmd msg )
handleListingKeypresses keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "a" then
        ( { model | isAdding = True, newExercisePath = "" }, Cmd.none )
    else
        ( model, Cmd.none )


handleNewExerciseKeypresses : KeyEvent -> Model -> ( Model, Cmd msg )
handleNewExerciseKeypresses keyEvent model =
    if keyEvent.kind == "char" then
        -- COMPILER BUG WORKAROUND (Issue 5): isAdding = True must be explicitly
        -- included even though it's already True on the model. Without it, the Tui
        -- runtime resets it to False after the serialisation round-trip.
        ( { model | isAdding = True, newExercisePath = model.newExercisePath ++ keyEvent.value }, Cmd.none )
    else
      ( model, Cmd.none )

--
-- VIEW
--
view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        (if model.isAdding then
            [ viewHeading, viewAddExercise model.newExercisePath ]

         else
            [ viewHeading, viewContent model, viewHints ])


viewHeading : Element msg
viewHeading =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el [] (Ui.text "Exercises"))


viewContent : Model -> Element msg
viewContent model =
    if model.exerciseError /= "" then
        Ui.el [ Font.color (Ui.rgb 180 50 50) ] (Ui.text ("Error: " ++ model.exerciseError))

    else if List.isEmpty model.exercises then
        Ui.text "No exercises found. Run an exercise first to add one."

    else
        Ui.column
            [ Ui.spacing 4 ]
            (List.map viewExerciseRow model.exercises)


viewExerciseRow : ExerciseDb -> Element msg
viewExerciseRow exercise =
    Ui.row
        [ Ui.spacing 16 ]
        [ Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text (String.padRight 12 ' ' exercise.language))
        , Ui.text exercise.name
        , Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text
                  ("(" ++ String.fromInt exercise.characterCount ++ " chars)"))
        ]


viewHints : Element msg
viewHints =
    Ui.el
        [ Font.color (Ui.rgb 120 120 140) ]
        (Ui.text "  a - add exercise from file")


viewAddExercise : String -> Element msg
viewAddExercise input =
    Ui.column
        [ Ui.spacing 8 ]
        [ Ui.text "Add exercise from file"
        , Ui.row
              []
              [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "Path: ")
              , Ui.text input
              , Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "▌")
              ]
        , Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text "  Enter to confirm · Escape to cancel")
        ]
