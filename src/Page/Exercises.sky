module Page.Exercises exposing (Model, Msg(..), init, update, view)

import Database
import Sky.Core.Error as Error exposing (Error)
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font

--
-- MODEL
--
type alias Model =
    { newExercisePath : String
    , exercises : Status (List ExerciseDb)
    , isAdding : Bool
    , session : Session
    }

type Status a
    = Loading
    | Loaded a
    | Failed String

type alias ExerciseDb =
    { fullPath : String
    , characterCount : Int
    , language : String
    }


init : (Msg -> parentMsg) -> Session -> ( Model, Cmd parentMsg )
init toMsg session =
    let
        result =
            Task.run
                (Db.query
                    Database.db
                    "SELECT id, full_path, character_count, language FROM attempts ORDER BY completed_at"
                    [])
        exercises =
            case result of

                Ok rows ->
                    Loaded (List.map rowToExercise rows)

                Err e ->
                    Failed (Error.toString e)
    in
        ( { newExercisePath = ""
          , exercises = exercises
          , isAdding = False
          , session = session
          }
        , Cmd.none
        )


fetchExercises : (Msg -> parentMsg) -> Session -> Cmd parentMsg
fetchExercises toMsg session =
    Cmd.none


rowToExercise row =
    { fullPath = Db.getString "full_path" row
    , characterCount = Db.getInt "character_count" row
    , language = Db.getString "language" row
    }

--
-- UPDATE
--
type Msg
    = CompletedExercisesFetch (Result Error (List ExerciseDb))
    | KeyTyped KeyEvent


update : (Msg -> parentMsg) -> Msg -> Model -> ( Model, Cmd parentMsg )
update toMsg msg model =
    case msg of

        CompletedExercisesFetch (Ok exercises) ->
            ( { model | exercises = Loaded exercises }, Cmd.none )

        CompletedExercisesFetch (Err e) ->
            ( { model | exercises = Failed (Error.toString e) }, Cmd.none )

        KeyTyped keyEvent ->
            if model.isAdding then
                handleNewExerciseKeypresses keyEvent model

            else
                handleListingKeypresses keyEvent model


handleListingKeypresses : KeyEvent -> Model -> ( Model, Cmd msg )
handleListingKeypresses keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "a" then
        ( { model | isAdding = True, newExercisePath = "" }, Cmd.none )

    else
        ( model, Cmd.none )


handleNewExerciseKeypresses : KeyEvent -> Model -> ( Model, Cmd msg )
handleNewExerciseKeypresses keyEvent model =
    if keyEvent.kind == "char" || keyEvent.kind == "paste" then
        ( { model | newExercisePath = model.newExercisePath ++ keyEvent.value }
        , Cmd.none
        )

    else if keyEvent.kind == "space" then
        ( { model | newExercisePath = model.newExercisePath ++ " " }, Cmd.none )

    else if keyEvent.kind == "backspace" then
        ( { model | newExercisePath = String.dropRight 1 model.newExercisePath }
        , Cmd.none
        )

    else
        ( model, Cmd.none )


--
-- VIEW
--
view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        (if model.isAdding then
            [ viewHeading, viewAddExercise model.newExercisePath ]

        else
            [ viewHeading, viewContent model, viewHints ])


viewHeading : Element msg
viewHeading =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el [] (Ui.text "Exercises"))


viewContent : Model -> Element msg
viewContent model =
    case model.exercises of

        Failed exerciseError ->
            Ui.el
                [ Font.color (Ui.rgb 180 50 50) ]
                (Ui.text ("Error: " ++ exerciseError))

        Loading ->
            Ui.text "Exercises loading"

        Loaded [] ->
            Ui.text "No exercises found. Run an exercise first to add one."

        Loaded exercises ->
            Ui.column [ Ui.spacing 4 ] (List.map viewExerciseRow exercises)


viewExerciseRow : ExerciseDb -> Element msg
viewExerciseRow exercise =
    Ui.row
        [ Ui.spacing 16 ]
        [ Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text (String.padRight 12 ' ' exercise.language))
        , Ui.text exercise.fullPath
        , Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text
                  ("(" ++ String.fromInt exercise.characterCount ++ " chars)"))
        ]


viewHints : Element msg
viewHints =
    Ui.el
        [ Font.color (Ui.rgb 120 120 140) ]
        (Ui.text "  a - add exercise from file")


viewAddExercise : String -> Element msg
viewAddExercise input =
    Ui.column
        [ Ui.spacing 8 ]
        [ Ui.text "Add exercise from file"
        , Ui.row
              []
              [ Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "Path: ")
              , Ui.text input
              , Ui.el [ Font.color (Ui.rgb 142 200 168) ] (Ui.text "▌")
              ]
        , Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text "  Enter to confirm · Escape to cancel")
        ]
