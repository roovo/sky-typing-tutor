module Page.Exercises exposing (ExercisesModel, Msg(..), Status(..), init, update, view)

import Database
import Sky.Core.Error as Error exposing (Error)
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font

--
-- MODEL
--
type alias ExercisesModel =
    { exercises : Status
    , session : Session
    }

type alias Exercise =
    { id : Int
    , name : String
    , language : String
    , characterCount : Int
    }

type Status
    = Loading
    | Loaded (List Exercise)
    | Failed String


init : (Msg -> parentMsg) -> Session -> ( ExercisesModel, Cmd parentMsg )
init toMsg session =
    let
        exercises =
            case Task.run
                     (Db.query
                         Database.db
                         "SELECT id, name, language, character_count FROM exercises ORDER BY name"
                         []) of

                Ok rows ->
                    Loaded (List.map rowToExercise rows)

                Err e ->
                    Failed (Error.toString e)
    in
        ( { exercises = exercises, session = session }, Cmd.none )


fetchExercises : (Msg -> parentMsg) -> Session -> Cmd parentMsg
fetchExercises toMsg session =
    Cmd.none


rowToExercise row =
    { id = Db.getInt "id" row
    , name = Db.getString "name" row
    , language = Db.getString "language" row
    , characterCount = Db.getInt "character_count" row
    }

--
-- UPDATE
--
type Msg
    = CompletedExercisesFetch (Result Error (List Exercise))


-- COMPLIER BUG MEANS I CANNOT ANNOTATE THIS
update toMsg msg model =
    case msg of

        CompletedExercisesFetch (Ok exercises) ->
            ( { model | exercises = Loaded exercises }, Cmd.none )

        CompletedExercisesFetch (Err e) ->
            ( { model | exercises = Failed (Error.toString e) }, Cmd.none )


--
-- VIEW
--
-- COMPLIER BUG MEANS I CANNOT ANNOTATE THIS
view toMsg exercises =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ viewHeading
        , case exercises of

              Loading ->
                  Ui.text "Loading exercises..."

              Failed err ->
                  Ui.text ("Error: " ++ err)

              Loaded exerciseList ->
                  if List.isEmpty exerciseList then
                      Ui.text "No exercises found."

                  else
                      Ui.text
                          ("Found " ++ String.fromInt (List.length exerciseList)
                              ++ " exercises")
        ]


viewHeading =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el [] (Ui.text "Exercises"))


viewContent exercises =
    case exercises of

        Loading ->
            Ui.text "Loading exercises..."

        Failed err ->
            Ui.el [ Font.color (Ui.rgb 180 50 50) ] (Ui.text ("Error: " ++ err))

        Loaded exerciseList ->
            if List.isEmpty exerciseList then
                Ui.text "No exercises found. Run an exercise first to add one."

            else
                Ui.column
                    [ Ui.spacing 4 ]
                    (List.map viewExerciseRow exerciseList)


viewExerciseRow exercise =
    Ui.row
        [ Ui.spacing 16 ]
        [ Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text (String.padRight 12 ' ' exercise.language))
        , Ui.text exercise.name
        , Ui.el
              [ Font.color (Ui.rgb 120 120 140) ]
              (Ui.text
                  ("(" ++ String.fromInt exercise.characterCount ++ " chars)"))
        ]
