module Page.Exercise exposing (Model, Msg(..), init, view, update)

import Exercise exposing (Exercise, Style(..))
import Sky.Core.Prelude exposing (..)
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font

--
-- MODEL
--
type alias Model =
    { exercise : Exercise }


init : String -> String -> Model
init filename exerciseText =
    { exercise = Exercise.init filename exerciseText }

--
-- UPDATE
--
type alias KeyEvent =
    { kind : String
    , value : String
    }

type Msg
    = KeyTyped KeyEvent


update : Msg -> Model -> Model
update msg model =
    case msg of

        KeyTyped keyEvent ->
            consumeKeyEvent keyEvent model


consumeKeyEvent : KeyEvent -> Model -> Model
consumeKeyEvent keyEvent model =
    let
        -- charToConsume : Maybe Char
        charToConsume =
            if keyEvent.kind == "char" then
                keyEvent.value |> String.toList |> List.head

            else if keyEvent.kind == "enter" then
                Just (Char.fromCode 13)

            else if keyEvent.kind == "backspace" then
                Just (Char.fromCode 8)

            else if keyEvent.kind == "space" then
                Just (Char.fromCode 32)

            else
                Nothing
        newExercise =
            case charToConsume of

                Just ch ->
                    Exercise.consume ch model.exercise

                Nothing ->
                    model.exercise
    in
        { model | exercise = newExercise }


--
-- VIEW
--
view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ viewHeading model, viewBody model ]


viewHeading : Model -> Element msg
viewHeading model =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el [] (Ui.text <| Exercise.title model.exercise))


viewBody : Model -> Element msg
viewBody model =
    let
        allLines = Exercise.printableLines model.exercise
        currentLineIndex = Exercise.currentLineIndex model.exercise
        visibleLineCount = 20
        scrollOffset = Math.max 0 (currentLineIndex - visibleLineCount // 3)
        windowedLines =
            allLines |> List.drop scrollOffset |> List.take visibleLineCount
    in
        Ui.column [ Ui.spacing 0 ] (List.map viewLine windowedLines)


viewLine : List Exercise.Printable -> Element msg
viewLine printables =
    Ui.row [] (List.map viewPrintable printables)


viewPrintable : Exercise.Printable -> Element msg
viewPrintable printable =
    case printable of

        Exercise.Styled ch style ->
            Ui.el (styleAttrs style) (Ui.text ch)

        Exercise.StyledEnter style ->
            if style == Exercise.Current then
                Ui.el (styleAttrs style) (Ui.text "↵")

            else
                Ui.el (styleAttrs style) (Ui.text " ")

        Exercise.UnstyledEmptyLine ->
            Ui.text ""

        Exercise.UnstyledEnd ->
            Ui.text ""


styleAttrs : Exercise.Style -> List (Ui.Attribute msg)
styleAttrs style =
    case style of

        Exercise.Current ->
            [ Background.color (Ui.rgb 80 80 120)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Exercise.Completed ->
            [ Font.color (Ui.rgb 100 180 100) ]

        Exercise.Error ->
            [ Background.color (Ui.rgb 180 50 50)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Exercise.Waiting ->
            [ Font.color (Ui.rgb 120 120 140) ]

        Exercise.Unstyled ->
            []
