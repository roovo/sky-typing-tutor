module Page.Exercise exposing (Model, Msg(..), init, view, update)

import Analysis
import Database
import Exercise exposing (Exercise, Style(..))
import KeyEvent exposing (KeyEvent)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task
import Session
import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font

--
-- MODEL
--
type alias Model =
    { elapsedTime : Int
    , exercise : Exercise
    , saveStatus : String
    , session : Session
    }


init : Session -> String -> String -> Model
init session filename exerciseText =
    { elapsedTime = 0
    , exercise = Exercise.init filename exerciseText
    , saveStatus = ""
    , session = session
    }

--
-- UPDATE
--
type Msg
    = KeyTyped KeyEvent
    | Quit
    | Restart
    | SaveComplete (Result Error Int)
    | SaveResults
    | ShowExercises
    | Tick


update : (Msg -> parentMsg) -> Msg -> Model -> ( Model, Cmd parentMsg )
update toMsg msg model =
    case msg of

        Quit ->
            ( model
            , Cmd.perform
                  (Task.succeed ())
                  (\_ -> toMsg Quit)
            )

        KeyTyped keyEvent ->
            if Exercise.isComplete model.exercise then
                handleCompletedKey toMsg keyEvent model

            else
                ( consumeKeyEvent keyEvent model, Cmd.none )

        Restart ->
            ( init
                  model.session
                  (Exercise.fullPath model.exercise)
                  model.exercise.text
            , Cmd.none
            )

        SaveComplete result ->
            let
                status =
                    case result of

                        Ok _ ->
                            "✓ Saved"

                        Err e ->
                            "✗ Save failed: " ++ Error.toString e
            in
                ( { model | saveStatus = status }, Cmd.none )

        SaveResults ->
            ( model
            , Cmd.perform
                  (saveResult model.exercise)
                  (\r -> toMsg (SaveComplete r))
            )

        ShowExercises ->
            ( model
            , Cmd.perform
                  (Task.succeed ())
                  (\_ -> toMsg ShowExercises)
            )

        Tick ->
            if List.isEmpty model.exercise.events then
                ( model, Cmd.none )

            else
                ( { model | elapsedTime = model.elapsedTime + 10 }, Cmd.none )


consumeKeyEvent : KeyEvent -> Model -> Model
consumeKeyEvent keyEvent model =
    let
        -- charToConsume : Maybe Char
        charToConsume =
            if keyEvent.kind == "char" then
                keyEvent.value |> String.toList |> List.head

            else if keyEvent.kind == "enter" then
                Just (Char.fromCode 13)

            else if keyEvent.kind == "backspace" then
                Just (Char.fromCode 8)

            else if keyEvent.kind == "space" then
                Just (Char.fromCode 32)

            else
                Nothing
        newExercise =
            case charToConsume of

                Just ch ->
                    Exercise.consume ch model.elapsedTime model.exercise

                Nothing ->
                    model.exercise
    in
        { model | exercise = newExercise, elapsedTime = 0 }


saveResult : Exercise -> Task Error Int
saveResult exercise =
    Db.exec
        Database.db
        "INSERT INTO attempts (full_path, language, accuracy, wpm, character_count, events, completed_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'))"
        [ Exercise.fullPath exercise
        , Exercise.language exercise
        , String.fromFloat (Exercise.accuracy exercise)
        , String.fromFloat (Exercise.wpm exercise)
        , String.fromInt (Exercise.typeableCharacterCount exercise)
        , "[]"
        ]


handleCompletedKey : (Msg -> parentMsg) -> keyEvent -> Model -> ( Model, Cmd parentMsg )
handleCompletedKey toMsg keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "r" then
        update toMsg Restart model

    else if keyEvent.kind == "char" && keyEvent.value == "s" then
        update toMsg SaveResults model

    else if keyEvent.kind == "char" && keyEvent.value == "b" then
        update toMsg ShowExercises model

    else if keyEvent.kind == "char" && keyEvent.value == "q" then
        update toMsg Quit model

    else
        ( model, Cmd.none )


--
-- CONSTANTS
--
headerFooterPaddingLines : Int
headerFooterPaddingLines =
    16


--
-- VIEW
--
view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ viewHeading model, viewBody model, viewFooter model ]


viewHeading : Model -> Element msg
viewHeading model =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el
            []
            (Ui.text <| Exercise.fullPath model.exercise ++ " ("
                ++ Exercise.language model.exercise
                ++ ")"))


viewFooter : Model -> Element msg
viewFooter model =
    Ui.el
        [ Ui.width Ui.fill
        , Ui.padding 1
        , Font.color (Ui.rgb 142 200 168)
        , Border.width 1
        , Border.color (Ui.rgb 142 200 168)
        , Border.rounded 4
        ]
        (Ui.el
            []
            (Ui.text <| "Accuracy: "
                ++ formatFloat2dp (Exercise.accuracy model.exercise)
                ++ "%    wpm: "
                ++ formatFloat2dp (Exercise.wpm model.exercise)))


formatFloat2dp : Float -> String
formatFloat2dp f =
    let
        rounded = Math.round (f * 100.0)
        whole = rounded // 100
        frac = Math.abs (rounded - whole * 100)
        fracStr =
            if frac < 10 then
                "0" ++ String.fromInt frac

            else
                String.fromInt frac
    in
        String.fromInt whole ++ "." ++ fracStr


viewBody : Model -> Element msg
viewBody model =
    if Exercise.isComplete model.exercise then
        viewExerciseCompleted model

    else
        viewExercise model


viewExercise : Model -> Element msg
viewExercise model =
    let
        visibleLineCount =
            (Session.terminalLineHeight model.session)
                - headerFooterPaddingLines
        linesBefore = visibleLineCount // 3
        linesAfter = visibleLineCount - linesBefore - 1
        lines =
            Exercise.printableLines linesBefore linesAfter model.exercise
    in
        Ui.column [ Ui.spacing 0 ] (List.map viewLine lines)


viewExerciseCompleted : Model -> Element msg
viewExerciseCompleted model =
    Ui.column
        [ Ui.spacing 8 ]
        [ Ui.column
              [ Ui.spacing 4
              , Ui.padding 16
              , Border.width 1
              , Border.color (Ui.rgb 142 200 168)
              , Border.rounded 4
              ]
              [ Ui.el
                    [ Font.bold, Font.color (Ui.rgb 142 200 168) ]
                    (Ui.text "Exercise Completed!")
              , Ui.column
                    [ Ui.spacing 0 ]
                    [ Ui.text
                          ("Title:           "
                              ++ Exercise.fullPath model.exercise)
                    , Ui.text
                          ("Language:        "
                              ++ Exercise.language model.exercise)
                    , Ui.text
                          ("Character Count: "
                              ++ (String.fromInt
                                     <| Exercise.typeableCharacterCount
                                            model.exercise))
                    , Ui.text
                          ("Accuracy:        "
                              ++ formatFloat2dp
                                     (Exercise.accuracy model.exercise)
                              ++ "%")
                    , Ui.text
                          ("WPM:             "
                              ++ formatFloat2dp (Exercise.wpm model.exercise))
                    , Ui.text ""
                    , Ui.text
                          (Analysis.overallAssessment
                              (toFloat <| Session.wpmTarget model.session)
                              model.exercise)
                    ]
              ]
        , Ui.column
              [ Ui.spacing 0 ]
              [ Ui.text "  r - re-run this exercise"
              , Ui.text ("  s - save results  " ++ model.saveStatus)
              , Ui.text "  b - back to exersies list"
              , Ui.text "  q - quit"
              ]
        ]


hr =
    Ui.el
        [ Ui.width Ui.fill, Font.color (Ui.rgb 142 200 168) ]
        (Ui.text (String.repeat 300 "─"))


viewLine : List Exercise.Printable -> Element msg
viewLine printables =
    Ui.row [] (List.map viewPrintable printables)


viewPrintable : Exercise.Printable -> Element msg
viewPrintable printable =
    case printable of

        Exercise.Styled ch style ->
            Ui.el (styleAttrs style) (Ui.text ch)

        Exercise.StyledEnter style ->
            if style == Exercise.Current then
                Ui.el (styleAttrs style) (Ui.text "↵")

            else
                Ui.el (styleAttrs style) (Ui.text " ")

        Exercise.UnstyledEmptyLine ->
            Ui.text ""

        Exercise.UnstyledEnd ->
            Ui.text ""


styleAttrs : Exercise.Style -> List (Ui.Attribute msg)
styleAttrs style =
    case style of

        Exercise.Current ->
            [ Background.color (Ui.rgb 80 80 120)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Exercise.Completed ->
            [ Font.color (Ui.rgb 100 180 100) ]

        Exercise.Errored ->
            [ Background.color (Ui.rgb 180 50 50)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Exercise.Waiting ->
            [ Font.color (Ui.rgb 120 120 140) ]

        Exercise.Unstyled ->
            []


--
-- PRIVATE
--
toFloat : Int -> Float
toFloat n =
    String.fromInt n |> String.toFloat |> Maybe.withDefault 0.0
