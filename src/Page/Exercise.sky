module Page.Exercise exposing (Model, Msg(..), init, view, update)

import Analysis
import Database
import Exercise exposing (Exercise, Style(..))
import Float.Extra as FE
import KeyEvent exposing (KeyEvent)
import List.Extra as LE
import Printable exposing (Printable)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Task as Task
import Session
import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Ui as Ui
import Std.Ui exposing (Element)
import Std.Ui.Background as Background
import Std.Ui.Border as Border
import Std.Ui.Font as Font
import TuiElements


init : Session -> String -> String -> Model
init session filename exerciseText =
    { elapsedTime = 0
    , exerciseState = Running (Exercise.init filename exerciseText)
    , session = session
    }

--
-- MODEL
--
type alias Model =
    { elapsedTime : Int
    , exerciseState : ExerciseState
    , session : Session
    }

type ExerciseState
    = Running Exercise
    | Completed Exercise
    | Saved Exercise
    | SaveFailed Exercise Error


exercise : Model -> Exercise
exercise model =
    case model.exerciseState of

        Running ex ->
            ex

        Completed ex ->
            ex

        Saved ex ->
            ex

        SaveFailed ex _ ->
            ex

--
-- UPDATE
--
type Msg
    = KeyTyped KeyEvent
    | Quit
    | Restart
    | SaveComplete (Result Error Int)
    | SaveResults
    | ShowExercises
    | Tick


update : (Msg -> parentMsg) -> Msg -> Model -> ( Model, Cmd parentMsg )
update toMsg msg model =
    case msg of

        Quit ->
            ( model, Cmd.perform (Task.succeed ()) (\_ -> toMsg Quit) )

        KeyTyped keyEvent ->
            if keyEvent.kind == "escape" then
                update toMsg ShowExercises model

            else
                case model.exerciseState of

                    Running ex ->
                        let
                            newModel = consumeKeyEvent keyEvent model
                            newEx = exercise newModel
                        in
                            if Exercise.isComplete newEx then
                                ( { newModel | exerciseState = Completed newEx }
                                , Cmd.none
                                )

                            else
                                ( newModel, Cmd.none )

                    Completed _ ->
                        handleCompletedKey toMsg keyEvent model

                    Saved _ ->
                        handleCompletedKey toMsg keyEvent model

                    SaveFailed _ _ ->
                        handleCompletedKey toMsg keyEvent model

        Restart ->
            let
                ex = exercise model
            in
                ( init model.session (Exercise.fullPath ex) ex.text, Cmd.none )

        SaveComplete result ->
            let
                ex = exercise model
            in
                case result of

                    Ok _ ->
                        ( { model | exerciseState = Saved ex }, Cmd.none )

                    Err e ->
                        ( { model | exerciseState = SaveFailed ex e }
                        , Cmd.none
                        )

        SaveResults ->
            case model.exerciseState of

                Saved _ ->
                    ( model, Cmd.none )

                _ ->
                    ( model
                    , Cmd.perform
                          (saveResult (exercise model))
                          (\r -> toMsg (SaveComplete r))
                    )

        ShowExercises ->
            ( model, Cmd.perform (Task.succeed ()) (\_ -> toMsg ShowExercises) )

        Tick ->
            case model.exerciseState of

                Running ex ->
                    if List.isEmpty ex.events then
                        ( model, Cmd.none )

                    else
                        ( { model | elapsedTime = model.elapsedTime + 10 }
                        , Cmd.none
                        )

                _ ->
                    ( model, Cmd.none )


consumeKeyEvent : KeyEvent -> Model -> Model
consumeKeyEvent keyEvent model =
    let
        ex = exercise model
        charToConsume =
            if keyEvent.kind == "char" then
                keyEvent.value |> String.toList |> List.head

            else if keyEvent.kind == "enter" then
                Just (Char.fromCode 13)

            else if keyEvent.kind == "backspace" then
                Just (Char.fromCode 8)

            else if keyEvent.kind == "space" then
                Just (Char.fromCode 32)

            else
                Nothing
        newExercise =
            case charToConsume of

                Just ch ->
                    Exercise.consume ch model.elapsedTime ex

                Nothing ->
                    ex
    in
        { model | exerciseState = Running newExercise, elapsedTime = 0 }


saveResult : Exercise -> Task Error Int
saveResult exercise =
    Db.exec
        Database.db
        "INSERT INTO attempts (full_path, language, accuracy, wpm, character_count, events, completed_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'))"
        [ Exercise.fullPath exercise
        , Exercise.language exercise
        , String.fromFloat (Exercise.accuracy exercise)
        , String.fromFloat (Exercise.wpm exercise)
        , String.fromInt (Exercise.typeableCharacterCount exercise)
        , "[]"
        ]


handleCompletedKey : (Msg -> parentMsg) -> keyEvent -> Model -> ( Model, Cmd parentMsg )
handleCompletedKey toMsg keyEvent model =
    if keyEvent.kind == "char" && keyEvent.value == "r" then
        update toMsg Restart model

    else if keyEvent.kind == "char" && keyEvent.value == "s" then
        update toMsg SaveResults model

    else if keyEvent.kind == "char" && keyEvent.value == "b" then
        update toMsg ShowExercises model

    else if keyEvent.kind == "char" && keyEvent.value == "q" then
        update toMsg Quit model

    else
        ( model, Cmd.none )


--
-- VIEW
--
headerFooterPaddingLines : Int
headerFooterPaddingLines =
    16


view : (Msg -> parentMsg) -> Model -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 24
        , Ui.spacing 16
        , Background.color (Ui.rgb 18 22 38)
        , Font.color (Ui.rgb 220 220 230)
        ]
        [ viewHeading model, viewBody model, viewFooter model ]


viewHeading : Model -> Element msg
viewHeading model =
    let
        ex = exercise model
    in
        Ui.el
            [ Ui.width Ui.fill
            , Ui.padding 1
            , Font.color (Ui.rgb 142 200 168)
            , Border.width 1
            , Border.color (Ui.rgb 142 200 168)
            , Border.rounded 4
            ]
            (Ui.el
                []
                (Ui.text <| Exercise.fullPath ex ++ " (" ++ Exercise.language ex
                    ++ ")"))


viewFooter : Model -> Element msg
viewFooter model =
    let
        ex = exercise model
    in
        Ui.el
            [ Ui.width Ui.fill
            , Ui.padding 1
            , Font.color (Ui.rgb 142 200 168)
            , Border.width 1
            , Border.color (Ui.rgb 142 200 168)
            , Border.rounded 4
            ]
            (Ui.el
                []
                (Ui.text <| "Accuracy: " ++ FE.toString 2 (Exercise.accuracy ex)
                    ++ "%    wpm: "
                    ++ FE.toString 2 (Exercise.wpm ex)
                    ++ "    lines: "
                    ++ String.fromInt (Exercise.currentLineIndex ex)
                    ++ " / "
                    ++ String.fromInt ((Exercise.printableLineCount ex) - 1)))


viewBody : Model -> Element msg
viewBody model =
    case model.exerciseState of

        Running _ ->
            viewExercise model

        _ ->
            viewExerciseCompleted model


viewExercise : Model -> Element msg
viewExercise model =
    let
        ex = exercise model
        windowLineCount =
            (Session.terminalLineHeight model.session)
                - headerFooterPaddingLines
        windowNumbers =
            TuiElements.windowedZipper
                windowLineCount
                (Exercise.currentLineIndex ex)
                (Exercise.printableLineCount ex)
        exerciseLines =
            Exercise.printableLines
                windowNumbers.beforeCurrentLineCount
                windowNumbers.afterCurrentLineCount
                ex
        blankLines =
            LE.repeat
                windowNumbers.blankLineCount
                [ Printable.UnstyledEmptyLine ]
    in
        Ui.column
            [ Ui.spacing 0 ]
            (List.map viewLine (exerciseLines ++ blankLines))


viewExerciseCompleted : Model -> Element msg
viewExerciseCompleted model =
    let
        ex = exercise model
    in
        Ui.column
            [ Ui.spacing 8 ]
            [ Ui.column
                  [ Ui.spacing 4
                  , Ui.padding 16
                  , Border.width 1
                  , Border.color (Ui.rgb 142 200 168)
                  , Border.rounded 4
                  ]
                  [ Ui.el
                        [ Font.bold, Font.color (Ui.rgb 142 200 168) ]
                        (Ui.text "Exercise Completed!")
                  , Ui.column
                        [ Ui.spacing 0 ]
                        [ Ui.text ("Title:           " ++ Exercise.fullPath ex)
                        , Ui.text ("Language:        " ++ Exercise.language ex)
                        , Ui.text
                              ("Character Count: "
                                  ++ (String.fromInt
                                         <| Exercise.typeableCharacterCount ex))
                        , Ui.text
                              ("Accuracy:        "
                                  ++ FE.toString 2 (Exercise.accuracy ex)
                                  ++ "%")
                        , Ui.text
                              ("WPM:             "
                                  ++ FE.toString 2 (Exercise.wpm ex))
                        , Ui.text ""
                        , Ui.text
                              (Analysis.overallAssessment
                                  (FE.fromInt <| Session.wpmTarget model.session)
                                  ex)
                        ]
                  ]
            , Ui.column
                  [ Ui.spacing 0 ]
                  [ Ui.text "  r - re-run this exercise"
                  , viewSaveHint model.exerciseState
                  , Ui.text "  b - back to exersies list"
                  , Ui.text "  q - quit"
                  ]
            ]


viewSaveHint : ExerciseState -> Element msg
viewSaveHint state =
    case state of

        Saved _ ->
            Ui.row
                []
                [ Ui.el
                      [ Font.color (Ui.rgb 80 80 100) ]
                      (Ui.text "  s - save results  ")
                , Ui.el [ Font.color (Ui.rgb 100 180 100) ] (Ui.text "✓ Saved")
                ]

        SaveFailed _ e ->
            Ui.el
                [ Font.color (Ui.rgb 180 50 50) ]
                (Ui.text
                    ("  s - save results  ✗ Save failed: " ++ Error.toString e))

        _ ->
            Ui.text "  s - save results"


hr =
    Ui.el
        [ Ui.width Ui.fill, Font.color (Ui.rgb 142 200 168) ]
        (Ui.text (String.repeat 300 "─"))


viewLine : List Exercise.Printable -> Element msg
viewLine printables =
    Ui.row [] (List.map viewPrintable printables)


viewPrintable : Exercise.Printable -> Element msg
viewPrintable printable =
    case printable of

        Printable.Styled ch style ->
            Ui.el (styleAttrs style) (Ui.text ch)

        Printable.StyledEnter style ->
            if style == Printable.Current then
                Ui.el (styleAttrs style) (Ui.text "↵")

            else
                Ui.el (styleAttrs style) (Ui.text " ")

        Printable.UnstyledEmptyLine ->
            Ui.text ""

        Printable.UnstyledEnd ->
            Ui.text ""


styleAttrs : Printable.Style -> List (Ui.Attribute msg)
styleAttrs style =
    case style of

        Printable.Current ->
            [ Background.color (Ui.rgb 80 80 120)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Printable.Completed ->
            [ Font.color (Ui.rgb 100 180 100) ]

        Printable.Errored ->
            [ Background.color (Ui.rgb 180 50 50)
            , Font.color (Ui.rgb 255 255 255)
            ]

        Printable.Waiting ->
            [ Font.color (Ui.rgb 120 120 140) ]

        Printable.Unstyled ->
            []
