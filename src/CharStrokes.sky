module CharStrokes exposing (CharStrokes, errorRate, fromEventList, groupByChar)

import Event exposing (Event)
import Float.Extra as FE
import List.Extra as LE

type alias CharStrokes =
    { target : Char
    , events : List Event
    }


--
-- CONSTRUCTION
--
fromEventList : List Event -> List CharStrokes
fromEventList events =
    let
        helper event acc =
            case ( Char.toCode event.char, acc ) of

                ( 8, [] ) ->
                    (CharStrokes event.char [ event ]) :: acc

                ( 8, h :: t ) ->
                    if h.target == backspaceChar then
                        foldBack event h t

                    else
                        (addEvent event h) :: t

                ( charCode, [] ) ->
                    (CharStrokes (Char.fromCode charCode) [ event ]) :: acc

                ( charCode, h :: t ) ->
                    if h.target == backspaceChar then
                        (addEvent event h) :: t

                    else
                        (CharStrokes (Char.fromCode charCode) [ event ]) :: acc
    in
        List.foldl helper [] events |> List.reverse


--
-- INFO
--
errorRate : List CharStrokes -> Float
errorRate charStrokes =
    let
        overallCount = charStrokes |> List.length |> FE.fromInt
        erroredCount =
            charStrokes |> List.filter (\cs -> (List.length cs.events) > 1)
                |> List.length
                |> FE.fromInt
    in
        if overallCount == 0.0 then
            0.0

        else
            erroredCount / overallCount


--
-- MANIPULATION
--
groupByChar : List CharStrokes -> Dict Char (List CharStrokes)
groupByChar charStrokes =
    let
        insertOrAppend cs acc =
            case Dict.get cs.target acc of

                Just existing ->
                    Dict.insert cs.target (existing ++ [ cs ]) acc

                Nothing ->
                    Dict.insert cs.target [ cs ] acc
    in
        List.foldl insertOrAppend Dict.empty charStrokes


--
-- PRIVATE
--'
addEvent : Event -> CharStrokes -> CharStrokes
addEvent event charStrokes =
    CharStrokes event.char (event :: charStrokes.events)


backspaceChar : Char
backspaceChar =
    Char.fromCode 8


foldBack : Event -> CharStrokes -> List CharStrokes -> List CharStrokes
foldBack event head tail =
    case tail of

        [] ->
            (addEvent event head) :: tail

        h :: t ->
            let
                newHead = { head | events = head.events ++ h.events }
            in
                (addEvent event newHead) :: t
