module CharStrokes exposing (CharStrokes, errorRate, fromEventList, groupByChar)

import Event exposing (Event)
import Float.Extra as FE
import List.Extra as LE

type alias CharStrokes =
    { target : Char
    , events : List Event
    }


--
-- CONSTRUCTION
--
fromEventList : List Event -> List CharStrokes
fromEventList events =
    let
        helper event acc =
            case ( Char.toCode event.char, acc ) of

                ( 8, [] ) ->
                    (CharStrokes event.char [ event ]) :: acc

                ( 8, h :: t ) ->
                    if h.target == backspaceChar then
                        foldBack event h t

                    else
                        (addEvent event h) :: t

                ( charCode, [] ) ->
                    (CharStrokes (Char.fromCode charCode) [ event ]) :: acc

                ( charCode, h :: t ) ->
                    if h.target == backspaceChar then
                        (addEvent event h) :: t

                    else
                        (CharStrokes (Char.fromCode charCode) [ event ]) :: acc
    in
        List.foldl helper [] events |> List.reverse


--
-- INFO
--
errorRate : List CharStrokes -> Float
errorRate charStrokes =
    let
        overallCount = charStrokes |> List.length |> FE.fromInt
        erroredCount =
            charStrokes |> List.filter (\cs -> (List.length cs.events) > 1)
                |> List.length
                |> FE.fromInt
    in
        if overallCount == 0.0 then
            0.0

        else
            erroredCount / overallCount


