module CharStrokes exposing (fromEventList)

import Event exposing (Event)

type alias CharStrokes =
    { target : Char
    , events : List Event
    }


fromEventList : List Event -> List CharStrokes
fromEventList events =
    let
        helper event acc =
            case ( Char.toCode event.char, acc ) of

                ( 8, [] ) ->
                    (CharStrokes event.char [ event ]) :: acc

                ( 8, h :: t ) ->
                    (addEvent event h) :: t

                ( charCode, [] ) ->
                    (CharStrokes (Char.fromCode charCode) [ event ]) :: acc

                ( charCode, h :: t ) ->
                    if h.target == backspaceChar then
                        (addEvent event h) :: t

                    else
                        (CharStrokes (Char.fromCode charCode) [ event ]) :: acc
    in
        List.foldl helper [] events |> List.reverse


--
-- PRIVATE
--'
addEvent : Event -> CharStrokes -> CharStrokes
addEvent event charStrokes =
    CharStrokes event.char (event :: charStrokes.events)


backspaceChar : Char
backspaceChar =
    Char.fromCode 8
