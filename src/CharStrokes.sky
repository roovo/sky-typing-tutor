--
-- PRIVATE
--'
addEvent : Event -> CharStrokes -> CharStrokes
addEvent event charStrokes =
    CharStrokes event.char (event :: charStrokes.events)


backspaceChar : Char
backspaceChar =
    Char.fromCode 8


foldBack : Event -> CharStrokes -> List CharStrokes -> List CharStrokes
foldBack event head tail =
    case tail of

        [] ->
            (addEvent event head) :: tail

        h :: t ->
            let
                newHead = { head | events = head.events ++ h.events }
            in
                (addEvent event newHead) :: t
