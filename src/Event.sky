module Event exposing (Event, howManyTyped, timeTaken, toJson)

import Sky.Core.Json.Encode as JE

type alias Event =
    { char : Char
    , timeTaken : Int
    }


howManyTyped : List Event -> Int
howManyTyped events =
    events |> withoutBackspaces |> List.length


timeTaken : List Event -> Int
timeTaken events =
    events |> List.filter (\e -> e.timeTaken < 3000)
        |> List.foldl (\e acc -> e.timeTaken + acc) 0


toJson : Event -> JE.Value
toJson event =
    JE.object
        [ ( "char", JE.int (Char.toCode event.char) )
        , ( "timeTaken", JE.int event.timeTaken )
        ]


--
-- PRIVATE
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


withoutBackspaces : List Event -> List Event
withoutBackspaces events =
    List.filter (\e -> e.char /= backspaceChar) events
