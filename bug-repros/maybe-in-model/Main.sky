module Main exposing (main)

{- Minimal reproduction: Maybe value in model field corrupted after Tui round-trip.

   Expected: Press any key, the view stays showing "Value: Nothing".
   Actual: Press any key, the view switches to "Value: Just ''".

   Nothing becomes Just "" during the Tui runtime's model
   serialisation/deserialisation cycle.

   Note: This may only reproduce when the model has a similar shape to
   the real app (multiple fields including a List of records).
-}

import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)


type alias KeyEvent =
    { kind : String
    , value : String
    }


type alias Item =
    { id : Int
    , name : String
    , language : String
    , characterCount : Int
    }


type alias Model =
    { value : Maybe String
    , items : List Item
    , counter : Int
    , label : String
    }


type Msg
    = KeyPressed KeyEvent
    | Quit
    | NoOp


init : () -> ( Model, Cmd Msg )
init _ =
    ( { value = Nothing
      , items =
            [ { id = 1, name = "foo.sky", language = "Sky", characterCount = 100 }
            , { id = 2, name = "bar.rb", language = "Ruby", characterCount = 200 }
            ]
      , counter = 0
      , label = "test"
      }
    , Cmd.none
    )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        KeyPressed _ ->
            ( { model | counter = model.counter + 1 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.padding 8, Ui.spacing 4 ]
        [ Ui.text ("Counter: " ++ String.fromInt model.counter)
        , Ui.text ("Items: " ++ String.fromInt (List.length model.items))
        , Ui.text
              (case model.value of

                  Nothing ->
                      "Value: Nothing"

                  Just s ->
                      "Value: Just '" ++ s ++ "'")
        , Ui.text "Press any key (should stay on 'Value: Nothing')"
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else if keyEvent.kind == "escape" then
        Quit

    else
        KeyPressed keyEvent


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
