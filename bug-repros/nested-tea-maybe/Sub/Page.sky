module Sub.Page exposing (PageModel, Msg(..), init, update, view)

{- Sub-page module with a Maybe field in its model.
   This model gets wrapped in an ADT variant in Main.
-}

import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Ui as Ui
import Std.Ui exposing (Element)


type alias KeyEvent =
    { kind : String
    , value : String
    }


type alias Item =
    { id : Int
    , name : String
    , language : String
    , characterCount : Int
    }


type alias PageModel =
    { value : Maybe String
    , items : List Item
    , counter : Int
    , label : String
    }


type Msg
    = KeyTyped KeyEvent


init : (Msg -> parentMsg) -> ( PageModel, Cmd parentMsg )
init toMsg =
    ( { value = Nothing
      , items =
            [ { id = 1, name = "foo.sky", language = "Sky", characterCount = 100 }
            , { id = 2, name = "bar.rb", language = "Ruby", characterCount = 200 }
            ]
      , counter = 0
      , label = "test"
      }
    , Cmd.none
    )


update : (Msg -> parentMsg) -> Msg -> PageModel -> ( PageModel, Cmd parentMsg )
update toMsg msg model =
    case msg of

        KeyTyped _ ->
            ( { model | counter = model.counter + 1 }, Cmd.none )


view : (Msg -> parentMsg) -> PageModel -> Element parentMsg
view toMsg model =
    Ui.column
        [ Ui.padding 8, Ui.spacing 4 ]
        [ Ui.text ("Counter: " ++ String.fromInt model.counter)
        , Ui.text ("Items: " ++ String.fromInt (List.length model.items))
        , Ui.text
              (case model.value of

                  Nothing ->
                      "Value: Nothing"

                  Just s ->
                      "Value: Just '" ++ s ++ "'")
        , Ui.text ""
        , Ui.text "Press any key (should stay on 'Value: Nothing')"
        , Ui.text "Press q or Escape to quit"
        ]
