module Main exposing (main)

{- Minimal reproduction: Maybe value in a sub-module model, wrapped in
   an ADT variant in the parent, corrupted after Tui round-trip.

   This mimics the nested TEA pattern:
   - Main has an AppModel ADT with variants wrapping sub-page models
   - Key events are dispatched to the sub-page via toMsg pattern
   - The sub-page model contains a Maybe String field

   Expected: Press any key, the view stays showing "Value: Nothing".
   Actual: Press any key, the value changes or the app panics.
-}

import Sub.Page as SubPage
import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)


type alias KeyEvent =
    { kind : String
    , value : String
    }


type AppModel
    = PageA SubPage.PageModel
    | PageB


type Msg
    = GotSubMsg SubPage.Msg
    | KeyPressed KeyEvent
    | Quit
    | NoOp


init : () -> ( AppModel, Cmd Msg )
init _ =
    let
        ( subModel, cmd ) = SubPage.init GotSubMsg
    in
        ( PageA subModel, cmd )


update : Msg -> AppModel -> ( AppModel, Cmd Msg )
update msg model =
    case ( msg, model ) of

        ( GotSubMsg subMsg, PageA subModel ) ->
            let
                ( newSubModel, cmd ) =
                    SubPage.update GotSubMsg subMsg subModel
            in
                ( PageA newSubModel, cmd )

        ( GotSubMsg _, _ ) ->
            ( model, Cmd.none )

        ( KeyPressed keyEvent, PageA subModel ) ->
            let
                ( newSubModel, cmd ) =
                    SubPage.update
                        GotSubMsg
                        (SubPage.KeyTyped keyEvent)
                        subModel
            in
                ( PageA newSubModel, cmd )

        ( KeyPressed _, _ ) ->
            ( model, Cmd.none )

        ( Quit, _ ) ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        ( NoOp, _ ) ->
            ( model, Cmd.none )


view : AppModel -> Element Msg
view model =
    case model of

        PageA subModel ->
            SubPage.view GotSubMsg subModel

        PageB ->
            Ui.text "Page B (unused)"


subscriptions : AppModel -> Sub Msg
subscriptions _ =
    Sub.none


onKey : KeyEvent -> Msg
onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else if keyEvent.kind == "escape" then
        Quit

    else
        KeyPressed keyEvent


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
