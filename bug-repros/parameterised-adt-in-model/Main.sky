module Main exposing (main)

{- Minimal reproduction: Parameterised ADT in model field corrupted after Tui round-trip.

   Expected: Press any key, the view stays showing "Status: Loaded (2 items)".
   Actual: Press any key, panic: sky.Unreachable(case)

   The Status ADT variant tag is lost during the Tui runtime's model
   serialisation/deserialisation cycle. Same root cause as the custom
   ADT case, but exercises the parameterised type path.
-}

import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui
import Std.Ui exposing (Element)


type alias KeyEvent =
    { kind : String
    , value : String
    }


type Status a
    = Loading
    | Loaded a
    | Failed String


type alias Model =
    { items : Status (List String)
    , counter : Int
    }


type Msg
    = KeyPressed KeyEvent
    | Quit
    | NoOp


init : () -> ( Model, Cmd Msg )
init _ =
    ( { items = Loaded [ "foo", "bar" ], counter = 0 }, Cmd.none )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        KeyPressed _ ->
            ( { model | counter = model.counter + 1 }, Cmd.none )

        Quit ->
            ( model, Cmd.perform (System.exit 0) (\_ -> NoOp) )

        NoOp ->
            ( model, Cmd.none )


view : Model -> Element Msg
view model =
    Ui.column
        [ Ui.padding 8, Ui.spacing 4 ]
        [ Ui.text ("Counter: " ++ String.fromInt model.counter)
        , Ui.text
              (case model.items of

                  Loading ->
                      "Status: Loading"

                  Loaded xs ->
                      "Status: Loaded (" ++ String.fromInt (List.length xs) ++ " items)"

                  Failed err ->
                      "Status: Failed - " ++ err)
        , Ui.text "Press any key (should stay on 'Status: Loaded (2 items)')"
        ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


onKey keyEvent =
    if keyEvent.kind == "char" && keyEvent.value == "q" then
        Quit

    else if keyEvent.kind == "escape" then
        Quit

    else
        KeyPressed keyEvent


main =
    Tui.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        , onKey = onKey
        }
