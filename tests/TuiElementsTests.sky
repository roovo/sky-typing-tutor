module TuiElementsTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import TuiElements
import Zipper


tests : List Test
tests =
    windowedZipperTests


windowedZipperTests : List Test
windowedZipperTests =
    [ Test.test
          "windowedZipper returns beforeCurrentLineCount of 0 for a singleton"
          (\_ ->
              TuiElements.windowedZipper 20 0 1 |> .beforeCurrentLineCount
                  |> Test.equal 0)
    , Test.test
          "windowedZipper returns afterCurrentLineCount of 0 for a singleton"
          (\_ ->
              TuiElements.windowedZipper 20 0 1 |> .afterCurrentLineCount
                  |> Test.equal 0)
    , Test.test
          "windowedZipper returns blankLineCount of 19 for a singleton when the totalLines is 20"
          (\_ ->
              TuiElements.windowedZipper 20 0 1 |> .blankLineCount
                  |> Test.equal 19)
    , Test.test
          "windowedZipper returns beforeCurrentLineCount of 0 for being on line index 0 of a 2 liner"
          (\_ ->
              TuiElements.windowedZipper 20 0 2 |> .beforeCurrentLineCount
                  |> Test.equal 0)
    , Test.test
          "windowedZipper returns afterCurrentLineCount of 1 for being on line index 0 of a 2 liner"
          (\_ ->
              TuiElements.windowedZipper 20 0 2 |> .afterCurrentLineCount
                  |> Test.equal 1)
    , Test.test
          "windowedZipper returns blankLineCount of 18 for being on line index 0 of 2 liner when the totalLines is 20"
          (\_ ->
              TuiElements.windowedZipper 20 0 2 |> .blankLineCount
                  |> Test.equal 18)
    , Test.test
          "windowedZipper returns beforeCurrentLineCount of 1 for being on line index 1 of a 2 liner"
          (\_ ->
              TuiElements.windowedZipper 20 1 2 |> .beforeCurrentLineCount
                  |> Test.equal 1)
    , Test.test
          "windowedZipper returns afterCurrentLineCount of 0 for being on line index 1 of a 2 liner"
          (\_ ->
              TuiElements.windowedZipper 20 1 2 |> .afterCurrentLineCount
                  |> Test.equal 0)
    , Test.test
          "windowedZipper returns blankLineCount of 18 for being on line index 1 of 2 liner when the totalLines is 20"
          (\_ ->
              TuiElements.windowedZipper 20 1 2 |> .blankLineCount
                  |> Test.equal 18)
    , Test.test
          "windowedZipper returns beforeCurrentLineCount of 1 for being on line index 1 of a 3 liner"
          (\_ ->
              TuiElements.windowedZipper 20 1 3 |> .beforeCurrentLineCount
                  |> Test.equal 1)
    , Test.test
          "windowedZipper returns afterCurrentLineCount of 1 for being on line index 1 of a 3 liner"
          (\_ ->
              TuiElements.windowedZipper 20 1 3 |> .afterCurrentLineCount
                  |> Test.equal 1)
    , Test.test
          "windowedZipper returns blankLineCount of 17 for being on line index 1 of 3 liner when the totalLines is 20"
          (\_ ->
              TuiElements.windowedZipper 20 1 3 |> .blankLineCount
                  |> Test.equal 17)
    ]
