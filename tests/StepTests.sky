module StepTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Step


tests : List Test
tests =
    isSkipableTests ++ isTypeableTests


isSkipableTests : List Test
isSkipableTests =
    [ Test.test
          "isSkipable returns False for a normal Step"
          (\_ -> Step.init 'f' |> Step.isSkipable |> Test.equal False)
    , Test.test
          "isSkipable returns False for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isSkipable |> Test.equal False)
    , Test.test
          "isSkipable returns True for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isSkipable |> Test.equal True)
    , Test.test
          "isSkipable returns True for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isSkipable |> Test.equal True)
    , Test.test
          "isSkipable returns True for an End Step"
          (\_ -> Step.initEnd |> Step.isSkipable |> Test.equal True)
    ]


isTypeableTests : List Test
isTypeableTests =
    [ Test.test
          "isTypeable returns True for a normal Step"
          (\_ -> Step.init 'f' |> Step.isTypeable |> Test.equal True)
    , Test.test
          "isTypeable returns True for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isTypeable |> Test.equal True)
    , Test.test
          "isTypeable returns False for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isTypeable |> Test.equal False)
    , Test.test
          "isTypeable returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isTypeable |> Test.equal False)
    , Test.test
          "isTypeable returns False for an End Step"
          (\_ -> Step.initEnd |> Step.isTypeable |> Test.equal False)
    ]
