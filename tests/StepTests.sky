module StepTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Step


tests : List Test
tests =
    isEndTests ++ isEnterTests ++ isSkipableTests ++ isTypeableTests
        ++ matchesTypedTests


isEndTests : List Test
isEndTests =
    [ Test.test
          "isEnd returns False for a normal Step"
          (\_ -> Step.init 'f' |> Step.isEnd |> Test.equal False)
    , Test.test
          "isEnd returns False for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isEnd |> Test.equal False)
    , Test.test
          "isEnd returns False for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isEnd |> Test.equal False)
    , Test.test
          "isEnd returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isEnd |> Test.equal False)
    , Test.test
          "isEnd returns True for an End Step"
          (\_ -> Step.initEnd |> Step.isEnd |> Test.equal True)
    ]


isEnterTests : List Test
isEnterTests =
    [ Test.test
          "isEnter returns False for a normal Step"
          (\_ -> Step.init 'f' |> Step.isEnter |> Test.equal False)
    , Test.test
          "isEnter returns True for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isEnter |> Test.equal True)
    , Test.test
          "isEnter returns False for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isEnter |> Test.equal False)
    , Test.test
          "isEnter returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isEnter |> Test.equal False)
    , Test.test
          "isEnter returns False for an End Step"
          (\_ -> Step.initEnd |> Step.isEnter |> Test.equal False)
    ]


isSkipableTests : List Test
isSkipableTests =
    [ Test.test
          "isSkipable returns False for a normal Step"
          (\_ -> Step.init 'f' |> Step.isSkipable |> Test.equal False)
    , Test.test
          "isSkipable returns False for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isSkipable |> Test.equal False)
    , Test.test
          "isSkipable returns True for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isSkipable |> Test.equal True)
    , Test.test
          "isSkipable returns True for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isSkipable |> Test.equal True)
    , Test.test
          "isSkipable returns False for an End Step"
          (\_ -> Step.initEnd |> Step.isSkipable |> Test.equal False)
    ]


isTypeableTests : List Test
isTypeableTests =
    [ Test.test
          "isTypeable returns True for a normal Step"
          (\_ -> Step.init 'f' |> Step.isTypeable |> Test.equal True)
    , Test.test
          "isTypeable returns True for an EnterChar"
          (\_ -> Step.initEnterChar |> Step.isTypeable |> Test.equal True)
    , Test.test
          "isTypeable returns False for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.isTypeable |> Test.equal False)
    , Test.test
          "isTypeable returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isTypeable |> Test.equal False)
    , Test.test
          "isTypeable returns False for an End Step"
          (\_ -> Step.initEnd |> Step.isTypeable |> Test.equal False)
    ]


matchesTypedTests : List Test
matchesTypedTests =
    [ Test.test
          "matchesTyped returns False for a normal Step when the char doesn't match"
          (\_ -> Step.init 'f' |> Step.matchesTyped 'x' |> Test.equal False)
    , Test.test
          "matchesTyped returns True for a normal Step when the char matches"
          (\_ -> Step.init 'f' |> Step.matchesTyped 'f' |> Test.equal True)
    , Test.test
          "matchesTyped returns False for an EnterChar when the char isn't an EnterChar"
          (\_ -> Step.initEnterChar |> Step.matchesTyped 'x' |> Test.equal False)
    , Test.test
          "matchesTyped returns True for an EnterChar when the char is an EnterChar"
          (\_ ->
              Step.initEnterChar |> Step.matchesTyped (Char.fromCode 13)
                  |> Test.equal True)
    , Test.test
          "matchesTyped returns False for an EmptyLine"
          (\_ -> Step.initEmptyLine |> Step.matchesTyped 'x' |> Test.equal False)
    , Test.test
          "matchesTyped returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.matchesTyped 'x' |> Test.equal False)
    , Test.test
          "matchesTyped returns False for an End Step"
          (\_ -> Step.initEnd |> Step.matchesTyped 'x' |> Test.equal False)
    ]
