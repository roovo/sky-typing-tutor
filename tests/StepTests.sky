module StepTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Step


tests : List Test
tests =
    isTypeableTests ++ toStringTests


isTypeableTests : List Test
isTypeableTests =
    [ Test.test
          "isTypeable returns True for a normal Step"
          (\_ -> Step.init 'f' |> Step.isTypeable |> Test.equal True)
    , Test.test
          "isTypeable returns False for a Skip Step"
          (\_ -> Step.initSkip "a" |> Step.isTypeable |> Test.equal False)
    , Test.test
          "isTypeable returns False for an End Step"
          (\_ -> Step.initEnd |> Step.isTypeable |> Test.equal False)
    ]


toStringTests : List Test
toStringTests =
    [ Test.test
          "toString returns the char in a Typeable as a string"
          (\_ -> Step.init 'f' |> Step.toString |> Test.equal "f")
    , Test.test
          "toString returns the contents of a Skipable"
          (\_ -> Step.initSkip "foo" |> Step.toString |> Test.equal "foo")
    , Test.test
          "toString returns the an Empty string for End"
          (\_ -> Step.initEnd |> Step.toString |> Test.equal "")
    ]
