module Float.ExtraTests exposing (tests)

import Sky.Test as Test exposing (Test)
import Float.Extra as FE


tests : List Test
tests =
    fromIntTests ++ toStringTests


fromIntTests : List Test
fromIntTests =
    [ Test.test
          "fromInt returns '0.0' for '0'"
          (\_ -> 0 |> FE.fromInt |> Test.equal 0.0)
    , Test.test
          "fromInt returns '1.0' for '1'"
          (\_ -> 1 |> FE.fromInt |> Test.equal 1.0)
    , Test.test
          "fromInt returns '723.0' for '723'"
          (\_ -> 723 |> FE.fromInt |> Test.equal 723.0)
    , Test.test
          "fromInt returns '-1.0' for '-1'"
          (\_ -> -1 |> FE.fromInt |> Test.equal (-1.0))
    ]


toStringTests : List Test
toStringTests =
    [ Test.test
          "toString returns '0' for '0.0' with 0 dp"
          (\_ -> 0.0 |> FE.toString 0 |> Test.equal "0")
    , Test.test
          "toString returns '1' for '1.444' with 0 dp"
          (\_ -> 1.444 |> FE.toString 0 |> Test.equal "1")
    , Test.test
          "toString returns '2' for '1.5' with 0 dp"
          (\_ -> 1.5 |> FE.toString 0 |> Test.equal "2")
    , Test.test
          "toString returns '2' for '1.55' with 0 dp"
          (\_ -> 1.55 |> FE.toString 0 |> Test.equal "2")
    , Test.test
          "toString returns '0.0' for '0.0' with 1 dp"
          (\_ -> 0.0 |> FE.toString 1 |> Test.equal "0.0")
    , Test.test
          "toString returns '1.2' for '1.244' with 1 dp"
          (\_ -> 1.244 |> FE.toString 1 |> Test.equal "1.2")
    , Test.test
          "toString returns '1.3' for '1.250' with 1 dp"
          (\_ -> 1.25 |> FE.toString 1 |> Test.equal "1.3")
    , Test.test
          "toString returns '1.3' for '1.255' with 1 dp"
          (\_ -> 1.255 |> FE.toString 1 |> Test.equal "1.3")
    , Test.test
          "toString returns '0.00' for '0.0' with 2 dp's"
          (\_ -> 0.0 |> FE.toString 2 |> Test.equal "0.00")
    , Test.test
          "toString returns '1.26' for '1.264' with 2 dp's"
          (\_ -> 1.264 |> FE.toString 2 |> Test.equal "1.26")
    , Test.test
          "toString returns '1.26' for '1.265' with 2 dp's"
          (\_ -> 1.265 |> FE.toString 2 |> Test.equal "1.26")
    , Test.test
          "toString returns '1.27' for '1.266' with 2 dp's"
          (\_ -> 1.266 |> FE.toString 2 |> Test.equal "1.27")
    ]
