module PrintableTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Printable exposing (Printable(..), Style(..))
import Step


tests : List Test
tests =
    fromStepTests ++ splitIntoLinesTests ++ takeFirstLinesTests
        ++ takeLastLinesTests


fromStepTests : List Test
fromStepTests =
    [ Test.test
          "fromStep returns UnstyledEnd for Step.End"
          (\_ ->
              Step.initEnd |> Printable.fromStep Printable.Current
                  |> Test.equal Printable.UnstyledEnd)
    , Test.test
          "fromStep returns StyledEnter for Step.EnterChar"
          (\_ ->
              Step.initEnterChar |> Printable.fromStep Printable.Current
                  |> Test.equal (Printable.StyledEnter Printable.Current))
    , Test.test
          "fromStep returns UnstyledEmptyLine for Step.EmptyLine"
          (\_ ->
              Step.initEmptyLine |> Printable.fromStep Printable.Current
                  |> Test.equal Printable.UnstyledEmptyLine)
    , Test.test
          "fromStep returns Styled str Unstyled for Step.Skip str"
          (\_ ->
              Step.initSkip "foo" |> Printable.fromStep Printable.Waiting
                  |> Test.equal (Printable.Styled "foo" Printable.Unstyled))
    , Test.test
          "fromStep returns Styled str for Step.Typeable ch"
          (\_ ->
              Step.init 'f' |> Printable.fromStep Printable.Waiting
                  |> Test.equal (Printable.Styled "f" Printable.Waiting))
    ]


splitIntoLinesTests : List Test
splitIntoLinesTests =
    [ Test.test
          "splitIntoLines returns [] for an empty list of Printables"
          (\_ -> [] |> Printable.splitIntoLines |> Test.equal [])
    , Test.test
          "splitIntoLines returns [[ UnstyledEnd]] for an singelton [ UnstyledEnd ]"
          (\_ ->
              [ UnstyledEnd ] |> Printable.splitIntoLines
                  |> Test.equal [ [ UnstyledEnd ] ])
    , Test.test
          "splitIntoLines returns [[ 'foo' ]] for an singelton [ 'foo' ]"
          (\_ ->
              [ Styled "foo" Completed ] |> Printable.splitIntoLines
                  |> Test.equal [ [ Styled "foo" Completed ] ])
    , Test.test
          "splitIntoLines splits on Enter characters"
          (\_ ->
              [ Styled "a" Waiting, StyledEnter Completed, Styled "b" Errored ]
                  |> Printable.splitIntoLines
                  |> Test.equal
                         [ [ Styled "a" Waiting, StyledEnter Completed ]
                         , [ Styled "b" Errored ]
                         ])
    , Test.test
          "splitIntoLines splits on empty lines"
          (\_ ->
              [ Styled "a" Waiting
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              ]
                  |> Printable.splitIntoLines
                  |> Test.equal
                         [ [ Styled "a" Waiting, StyledEnter Completed ]
                         , [ UnstyledEmptyLine ]
                         , [ Styled "b" Errored ]
                         ])
    ]


takeFirstLinesTests : List Test
takeFirstLinesTests =
    [ Test.test
          "takeFirstLines returns [] if there are no lines"
          (\_ ->
              [] |> Printable.takeFirstLines 3 (StyledEnter Completed)
                  |> Test.equal [])
    , Test.test
          "takeFirstLines returns [] if asked for 0 and current is at the end of a line"
          (\_ ->
              [ Styled "c" Errored
              , Styled "d" Errored
              , StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 0 (StyledEnter Completed)
                  |> Test.equal [])
    , Test.test
          "takeFirstLines returns the rest of the current line if asked for 0 and current is at the start of aline"
          (\_ ->
              [ Styled "d" Errored
              , StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 0 (Styled "c" Completed)
                  |> Test.equal [ Styled "d" Errored, StyledEnter Completed ])
    , Test.test
          "takeFirstLines returns the rest of the current line if asked for 0 and current is just before the end of line"
          (\_ ->
              [ StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 0 (Styled "d" Completed)
                  |> Test.equal [ StyledEnter Completed ])
    , Test.test
          "takeFirstLines returns the next line if asked for 1 and current is at the end of a line"
          (\_ ->
              [ Styled "c" Errored
              , Styled "d" Errored
              , StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 1 (StyledEnter Completed)
                  |> Test.equal
                         [ Styled "c" Errored
                         , Styled "d" Errored
                         , StyledEnter Completed
                         ])
    , Test.test
          "takeFirstLines returns the rest of the current line and the next line if asked for 1 and current is at the start of aline"
          (\_ ->
              [ Styled "d" Errored
              , StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 1 (Styled "c" Completed)
                  |> Test.equal
                         [ Styled "d" Errored
                         , StyledEnter Completed
                         , Styled "e" Errored
                         , Styled "f" Errored
                         , StyledEnter Completed
                         ])
    , Test.test
          "takeFirstLines returns the rest of the current line if asked for 1 and current is just before the end of line"
          (\_ ->
              [ StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 1 (Styled "d" Completed)
                  |> Test.equal
                         [ StyledEnter Completed
                         , Styled "e" Errored
                         , Styled "f" Errored
                         , StyledEnter Completed
                         ])
    , Test.test
          "takeFirstLines takes empty lines"
          (\_ ->
              [ StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 2 (Styled "d" Completed)
                  |> Test.equal
                         [ StyledEnter Completed
                         , Styled "e" Errored
                         , Styled "f" Errored
                         , StyledEnter Completed
                         , UnstyledEmptyLine
                         ])
    , Test.test
          "takeFirstLines takes all the lines if being asked for more than there are"
          (\_ ->
              [ StyledEnter Completed
              , Styled "e" Errored
              , Styled "f" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "g" Errored
              ]
                  |> Printable.takeFirstLines 10 (Styled "d" Completed)
                  |> Test.equal
                         [ StyledEnter Completed
                         , Styled "e" Errored
                         , Styled "f" Errored
                         , StyledEnter Completed
                         , UnstyledEmptyLine
                         , Styled "g" Errored
                         ])
    ]


takeLastLinesTests : List Test
takeLastLinesTests =
    [ Test.test
          "takeLastLines returns [] if there are no lines"
          (\_ -> [] |> Printable.takeLastLines 3 |> Test.equal [])
    , Test.test
          "takeLastLines returns the current line if asked for 0 and current is at the end of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              , Styled "e" Errored
              ]
                  |> Printable.takeLastLines 0
                  |> Test.equal [ Styled "d" Errored, Styled "e" Errored ])
    , Test.test
          "takeLastLines returns the current line if asked for 0 and current is just before the end of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              ]
                  |> Printable.takeLastLines 0
                  |> Test.equal [ Styled "d" Errored ])
    , Test.test
          "takeLastLines returns [] if asked for 0 and current is at the start of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              ]
                  |> Printable.takeLastLines 0
                  |> Test.equal [])
    , Test.test
          "takeLastLines returns the current line and the previous one if asked for 1 and current is at the end of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              , Styled "e" Errored
              ]
                  |> Printable.takeLastLines 1
                  |> Test.equal
                         [ Styled "b" Errored
                         , Styled "c" Errored
                         , StyledEnter Completed
                         , Styled "d" Errored
                         , Styled "e" Errored
                         ])
    , Test.test
          "takeLastLines returns the current line and the previous one if asked for 1 and current is just before the end of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              ]
                  |> Printable.takeLastLines 1
                  |> Test.equal
                         [ Styled "b" Errored
                         , Styled "c" Errored
                         , StyledEnter Completed
                         , Styled "d" Errored
                         ])
    , Test.test
          "takeLastLines returns the previous line if asked for 1 and current is at the start of a line"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              ]
                  |> Printable.takeLastLines 1
                  |> Test.equal
                         [ Styled "b" Errored
                         , Styled "c" Errored
                         , StyledEnter Completed
                         ])
    , Test.test
          "takeLastLines takes empty lines"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              , Styled "e" Errored
              ]
                  |> Printable.takeLastLines 2
                  |> Test.equal
                         [ UnstyledEmptyLine
                         , Styled "b" Errored
                         , Styled "c" Errored
                         , StyledEnter Completed
                         , Styled "d" Errored
                         , Styled "e" Errored
                         ])
    , Test.test
          "takeLastLines takes all the lines if being asked for more than there are"
          (\_ ->
              [ Styled "a" Errored
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              , Styled "c" Errored
              , StyledEnter Completed
              , Styled "d" Errored
              , Styled "e" Errored
              ]
                  |> Printable.takeLastLines 10
                  |> Test.equal
                         [ Styled "a" Errored
                         , StyledEnter Completed
                         , UnstyledEmptyLine
                         , Styled "b" Errored
                         , Styled "c" Errored
                         , StyledEnter Completed
                         , Styled "d" Errored
                         , Styled "e" Errored
                         ])
    ]
