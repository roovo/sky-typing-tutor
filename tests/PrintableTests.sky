module PrintableTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Printable exposing (Printable(..), Style(..))
import Step


tests : List Test
tests =
    fromStepTests ++ splitIntoLinesTests ++ takeFirstLinesTests


fromStepTests : List Test
fromStepTests =
    [ Test.test
          "fromStep returns UnstyledEnd for Step.End"
          (\_ ->
              Step.initEnd |> Printable.fromStep Printable.Current
                  |> Test.equal Printable.UnstyledEnd)
    , Test.test
          "fromStep returns StyledEnter for Step.EnterChar"
          (\_ ->
              Step.initEnterChar |> Printable.fromStep Printable.Current
                  |> Test.equal (Printable.StyledEnter Printable.Current))
    , Test.test
          "fromStep returns UnstyledEmptyLine for Step.EmptyLine"
          (\_ ->
              Step.initEmptyLine |> Printable.fromStep Printable.Current
                  |> Test.equal Printable.UnstyledEmptyLine)
    , Test.test
          "fromStep returns Styled str Unstyled for Step.Skip str"
          (\_ ->
              Step.initSkip "foo" |> Printable.fromStep Printable.Waiting
                  |> Test.equal (Printable.Styled "foo" Printable.Unstyled))
    , Test.test
          "fromStep returns Styled str for Step.Typeable ch"
          (\_ ->
              Step.init 'f' |> Printable.fromStep Printable.Waiting
                  |> Test.equal (Printable.Styled "f" Printable.Waiting))
    ]


splitIntoLinesTests : List Test
splitIntoLinesTests =
    [ Test.test
          "splitIntoLines returns [] for an empty list of Printables"
          (\_ -> [] |> Printable.splitIntoLines |> Test.equal [])
    , Test.test
          "splitIntoLines returns [[ UnstyledEnd]] for an singelton [ UnstyledEnd ]"
          (\_ ->
              [ UnstyledEnd ] |> Printable.splitIntoLines
                  |> Test.equal [ [ UnstyledEnd ] ])
    , Test.test
          "splitIntoLines returns [[ 'foo' ]] for an singelton [ 'foo' ]"
          (\_ ->
              [ Styled "foo" Completed ] |> Printable.splitIntoLines
                  |> Test.equal [ [ Styled "foo" Completed ] ])
    , Test.test
          "splitIntoLines splits on Enter characters"
          (\_ ->
              [ Styled "a" Waiting, StyledEnter Completed, Styled "b" Errored ]
                  |> Printable.splitIntoLines
                  |> Test.equal
                         [ [ Styled "a" Waiting, StyledEnter Completed ]
                         , [ Styled "b" Errored ]
                         ])
    , Test.test
          "splitIntoLines splits on empty lines"
          (\_ ->
              [ Styled "a" Waiting
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              ]
                  |> Printable.splitIntoLines
                  |> Test.equal
                         [ [ Styled "a" Waiting, StyledEnter Completed ]
                         , [ UnstyledEmptyLine ]
                         , [ Styled "b" Errored ]
                         ])
    ]


takeFirstLinesTests : List Test
takeFirstLinesTests =
    [ Test.test
          "takeFirstLines returns [] if there are no lines"
          (\_ ->
              [] |> Printable.takeFirstLines 3 (StyledEnter Completed)
                  |> Test.equal [])
    , Test.test
          "takeFirstLines returns [] if I am on a line end and there are lines but I have asked for none"
          (\_ ->
              [ Styled "a" Waiting ]
                  |> Printable.takeFirstLines 0 (StyledEnter Completed)
                  |> Test.equal [])
    , Test.test
          "takeFirstLines returns the 'current line' if I am NOT on a line end and I have asked for no lines"
          (\_ ->
              [ Styled "a" Waiting ]
                  |> Printable.takeFirstLines 0 (Styled "a" Completed)
                  |> Test.equal [ Styled "a" Waiting ])
    , Test.test
          "takeFirstLines does not take anything from the next line"
          (\_ ->
              [ Styled "a" Waiting, StyledEnter Completed, Styled "b" Errored ]
                  |> Printable.takeFirstLines 0 (Styled "a" Completed)
                  |> Test.equal [ Styled "a" Waiting, StyledEnter Completed ])
    , Test.test
          "takeFirstLines takes blank lines"
          (\_ ->
              [ Styled "a" Waiting
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              ]
                  |> Printable.takeFirstLines 2 (StyledEnter Completed)
                  |> Test.equal
                         [ Styled "a" Waiting
                         , StyledEnter Completed
                         , UnstyledEmptyLine
                         ])
    , Test.test
          "takeFirstLines takes all the lines if requesting more than there are"
          (\_ ->
              [ Styled "a" Waiting
              , StyledEnter Completed
              , UnstyledEmptyLine
              , Styled "b" Errored
              ]
                  |> Printable.takeFirstLines 10 (StyledEnter Completed)
                  |> Test.equal
                         [ Styled "a" Waiting
                         , StyledEnter Completed
                         , UnstyledEmptyLine
                         , Styled "b" Errored
                         ])
    ]
