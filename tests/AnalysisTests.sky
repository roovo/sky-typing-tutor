module AnalysisTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Analysis
import Exercise


tests : List Test
tests =
    overallAssessmentTests


overallAssessmentTests : List Test
overallAssessmentTests =
    [ Test.test
          "overallAssessment returns 'Focus on accuracy' if accuracy = 81.81%"
          (\_ ->
              inaccurateExercise |> Analysis.overallAssessment 0.0
                  |> String.left 17
                  |> Test.equal "Focus on accuracy")
    , Test.test
          "overallAssessment returns 'Good progress' if accuracy = 90%"
          (\_ ->
              betterAccuracyExercise |> Analysis.overallAssessment 0.0
                  |> String.left 13
                  |> Test.equal "Good progress")
    , Test.test
          "overallAssessment returns 'Excellent' if accuracy = 100% & wpm meets threshold"
          (\_ ->
              perfectAccuracyFastExercise |> Analysis.overallAssessment 80.0
                  |> String.left 9
                  |> Test.equal "Excellent")
    , Test.test
          "overallAssessment returns 'Your accuracy is pretty good' if accuracy = 100% & wpm is under threshold"
          (\_ ->
              perfectAccuracyFastExercise |> Analysis.overallAssessment 90.0
                  |> String.left 28
                  |> Test.equal "Your accuracy is pretty good")
    ]


--
-- HELPERS
--
betterAccuracyExercise : Exercise
betterAccuracyExercise =
    Exercise.init "" "1234567890" |> Exercise.consume '1' 0
        |> Exercise.consume '2' 0
        |> Exercise.consume '3' 0
        |> Exercise.consume '4' 0
        |> Exercise.consume '5' 0
        |> Exercise.consume '6' 0
        |> Exercise.consume '7' 0
        |> Exercise.consume '8' 0
        |> Exercise.consume '9' 0
        |> Exercise.consume '9' 0
        -- |> Exercise.accuracy => 90


inaccurateExercise : Exercise
inaccurateExercise =
    Exercise.init "" "1234567890" |> Exercise.consume '1' 0
        |> Exercise.consume '2' 0
        |> Exercise.consume '3' 0
        |> Exercise.consume '4' 0
        |> Exercise.consume '5' 0
        |> Exercise.consume '6' 0
        |> Exercise.consume '7' 0
        |> Exercise.consume '8' 0
        |> Exercise.consume '9' 0
        |> Exercise.consume '9' 0
        |> Exercise.consume '9' 0
        -- |> Exercise.accuracy => 81.81


perfectAccuracyFastExercise : Exercise
perfectAccuracyFastExercise =
    Exercise.init "" "1234567890" |> Exercise.consume '1' 0
        |> Exercise.consume '2' 300
        |> Exercise.consume '3' 150
        |> Exercise.consume '4' 150
        |> Exercise.consume '5' 150
        |> Exercise.consume '6' 150
        |> Exercise.consume '7' 150
        |> Exercise.consume '8' 150
        |> Exercise.consume '9' 150
        |> Exercise.consume '0' 150

        -- |> Exercise.wpm => 80
