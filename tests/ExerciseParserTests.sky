module ExerciseParserTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import ExerciseParser
import Step


tests : List Test
tests =
    [ Test.test
          "toSteps converts an empty string to just an End Step"
          (\_ -> "" |> ExerciseParser.toSteps |> Test.equal [ Step.initEnd ])
    , Test.test
          "toSteps converts a single line string of printables"
          (\_ ->
              "ab" |> ExerciseParser.toSteps
                  |> Test.equal [ Step.init 'a', Step.init 'b', Step.initEnd ])
    , Test.test
          "toSteps skips leading spaces in a single line string of printables"
          (\_ ->
              "  ab" |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.initSkip "  "
                         , Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnd
                         ])
    , Test.test
          "toSteps ignores trailing spaces and new lines"
          (\_ ->
              "ab  \n\n" |> ExerciseParser.toSteps
                  |> Test.equal [ Step.init 'a', Step.init 'b', Step.initEnd ])
    , Test.test
          "toSteps converts a multi-line string of printables"
          (\_ ->
              "ab\ncd" |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnterChar
                         , Step.init 'c'
                         , Step.init 'd'
                         , Step.initEnd
                         ])
    , Test.test
          "toSteps converts a multi-line string with a blank line in the middle"
          (\_ ->
              "ab\n\ncd" |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnterChar
                         , Step.initSkip enterString
                         , Step.init 'c'
                         , Step.init 'd'
                         , Step.initEnd
                         ])
    , Test.test
          "toSteps ignores trailing whitespace in a multi-line strings"
          (\_ ->
              "ab  \ncd" |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnterChar
                         , Step.init 'c'
                         , Step.init 'd'
                         , Step.initEnd
                         ])
    , Test.test
          "toSteps ignores empty lines containing whitespace in a multi-line strings"
          (\_ ->
              "ab\n  \ncd" |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnterChar
                         , Step.initSkip enterString
                         , Step.init 'c'
                         , Step.init 'd'
                         , Step.initEnd
                         ])
    , Test.test
          "toSteps ignores an empty line at the end of a multi-line string"
          (\_ ->
              "ab\ncd\n  " |> ExerciseParser.toSteps
                  |> Test.equal
                         [ Step.init 'a'
                         , Step.init 'b'
                         , Step.initEnterChar
                         , Step.init 'c'
                         , Step.init 'd'
                         , Step.initEnd
                         ])
    ]


--
-- HELPERS
--
enterString : String
enterString =
    "<enter>"
