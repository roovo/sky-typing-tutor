module EventTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Event exposing (Event)


tests : List Test
tests =
    howManyTypedTests ++ timeTakenTests


howManyTypedTests : List Test
howManyTypedTests =
    [ Test.test
          "howManyTyped is 0 if there are no Events"
          (\_ -> [] |> Event.howManyTyped |> Test.equal 0)
    , Test.test
          "howManyTyped is 2 if there is char and enter key in the list"
          (\_ ->
              [ Event 'a' 0, Event enterChar 0 ] |> Event.howManyTyped
                  |> Test.equal 2)
    , Test.test
          "howManyTyped ignores backspace characters"
          (\_ ->
              [ Event 'a' 0
              , Event enterChar 0
              , Event backspaceChar 0
              , Event 'b' 0
              ]
                  |> Event.howManyTyped
                  |> Test.equal 3)
    ]


timeTakenTests : List Test
timeTakenTests =
    [ Test.test
          "timeTaken is 0 if there are no Events"
          (\_ -> [] |> Event.timeTaken |> Test.equal 0)
    ]


--
-- HELPERS
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


enterChar : Char
enterChar =
    Char.fromCode 13
