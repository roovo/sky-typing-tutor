module EventTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Event exposing (Event)


tests : List Test
tests =
    howManyTypedTests ++ timeTakenTests


howManyTypedTests : List Test
howManyTypedTests =
    [ Test.test
          "howManyTyped is 0 if there are no Events"
          (\_ -> [] |> Event.howManyTyped |> Test.equal 0)
    , Test.test
          "howManyTyped is 2 if there is char and enter key in the list"
          (\_ ->
              [ Event 'a' 0, Event enterChar 0 ] |> Event.howManyTyped
                  |> Test.equal 2)
    , Test.test
          "howManyTyped ignores backspace characters"
          (\_ ->
              [ Event 'a' 0
              , Event enterChar 0
              , Event backspaceChar 0
              , Event 'b' 0
              ]
                  |> Event.howManyTyped
                  |> Test.equal 3)
    ]


timeTakenTests : List Test
timeTakenTests =
    [ Test.test
          "timeTaken is 0 if there are no Events"
          (\_ -> [] |> Event.timeTaken |> Test.equal 0)
    , Test.test
          "timeTaken returns the sum of the times for all consumed chars (including backspaces)"
          (\_ ->
              eventsWithCorrectedMistake |> Event.timeTaken |> Test.equal 12000)
    , Test.test
          "timeTaken ignores steps that take more than 3 seconds"
          (\_ -> eventsWithLongStep |> Event.timeTaken |> Test.equal 10000)
    ]


--
-- HELPERS
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


enterChar : Char
enterChar =
    Char.fromCode 13


eventsWithCorrectedMistake : List Event
eventsWithCorrectedMistake =
    [ Event 'a' 1000
    , Event 'b' 1000
    , Event 'c' 1000
    , Event ' ' 1000
    , Event 'd' 1000
    , Event 'd' 1000
    , Event backspaceChar 1000
    , Event 'e' 1000
    , Event 'f' 1000
    , Event ' ' 1000
    , Event 'g' 1000
    , Event 'h' 1000
    ]


eventsWithLongStep : List Event
eventsWithLongStep =
    [ Event 'a' 1000
    , Event 'b' 1000
    , Event 'c' 1000
    , Event ' ' 1000
    , Event 'd' 3000
    , Event 'e' 2000
    , Event 'f' 1000
    , Event ' ' 1000
    , Event 'g' 1000
    , Event 'h' 1000
    ]
