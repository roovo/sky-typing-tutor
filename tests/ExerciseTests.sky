module ExerciseTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Exercise exposing (Exercise, Printable(..), Style(..))


tests : List Test
tests =
    accuracyTests ++ consumeTests ++ currentLineIndexTests ++ isCompleteTests
        ++ languageTests
        ++ printableLineCountTests
        ++ printableLinesTests
        ++ typeableCharacterCountTests
        ++ wpmTests


accuracyTests : List Test
accuracyTests =
    [ Test.test
          "accuracy returns 0.0 for an empty exercise with nothing typed"
          (\_ -> exerciseWithText "" |> Exercise.accuracy |> Test.equal 0.0)
    , Test.test
          "accuracy returns 0.0 for a single character incorrectly typed in a single character exercise"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'x' 0
                  |> Exercise.accuracy
                  |> Test.equal 0.0)
    , Test.test
          "accuracy returns 100.0 for a single character correctly typed in a single character exercise"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'a' 0
                  |> Exercise.accuracy
                  |> Test.equal 100.0)
    , Test.test
          "accuracy returns 50.0 for a single character with a a corrected single bad character typed"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'b' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'a' 0
                  |> Exercise.accuracy
                  |> Test.equal 50.0)
    , Test.test
          "accuracy returns 100.0 for a multiple correctly typed characters"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.accuracy
                  |> Test.equal 100.0)
    , Test.test
          "accuracy counts the enter key as a character"
          (\_ ->
              exerciseWithText "a\nbc" |> Exercise.consume 'a' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.accuracy
                  |> Test.equal 75.0)
    , Test.test
          "accuracy doesn't count 'correctly typed' characters when in error state"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.accuracy
                  |> Test.equal 50.0)
    ]


consumeTests : List Test
consumeTests =
    [ Test.test
          "consume consumes the first character of the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Current
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume consumes the first 2 characters of the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , Styled "c" Current
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume consumes onto the 2nd line of a multiline string"
          (\_ ->
              exerciseWithText "ab\nc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume enterChar 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "c" Current, UnstyledEnd ]
                         ])
    , Test.test
          "consume styles with an Errored if the wrong character is typed"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'c' 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Errored
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume styles with multiple Errors if the wrong characters are typed"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume 'd' 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Errored
                           , Styled "c" Errored
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume handles leading whitespace"
          (\_ ->
              exerciseWithText "  ab\n  cd" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume enterChar 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "  " Unstyled
                           , Styled "a" Completed
                           , Styled "b" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Current
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume does nothing if backspace typed as first character"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume backspaceChar 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume goes back if backspace typed part way through the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume backspaceChar 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Current
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume allows errors to be corrected using backspace"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'b' 0
                  |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , Styled "c" Current
                           , UnstyledEnd
                           ]
                         ])
    ]


currentLineIndexTests : List Test
currentLineIndexTests =
    [ Test.test
          "currentLineIndex is zero if there is no text"
          (\_ -> exerciseWithText "" |> Exercise.currentLineIndex |> Test.equal 0)
    , Test.test
          "currentLineIndex is zero when at the start of a single line string containing just printables"
          (\_ ->
              exerciseWithText "a b" |> Exercise.currentLineIndex
                  |> Test.equal 0)
    , Test.test
          "currentLineIndex is zero when at the start of a multi line string containing just printables"
          (\_ ->
              exerciseWithText "a\nb\nc" |> Exercise.currentLineIndex
                  |> Test.equal 0)
    , Test.test
          "currentLineIndex is 1 when on the 2nd line of a multi line string containing just printables"
          (\_ ->
              exerciseWithText "a\nb\nc" |> Exercise.consume 'a' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.currentLineIndex
                  |> Test.equal 1)
    , Test.test
          "currentLineIndex is 5 when on the 6th line of a multi line string containing some empty lines"
          (\_ ->
              exerciseWithText "   \n \n\na\n  \nb\n\nc\nd"
                  |> Exercise.consume 'a' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.currentLineIndex
                  |> Test.equal 5)
    ]


isCompleteTests : List Test
isCompleteTests =
    [ Test.test
          "isComplete returns True for an exercise with no content"
          (\_ -> exerciseWithText "" |> Exercise.isComplete |> Test.equal True)
    , Test.test
          "isComplete returns False for an exercise with content that hasn't started yet"
          (\_ -> exerciseWithText "ab" |> Exercise.isComplete |> Test.equal False)
    , Test.test
          "isComplete returns False for an exercise which has been not been completed"
          (\_ ->
              exerciseWithText "ab" |> Exercise.consume 'a' 0
                  |> Exercise.isComplete
                  |> Test.equal False)
    , Test.test
          "isComplete returns False for an exercise with mistakes which has been not been completed"
          (\_ ->
              exerciseWithText "ab" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'a' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.isComplete
                  |> Test.equal False)
    , Test.test
          "isComplete returns True for an exercise which has been perfectly completed"
          (\_ ->
              exerciseWithText "ab" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.isComplete
                  |> Test.equal True)
    , Test.test
          "isComplete returns True for an exercise which has been completed with some mistakes"
          (\_ ->
              exerciseWithText "ab" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'a' 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.isComplete
                  |> Test.equal True)
    , Test.test
          "isComplete returns True for an exercise which has been completed with characters typed after completion"
          (\_ ->
              exerciseWithText "ab" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume backspaceChar 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.isComplete
                  |> Test.equal True)
    ]


languageTests : List Test
languageTests =
    [ Test.test
          "language returns 'CSS' for the extension '.css'"
          (\_ ->
              Exercise.init "filename.css" "" |> Exercise.language
                  |> Test.equal "CSS")
    , Test.test
          "language returns 'Dockerfile' for the extension '.dockerfile'"
          (\_ ->
              Exercise.init "filename.dockerfile" "" |> Exercise.language
                  |> Test.equal "Dockerfile")
    , Test.test
          "language returns 'Elm' for the extension '.elm'"
          (\_ ->
              Exercise.init "filename.elm" "" |> Exercise.language
                  |> Test.equal "Elm")
    , Test.test
          "language returns 'Elixir' for the extension '.ex'"
          (\_ ->
              Exercise.init "filename.ex" "" |> Exercise.language
                  |> Test.equal "Elixir")
    , Test.test
          "language returns 'Elixir' for the extension '.exs'"
          (\_ ->
              Exercise.init "filename.exs" "" |> Exercise.language
                  |> Test.equal "Elixir")
    , Test.test
          "language returns 'Go' for the extension '.go'"
          (\_ ->
              Exercise.init "filename.go" "" |> Exercise.language
                  |> Test.equal "Go")
    , Test.test
          "language returns 'Java' for the extension '.java'"
          (\_ ->
              Exercise.init "filename.java" "" |> Exercise.language
                  |> Test.equal "Java")
    , Test.test
          "language returns 'JavaScript' for the extension '.js'"
          (\_ ->
              Exercise.init "filename.js" "" |> Exercise.language
                  |> Test.equal "JavaScript")
    , Test.test
          "language returns 'JSON' for the extension '.json'"
          (\_ ->
              Exercise.init "filename.json" "" |> Exercise.language
                  |> Test.equal "JSON")
    , Test.test
          "language returns 'Lua' for the extension '.lua'"
          (\_ ->
              Exercise.init "filename.lua" "" |> Exercise.language
                  |> Test.equal "Lua")
    , Test.test
          "language returns 'Markdown' for the extension '.md'"
          (\_ ->
              Exercise.init "filename.md" "" |> Exercise.language
                  |> Test.equal "Markdown")
    , Test.test
          "language returns 'Python' for the extension '.py'"
          (\_ ->
              Exercise.init "filename.py" "" |> Exercise.language
                  |> Test.equal "Python")
    , Test.test
          "language returns 'Ruby' for the extension '.rb'"
          (\_ ->
              Exercise.init "filename.rb" "" |> Exercise.language
                  |> Test.equal "Ruby")
    , Test.test
          "language returns 'Shell' for the extension '.bash'"
          (\_ ->
              Exercise.init "filename.bash" "" |> Exercise.language
                  |> Test.equal "Shell")
    , Test.test
          "language returns 'Shell' for the extension '.sh'"
          (\_ ->
              Exercise.init "filename.sh" "" |> Exercise.language
                  |> Test.equal "Shell")
    , Test.test
          "language returns 'Sky' for the extension '.sky'"
          (\_ ->
              Exercise.init "filename.sky" "" |> Exercise.language
                  |> Test.equal "Sky")
    , Test.test
          "language returns 'SQL' for the extension '.sql'"
          (\_ ->
              Exercise.init "filename.sql" "" |> Exercise.language
                  |> Test.equal "SQL")
    , Test.test
          "language returns 'Text' for the extension '.txt'"
          (\_ ->
              Exercise.init "filename.txt" "" |> Exercise.language
                  |> Test.equal "Text")
    , Test.test
          "language returns 'TypeScript' for the extension '.ts'"
          (\_ ->
              Exercise.init "filename.ts" "" |> Exercise.language
                  |> Test.equal "TypeScript")
    , Test.test
          "language returns 'YAML' for the extension '.yml'"
          (\_ ->
              Exercise.init "filename.yml" "" |> Exercise.language
                  |> Test.equal "YAML")
    , Test.test
          "language returns 'YAML' for the extension '.yaml'"
          (\_ ->
              Exercise.init "filename.yaml" "" |> Exercise.language
                  |> Test.equal "YAML")
    , Test.test
          "language returns 'unknown' for the extension .not_a_real_language"
          (\_ ->
              Exercise.init "filename.not_a_real_language" ""
                  |> Exercise.language
                  |> Test.equal "unknown")
    , Test.test
          "language returns 'unknown' if there is no extension"
          (\_ ->
              Exercise.init "filename" "" |> Exercise.language
                  |> Test.equal "unknown")
    ]


printableLineCountTests : List Test
printableLineCountTests =
    [ Test.test
          "printableLineCount returns 0 if there is no text"
          (\_ ->
              exerciseWithText "" |> Exercise.printableLineCount |> Test.equal 0)
    ]


printableLinesTests : List Test
printableLinesTests =
    [ Test.test
          "printableLines returns an UnstyledEnd if there is no text"
          (\_ ->
              exerciseWithText "" |> allPrintableLines
                  |> Test.equal [ [ UnstyledEnd ] ])
    , Test.test
          "printableLines handles a single line string containing just printables"
          (\_ ->
              exerciseWithText "a b" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled " " Waiting
                           , Styled "b" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string containing just printables"
          (\_ ->
              exerciseWithText "ab\ncd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with line trailing whitspace"
          (\_ ->
              exerciseWithText "ab   \ncd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines at start"
          (\_ ->
              exerciseWithText "   \n  \n\nab\ncd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines in middle"
          (\_ ->
              exerciseWithText "ab   \n  \n\ncd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ UnstyledEmptyLine ]
                         , [ UnstyledEmptyLine ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines at end"
          (\_ ->
              exerciseWithText "ab\ncd  \n   \n\n" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with leading whitespace on 2nd line"
          (\_ ->
              exerciseWithText "ab\n  cd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with leading whitespace on 1st line"
          (\_ ->
              exerciseWithText "  ab\n  cd" |> allPrintableLines
                  |> Test.equal
                         [ [ Styled "  " Unstyled
                           , Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles windowing when at start of a line"
          (\_ ->
              exerciseWithText "ab\ncd\nef\ngh\nij" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume 'd' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.printableLines 1 1
                  |> Test.equal
                         [ [ Styled "c" Completed
                           , Styled "d" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "e" Current
                           , Styled "f" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "g" Waiting
                           , Styled "h" Waiting
                           , StyledEnter Waiting
                           ]
                         ])
    , Test.test
          "printableLines handles windowing when at end of a line"
          (\_ ->
              exerciseWithText "ab\ncd\nef\ngh\nij" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'c' 0
                  |> Exercise.consume 'd' 0
                  |> Exercise.consume enterChar 0
                  |> Exercise.consume 'e' 0
                  |> Exercise.consume 'f' 0
                  |> Exercise.printableLines 1 1
                  |> Test.equal
                         [ [ Styled "c" Completed
                           , Styled "d" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "e" Completed
                           , Styled "f" Completed
                           , StyledEnter Current
                           ]
                         , [ Styled "g" Waiting
                           , Styled "h" Waiting
                           , StyledEnter Waiting
                           ]
                         ])
    ]


typeableCharacterCountTests : List Test
typeableCharacterCountTests =
    [ Test.test
          "typeableCharacterCount returns 0 for an empty exercise"
          (\_ ->
              exerciseWithText "" |> Exercise.typeableCharacterCount
                  |> Test.equal 0)
    , Test.test
          "typeableCharacterCount returns the number of characters in a simple sigle line exercise"
          (\_ ->
              exerciseWithText "ab" |> Exercise.typeableCharacterCount
                  |> Test.equal 2)
    , Test.test
          "typeableCharacterCount ignores leading whitespace"
          (\_ ->
              exerciseWithText "    ab" |> Exercise.typeableCharacterCount
                  |> Test.equal 2)
    , Test.test
          "typeableCharacterCount includes enter char"
          (\_ ->
              exerciseWithText "    a\nb" |> Exercise.typeableCharacterCount
                  |> Test.equal 3)
    , Test.test
          "typeableCharacterCount excludes empty lines"
          (\_ ->
              exerciseWithText "    a\n  \n\nb\n   \n"
                  |> Exercise.typeableCharacterCount
                  |> Test.equal 3)
    ]


wpmTests : List Test
wpmTests =
    [ Test.test
          "wpm returns 0.0 for an empty exercise with nothing typed"
          (\_ -> exerciseWithText "" |> Exercise.wpm |> Test.equal 0.0)
    , Test.test
          "wpm returns 60.0 for a 5 letter exercise with everything typed in 1 sec"
          (\_ ->
              exerciseWithText "abcde" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'b' 400
                  |> Exercise.consume 'c' 200
                  |> Exercise.consume 'd' 200
                  |> Exercise.consume 'e' 200
                  |> Exercise.wpm
                  |> Test.equal 60.0)
    , Test.test
          "wpm only includes characters of progress (so ignores backspaces and erroneious keys)"
          (\_ ->
              exerciseWithText "abcde" |> Exercise.consume 'a' 0
                  |> Exercise.consume 'a' 400
                  |> Exercise.consume backspaceChar 200
                  |> Exercise.consume 'b' 100
                  |> Exercise.consume 'c' 100
                  |> Exercise.consume 'd' 100
                  |> Exercise.consume 'e' 100
                  |> Exercise.wpm
                  |> Test.equal 60.0)
    ]


--
-- HELPERS
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


enterChar : Char
enterChar =
    Char.fromCode 13


exerciseWithText : String -> Exercise
exerciseWithText text =
    Exercise.init "" text


allPrintableLines : Exercise -> List (List Printable)
allPrintableLines exercise =
    Exercise.printableLines 999 999 exercise
