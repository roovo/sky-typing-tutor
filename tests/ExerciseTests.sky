module ExerciseTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Exercise exposing (Printable(..), Style(..))


tests : List Test
tests =
    printablesTests


printablesTests : List Test
printablesTests =
    [ Test.test
          "printables returns an UnstyledEnd if there is no text"
          (\_ ->
              exerciseWithText "" |> Exercise.printables
                  |> Test.equal [ UnstyledEnd ])
    ]


--
-- HELPERS
--
exerciseWithText : String -> Exercise
exerciseWithText text =
    Exercise.init "" text
