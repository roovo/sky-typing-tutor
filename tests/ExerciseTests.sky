module ExerciseTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Exercise exposing (Exercise, Printable(..), Style(..))


tests : List Test
tests =
    accuracyTests ++ consumeTests ++ currentLineIndexTests
        ++ printableLinesTests


accuracyTests : List Test
accuracyTests =
    [ Test.test
          "accuracy returns 0.0 for an empty exercise with nothing typed"
          (\_ -> exerciseWithText "" |> Exercise.accuracy |> Test.equal 0.0)
    , Test.test
          "accuracy returns 0.0 for a single character incorrectly typed in a single character exercise"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'x' |> Exercise.accuracy
                  |> Test.equal 0.0)
    , Test.test
          "accuracy returns 100.0 for a single character correctly typed in a single character exercise"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'a' |> Exercise.accuracy
                  |> Test.equal 100.0)
    , Test.test
          "accuracy returns 50.0 for a single character with a a corrected single bad character typed"
          (\_ ->
              exerciseWithText "a" |> Exercise.consume 'b'
                  |> Exercise.consume backspaceChar
                  |> Exercise.consume 'a'
                  |> Exercise.accuracy
                  |> Test.equal 50.0)
    , Test.test
          "accuracy returns 100.0 for a multiple correctly typed characters"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.consume 'c'
                  |> Exercise.accuracy
                  |> Test.equal 100.0)
    , Test.test
          "accuracy counts the enter key as a character"
          (\_ ->
              exerciseWithText "a\nbc" |> Exercise.consume 'a'
                  |> Exercise.consume enterChar
                  |> Exercise.consume 'b'
                  |> Exercise.consume 'b'
                  |> Exercise.accuracy
                  |> Test.equal 75.0)
    , Test.test
          "accuracy doesn't count 'correctly typed' characters when in error state"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.consume backspaceChar
                  |> Exercise.consume backspaceChar
                  |> Exercise.consume 'b'
                  |> Exercise.accuracy
                  |> Test.equal 50.0)
    ]


consumeTests : List Test
consumeTests =
    [ Test.test
          "consume consumes the first character of the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Current
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume consumes the first 2 characters of the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , Styled "c" Current
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume consumes onto the 2nd line of a multiline string"
          (\_ ->
              exerciseWithText "ab\nc" |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.consume enterChar
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "c" Current, UnstyledEnd ]
                         ])
    , Test.test
          "consume styles with an Error if the wrong character is typed"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'c'
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Error
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume styles with multiple Errors if the wrong characters are typed"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'c'
                  |> Exercise.consume 'd'
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Error
                           , Styled "c" Error
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume handles leading whitespace"
          (\_ ->
              exerciseWithText "  ab\n  cd" |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.consume enterChar
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "  " Unstyled
                           , Styled "a" Completed
                           , Styled "b" Completed
                           , StyledEnter Completed
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Current
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume does nothing if backspace typed as first character"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume backspaceChar
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume goes back if backspace typed part way through the exercise"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'b'
                  |> Exercise.consume backspaceChar
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Current
                           , Styled "c" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "consume allows errors to be corrected using backspace"
          (\_ ->
              exerciseWithText "abc" |> Exercise.consume 'a'
                  |> Exercise.consume 'c'
                  |> Exercise.consume backspaceChar
                  |> Exercise.consume 'b'
                  |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Completed
                           , Styled "b" Completed
                           , Styled "c" Current
                           , UnstyledEnd
                           ]
                         ])
    ]


currentLineIndexTests : List Test
currentLineIndexTests =
    [ Test.test
          "currentLineIndex is zero if there is no text"
          (\_ -> exerciseWithText "" |> Exercise.currentLineIndex |> Test.equal 0)
    , Test.test
          "currentLineIndex is zero when at the start of a single line string containing just printables"
          (\_ ->
              exerciseWithText "a b" |> Exercise.currentLineIndex
                  |> Test.equal 0)
    , Test.test
          "currentLineIndex is zero when at the start of a multi line string containing just printables"
          (\_ ->
              exerciseWithText "a\nb\nc" |> Exercise.currentLineIndex
                  |> Test.equal 0)
    , Test.test
          "currentLineIndex is 1 when on the 2nd line of a multi line string containing just printables"
          (\_ ->
              exerciseWithText "a\nb\nc" |> Exercise.consume 'a'
                  |> Exercise.consume enterChar
                  |> Exercise.currentLineIndex
                  |> Test.equal 1)
    , Test.test
          "currentLineIndex is 5 when on the 6th line of a multi line string containing some empty lines"
          (\_ ->
              exerciseWithText "   \n \n\na\n  \nb\n\nc\nd"
                  |> Exercise.consume 'a'
                  |> Exercise.consume enterChar
                  |> Exercise.consume 'b'
                  |> Exercise.consume enterChar
                  |> Exercise.consume 'c'
                  |> Exercise.consume enterChar
                  |> Exercise.currentLineIndex
                  |> Test.equal 5)
    ]


printableLinesTests : List Test
printableLinesTests =
    [ Test.test
          "printableLines returns an UnstyledEnd if there is no text"
          (\_ ->
              exerciseWithText "" |> Exercise.printableLines
                  |> Test.equal [ [ UnstyledEnd ] ])
    , Test.test
          "printableLines handles a single line string containing just printables"
          (\_ ->
              exerciseWithText "a b" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled " " Waiting
                           , Styled "b" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string containing just printables"
          (\_ ->
              exerciseWithText "ab\ncd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with line trailing whitspace"
          (\_ ->
              exerciseWithText "ab   \ncd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines at start"
          (\_ ->
              exerciseWithText "   \n  \n\nab\ncd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines in middle"
          (\_ ->
              exerciseWithText "ab   \n  \n\ncd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ UnstyledEmptyLine ]
                         , [ UnstyledEmptyLine ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with blank lines at end"
          (\_ ->
              exerciseWithText "ab\ncd  \n   \n\n" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with leading whitespace on 2nd line"
          (\_ ->
              exerciseWithText "ab\n  cd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    , Test.test
          "printableLines handles a multi line string with leading whitespace on 1st line"
          (\_ ->
              exerciseWithText "  ab\n  cd" |> Exercise.printableLines
                  |> Test.equal
                         [ [ Styled "  " Unstyled
                           , Styled "a" Current
                           , Styled "b" Waiting
                           , StyledEnter Waiting
                           ]
                         , [ Styled "  " Unstyled
                           , Styled "c" Waiting
                           , Styled "d" Waiting
                           , UnstyledEnd
                           ]
                         ])
    ]


--
-- HELPERS
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


enterChar : Char
enterChar =
    Char.fromCode 13


exerciseWithText : String -> Exercise
exerciseWithText text =
    Exercise.init "" text
