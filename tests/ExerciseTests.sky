module ExerciseTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Test as Test exposing (Test)
import Exercise exposing (Style(..))


tests : List Test
tests =
    printablesTests


printablesTests : List Test
printablesTests =
    [ Test.test
          "printables returns an empty array if there is no text"
          (\_ ->
              exerciseWithText "" |> Exercise.printables
                  |> Test.equal [ { content = "", style = Current } ])
    , Test.test
          "printables has current at the start if nothing has been typed"
          (\_ ->
              exerciseWithText "ab" |> Exercise.printables
                  |> Test.equal
                         [ { content = "a", style = Current }
                         , { content = "b", style = Waiting }
                         , { content = "", style = Waiting }
                         ])
    ]


--
-- HELPERS
--
exerciseWithText : String -> Exercise
exerciseWithText text =
    Exercise.init "" text
