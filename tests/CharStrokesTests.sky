module CharStrokesTests exposing (tests)

import CharStrokes exposing (CharStrokes)
import Event exposing (Event)
import Sky.Test as Test exposing (Test)


tests : List Test
tests =
    errorRateTests ++ fromExerciseDataTests ++ groupByCharTests


errorRateTests : List Test
errorRateTests =
    [ Test.test
          "errorRate returns 0.0 if there are no CharStrokes"
          (\_ -> [] |> CharStrokes.errorRate |> Test.equal 0.0)
    , Test.test
          "errorRate returns 0.0 if there is a single perfectly typed character"
          (\_ ->
              [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ] ]
                  |> CharStrokes.errorRate
                  |> Test.equal 0.0)
    , Test.test
          "errorRate returns 0.0 if there multiple perfectly typed characters"
          (\_ ->
              [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              ]
                  |> CharStrokes.errorRate
                  |> Test.equal 0.0)
    , Test.test
          "errorRate returns 1.0 if all the characters were mistyped"
          (\_ ->
              [ CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              , CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              , CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              , CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              ]
                  |> CharStrokes.errorRate
                  |> Test.equal 1.0)
    , Test.test
          "errorRate returns 0.5 if half the characters were mistyped"
          (\_ ->
              [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              , CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes
                    'a'
                    [ { char = 'a', timeTaken = 11 }
                    , { char = 'a', timeTaken = 11 }
                    ]
              ]
                  |> CharStrokes.errorRate
                  |> Test.equal 0.5)
    ]


fromExerciseDataTests : List Test
fromExerciseDataTests =
    [ Test.test
          "fromEventList returns [] if there are no Events"
          (\_ -> [] |> CharStrokes.fromEventList |> Test.equal [])
    , Test.test
          "fromEventList returns a single CharStroke if there is a single event"
          (\_ ->
              [ Event 'a' 123 ] |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 123 } ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes if there is a list of events with no backspaces"
          (\_ ->
              [ Event 'a' 123, Event ' ' 99, Event enterChar 33 ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 123 } ]
                           }
                         , { target = ' '
                           , events = [ { char = ' ', timeTaken = 99 } ]
                           }
                         , { target = enterChar
                           , events = [ { char = enterChar, timeTaken = 33 } ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes if there is a backspace on the end"
          (\_ ->
              [ Event 'a' 123, Event ' ' 99, Event backspaceChar 33 ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 123 } ]
                           }
                         , { target = backspaceChar
                           , events =
                               [ { char = backspaceChar, timeTaken = 33 }
                               , { char = ' ', timeTaken = 99 }
                               ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes if there is a single successful correction"
          (\_ ->
              [ Event 'a' 123
              , Event ' ' 99
              , Event backspaceChar 33
              , Event 'b' 44
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 123 } ]
                           }
                         , { target = 'b'
                           , events =
                               [ { char = 'b', timeTaken = 44 }
                               , { char = backspaceChar, timeTaken = 33 }
                               , { char = ' ', timeTaken = 99 }
                               ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes if there is a successful 2-character correction"
          (\_ ->
              [ Event 'a' 11
              , Event 'c' 22
              , Event 'd' 33
              , Event backspaceChar 44
              , Event backspaceChar 55
              , Event 'b' 66
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 11 } ]
                           }
                         , { target = 'b'
                           , events =
                               [ { char = 'b', timeTaken = 66 }
                               , { char = backspaceChar, timeTaken = 55 }
                               , { char = backspaceChar, timeTaken = 44 }
                               , { char = 'd', timeTaken = 33 }
                               , { char = 'c', timeTaken = 22 }
                               ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes for multiple corrections to a single character"
          (\_ ->
              [ Event 'a' 11
              , Event 'c' 22
              , Event 'd' 33
              , Event backspaceChar 44
              , Event 'b' 55
              , Event backspaceChar 66
              , Event backspaceChar 77
              , Event 'b' 88
              , Event 'c' 99
              , Event 'd' 100
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events = [ { char = 'a', timeTaken = 11 } ]
                           }
                         , { target = 'b'
                           , events =
                               [ { char = 'b', timeTaken = 88 }
                               , { char = backspaceChar, timeTaken = 77 }
                               , { char = backspaceChar, timeTaken = 66 }
                               , { char = 'b', timeTaken = 55 }
                               , { char = backspaceChar, timeTaken = 44 }
                               , { char = 'd', timeTaken = 33 }
                               , { char = 'c', timeTaken = 22 }
                               ]
                           }
                         , { target = 'c'
                           , events = [ { char = 'c', timeTaken = 99 } ]
                           }
                         , { target = 'd'
                           , events = [ { char = 'd', timeTaken = 100 } ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes when backspacing past the mistake"
          (\_ ->
              [ Event 'a' 11
              , Event 'c' 22
              , Event backspaceChar 33
              , Event backspaceChar 44
              , Event 'a' 55
              , Event 'b' 66
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events =
                               [ { char = 'a', timeTaken = 55 }
                               , { char = backspaceChar, timeTaken = 44 }
                               , { char = backspaceChar, timeTaken = 33 }
                               , { char = 'c', timeTaken = 22 }
                               , { char = 'a', timeTaken = 11 }
                               ]
                           }
                         , { target = 'b'
                           , events = [ { char = 'b', timeTaken = 66 } ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes when the first characters typed are backspaces"
          (\_ ->
              [ Event backspaceChar 11
              , Event backspaceChar 22
              , Event backspaceChar 33
              , Event 'a' 44
              , Event 'b' 55
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events =
                               [ { char = 'a', timeTaken = 44 }
                               , { char = backspaceChar, timeTaken = 33 }
                               , { char = backspaceChar, timeTaken = 22 }
                               , { char = backspaceChar, timeTaken = 11 }
                               ]
                           }
                         , { target = 'b'
                           , events = [ { char = 'b', timeTaken = 55 } ]
                           }
                         ])
    , Test.test
          "fromEventList returns a list of CharStrokes when the backspaing past the start"
          (\_ ->
              [ Event 'a' 11
              , Event backspaceChar 22
              , Event backspaceChar 33
              , Event backspaceChar 44
              , Event 'a' 55
              , Event 'b' 66
              ]
                  |> CharStrokes.fromEventList
                  |> Test.equal
                         [ { target = 'a'
                           , events =
                               [ { char = 'a', timeTaken = 55 }
                               , { char = backspaceChar, timeTaken = 44 }
                               , { char = backspaceChar, timeTaken = 33 }
                               , { char = backspaceChar, timeTaken = 22 }
                               , { char = 'a', timeTaken = 11 }
                               ]
                           }
                         , { target = 'b'
                           , events = [ { char = 'b', timeTaken = 66 } ]
                           }
                         ])
    ]


groupByCharTests : List Test
groupByCharTests =
    [ Test.test
          "groupByChar returns [] if there are no CharStrokes"
          (\_ -> [] |> CharStrokes.groupByChar |> Test.equal [])
    , Test.test
          "groupByChar returns the CharStrokes if the input is a singleton"
          (\_ ->
              [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ] ]
                  |> CharStrokes.groupByChar
                  |> Test.equal
                         [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ] ])
    , Test.test
          "groupByChar returns the CharStrokes if the input contains only Charstrokes for different characters"
          (\_ ->
              [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'b' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'c' [ { char = 'a', timeTaken = 11 } ]
              , CharStrokes 'd' [ { char = 'a', timeTaken = 11 } ]
              ]
                  |> CharStrokes.groupByChar
                  |> Test.equal
                         [ CharStrokes 'a' [ { char = 'a', timeTaken = 11 } ]
                         , CharStrokes 'b' [ { char = 'a', timeTaken = 11 } ]
                         , CharStrokes 'c' [ { char = 'a', timeTaken = 11 } ]
                         , CharStrokes 'd' [ { char = 'a', timeTaken = 11 } ]
                         ])
    ]


--
-- HELPERS
--
backspaceChar : Char
backspaceChar =
    Char.fromCode 8


enterChar : Char
enterChar =
    Char.fromCode 13
