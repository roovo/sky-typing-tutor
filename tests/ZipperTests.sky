module ZipperTests exposing (tests)

import Sky.Core.Prelude exposing (..)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Test as Test exposing (Test)
import Zipper exposing (Zipper)


tests : List Test
tests =
    afterTests ++ beforeTests ++ combinationTests ++ currentTests ++ firstTests
        ++ fromListTests
        ++ lastTests
        ++ nextTests
        ++ previousTests
        ++ singletonTests
        ++ toListTests


afterTests : List Test
afterTests =
    [ Test.test
          "after after two nexts"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.after
                  |> Test.equal [ 4 ])
    ]


beforeTests : List Test
beforeTests =
    [ Test.test
          "before after two nexts"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.before
                  |> Test.equal [ 1, 2 ])
    ]


combinationTests : List Test
combinationTests =
    [ Test.test
          "combination: next then previous returns to previous"
          (\_ ->
              makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.next
                  |> Zipper.previous
                  |> Zipper.current
                  |> Test.equal 2)
    , Test.test
          "combination: traversing to end and back preserves list"
          (\_ ->
              makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.next
                  |> Zipper.previous
                  |> Zipper.previous
                  |> Zipper.toList
                  |> Test.equal [ 1, 2, 3 ])
    ]


currentTests : List Test
currentTests =
    [ Test.test
          "current after two nexts"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.current
                  |> Test.equal 3)
    ]


firstTests : List Test
firstTests =
    [ Test.test
          "first from middle focuses on first element"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.first
                  |> Zipper.current
                  |> Test.equal 1)
    , Test.test
          "first from middle has empty before"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.first
                  |> Zipper.before
                  |> Test.equal [])
    , Test.test
          "first from middle has all others after"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.first
                  |> Zipper.after
                  |> Test.equal [ 2, 3, 4 ])
    , Test.test
          "first when already at first is no-op"
          (\_ ->
              makeZipper [ 1, 2, 3 ] |> Zipper.first |> Zipper.current
                  |> Test.equal 1)
    , Test.test
          "first on singleton stays put"
          (\_ ->
              Zipper.singleton 1 |> Zipper.first |> Zipper.current
                  |> Test.equal 1)
    ]


fromListTests : List Test
fromListTests =
    [ Test.test
          "fromList with empty list returns Nothing"
          (\_ ->
              case Zipper.fromList [] of

                  Nothing ->
                      Test.pass

                  Just _ ->
                      Test.fail "expected Nothing")
    , Test.test
          "fromList focuses on first element"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ]
              in
                  Test.equal 1 (Zipper.current z))
    , Test.test
          "fromList has empty before"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ]
              in
                  Test.equal [] (Zipper.before z))
    , Test.test
          "fromList has remaining elements after"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ]
              in
                  Test.equal [ 2, 3 ] (Zipper.after z))
    ]


lastTests : List Test
lastTests =
    [ Test.test
          "last from middle focuses on last element"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.last
                  |> Zipper.current
                  |> Test.equal 4)
    , Test.test
          "last from middle has empty after"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.last
                  |> Zipper.after
                  |> Test.equal [])
    , Test.test
          "last from middle has all others before"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.next |> Zipper.next
                  |> Zipper.last
                  |> Zipper.before
                  |> Test.equal [ 1, 2, 3 ])
    , Test.test
          "last when already at last is no-op"
          (\_ ->
              makeZipper [ 1, 2, 3 ] |> Zipper.last |> Zipper.last
                  |> Zipper.current
                  |> Test.equal 3)
    , Test.test
          "last on singleton stays put"
          (\_ ->
              Zipper.singleton 1 |> Zipper.last |> Zipper.current
                  |> Test.equal 1)
    ]


nextTests : List Test
nextTests =
    [ Test.test
          "next moves to second element"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ] |> Zipper.next
              in
                  Test.equal 2 (Zipper.current z))
    , Test.test
          "next updates before"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ] |> Zipper.next
              in
                  Test.equal [ 1 ] (Zipper.before z))
    , Test.test
          "next updates after"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ] |> Zipper.next
              in
                  Test.equal [ 3 ] (Zipper.after z))
    , Test.test
          "next at end stays put"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.next
                          |> Zipper.next
              in
                  Test.equal 3 (Zipper.current z))
    , Test.test
          "next past end still stays at end"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.next
                          |> Zipper.next
                          |> Zipper.next
              in
                  Test.equal 3 (Zipper.current z))
    , Test.test
          "next at end preserves list"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.next
                          |> Zipper.next
              in
                  Test.equal [ 1, 2, 3 ] (Zipper.toList z))
    , Test.test
          "next on singleton stays put"
          (\_ -> Test.equal 1 (Zipper.current (Zipper.next (Zipper.singleton 1))))
    ]


previousTests : List Test
previousTests =
    [ Test.test
          "previous moves back"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.previous
              in
                  Test.equal 1 (Zipper.current z))
    , Test.test
          "previous at start stays put"
          (\_ ->
              let
                  z = makeZipper [ 1, 2, 3 ] |> Zipper.previous
              in
                  Test.equal 1 (Zipper.current z))
    , Test.test
          "previous at start preserves list"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.previous
                          |> Zipper.previous
              in
                  Test.equal [ 1, 2, 3 ] (Zipper.toList z))
    , Test.test
          "multiple previous from middle sticks to start"
          (\_ ->
              let
                  z =
                      makeZipper [ 1, 2, 3 ] |> Zipper.next |> Zipper.previous
                          |> Zipper.previous
                          |> Zipper.previous
              in
                  Test.equal 1 (Zipper.current z))
    , Test.test
          "previous on singleton stays put"
          (\_ ->
              Test.equal
                  1
                  (Zipper.current (Zipper.previous (Zipper.singleton 1))))
    ]


singletonTests : List Test
singletonTests =
    [ Test.test
          "singleton creates a zipper with one element"
          (\_ -> Test.equal 1 (Zipper.current (Zipper.singleton 1)))
    , Test.test
          "singleton has empty before"
          (\_ -> Test.equal [] (Zipper.before (Zipper.singleton 1)))
    , Test.test
          "singleton has empty after"
          (\_ -> Test.equal [] (Zipper.after (Zipper.singleton 1)))
    ]


toListTests : List Test
toListTests =
    [ Test.test
          "toList returns a singletom list for a singleton zipper"
          (\_ -> Zipper.singleton 1 |> Zipper.toList |> Test.equal [ 1 ])
    , Test.test
          "toList returns the correct list for a non-singleton zipper"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.toList
                  |> Test.equal [ 1, 2, 3, 4 ])
    , Test.test
          "toList returns the correct list even if it has had current moved around"
          (\_ ->
              makeZipper [ 1, 2, 3, 4 ] |> Zipper.previous |> Zipper.next
                  |> Zipper.next
                  |> Zipper.previous
                  |> Zipper.toList
                  |> Test.equal [ 1, 2, 3, 4 ])
    ]


--
-- HELPERS
--
makeZipper list =
    case Zipper.fromList list of

        Just z ->
            z

        Nothing ->
            Zipper.singleton 0
